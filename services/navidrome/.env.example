PORT=4533
# The final music library (mounted read-only at /music; Navidrome stores track paths under it)
MUSIC_DIR={{ music_dir | default(/mnt/media/music/library) }}
# The default library inside /music; more libraries: Settings → Libraries
MUSIC_FOLDER={{ music_folder | default(/music) }}
# User the container runs as; ./data must belong to it
PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
TZ={{ tz | default(Etc/UTC) }}
