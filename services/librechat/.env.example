# ── Server ────────────────────────────────────────────────────────────────────
PORT=3080

# Set to your public URL when behind a reverse proxy
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Match the user owning the data directories
UID=1000
GID=1000

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET={{ jwt_secret | generate(hex64) }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret | generate(hex64) }}

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_PASSWORD_RESET=false

# ── Admin panel ───────────────────────────────────────────────────────────────
ADMIN_PANEL_PORT=3003
ADMIN_PANEL_SESSION_SECRET={{ admin_panel_session_secret | generate(hex64) }}
ADMIN_PANEL_SESSION_COOKIE_SECURE=false

# ── Search (Meilisearch) ──────────────────────────────────────────────────────
MEILI_MASTER_KEY={{ meili_master_key | generate([A-Za-z0-9],32) }}

# ── Local LLM (llama.cpp) ─────────────────────────────────────────────────────
# Base URL of your llama.cpp server — no trailing /v1
LLAMA_BASE_URL=http://{{ llama_host }}:{{ llama_port | default(5050) }}
LLAMA_MODEL=gemma-4-12b-it

# ── Web search (SearXNG) ──────────────────────────────────────────────────────
SEARXNG_INSTANCE_URL=http://{{ searxng_host }}:{{ searxng_port | default(5080) }}

# ── AI providers (cloud — optional) ──────────────────────────────────────────
# Set to "user_provided" to let users enter their own key in the UI.
OPENAI_API_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided

# ── Email (optional — needed for password reset) ──────────────────────────────
# EMAIL_SERVICE=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=noreply@example.com
