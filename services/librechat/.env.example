# ── Server ────────────────────────────────────────────────────────────────────
PORT=3080

# Set to your public URL when behind a reverse proxy
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Match the user owning the data directories
UID=1000
GID=1000

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET={{ jwt_secret | generate(hex64) }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret | generate(hex64) }}
# encrypt the API keys users save in the UI (32 and 16 bytes as hex)
CREDS_KEY={{ creds_key | generate(hex64) }}
CREDS_IV={{ creds_iv | generate(hex32) }}

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_PASSWORD_RESET=false

# ── Admin panel ───────────────────────────────────────────────────────────────
ADMIN_PANEL_PORT=3003
ADMIN_PANEL_SESSION_SECRET={{ admin_panel_session_secret | generate(hex64) }}
ADMIN_PANEL_SESSION_COOKIE_SECURE=false

# ── Search (Meilisearch) ──────────────────────────────────────────────────────
MEILI_MASTER_KEY={{ meili_master_key | generate([A-Za-z0-9],32) }}

# ── Local LLM (any OpenAI-compatible server: llama.cpp, capy-flash) ─────────────
# One server: librechat.yaml; two: librechat-2.yaml (Qwen for code and reasoning, Gemma for writing)
LIBRECHAT_CONFIG={{ librechat_config | default(librechat.yaml) }}
# Base URL of the server — no trailing /v1; its models are listed from the server
LLAMA_BASE_URL=http://{{ llama_host }}:{{ llama_port | default(5050) }}
# The server's API key; any value for a server without one
LLAMA_API_KEY={{ llama_api_key | default(none) }}
# The second server, Gemma (librechat-2.yaml only)
LLAMA2_BASE_URL={{ llama2_base_url | default() }}
LLAMA2_API_KEY={{ llama2_api_key | default(none) }}

# ── Web search: SearXNG, Firecrawl, a reranker (Jina's API) ───────────────────
# Their addresses (empty: not used); LibreChat reaches them by fixed names on fixed ports (librechat.yaml's allowedAddresses)
SEARXNG_HOST={{ searxng_host | default() }}
FIRECRAWL_HOST={{ firecrawl_host | default() }}
RERANK_HOST={{ rerank_host | default() }}
SEARXNG_INSTANCE_URL=http://librechat-searxng:5080
FIRECRAWL_API_URL=http://librechat-firecrawl:3002
JINA_API_URL=http://librechat-reranker:5052/v1/rerank
# self-hosted Firecrawl and llama.cpp's reranker take any key
FIRECRAWL_API_KEY=none
JINA_API_KEY=none

# ── AI providers (cloud — optional) ──────────────────────────────────────────
# Set to "user_provided" to let users enter their own key in the UI.
OPENAI_API_KEY=user_provided
ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided

# ── Email (optional — needed for password reset) ──────────────────────────────
# EMAIL_SERVICE=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=noreply@example.com
