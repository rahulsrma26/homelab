# Mode — lan: the homelab's reverse proxy (LAN + Tailscale, HTTPS with a wildcard
# certificate); cf: the public entry point behind a Cloudflare Tunnel. See README.
COMPOSE_FILE=docker-compose.yml:compose.{{ traefik_mode | choice(lan,cf) }}.yml

# lan mode only (Enter = empty in cf mode)
# The homelab's own sub-domain of your Cloudflare domain, e.g. home.<your-domain>: apps
# become <name>.DOMAIN, one certificate covers DOMAIN and *.DOMAIN, and one local DNS
# record *.DOMAIN → this LXC serves them all. Public names (<name>.<your-domain>, e.g. on
# a Cloudflare Tunnel) stay untouched.
DOMAIN={{ domain | default() }}
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL={{ acme_email | default() }}
# Cloudflare API token, Zone → DNS → Edit for this one zone (DNS-01 challenge)
CF_DNS_API_TOKEN={{ cf_dns_api_token | default() }}
# Dashboard login at traefik.DOMAIN: user "admin" and this password
DASHBOARD_PASSWORD={{ dashboard_password | generate([A-Za-z0-9],20) }}
