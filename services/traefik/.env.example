# Mode — lan: the homelab's reverse proxy (LAN + Tailscale, HTTPS with a wildcard
# certificate); cf: the public entry point behind a Cloudflare Tunnel; selfsigned: lan with
# Traefik's own certificate and no DNS token (test setups). See README.
COMPOSE_FILE=docker-compose.yml:compose.{{ traefik_mode | choice(lan,cf,selfsigned) }}.yml

# lan and selfsigned modes (Enter = empty in cf mode; selfsigned needs only DOMAIN)
# A sub-domain of your Cloudflare domain (e.g. home.<your-domain>); apps become <name>.DOMAIN
DOMAIN={{ domain | default() }}
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL={{ acme_email | default() }}
# Cloudflare API token, Zone → DNS → Edit for this one zone (DNS-01 challenge)
CF_DNS_API_TOKEN={{ cf_dns_api_token | default() }}
# Dashboard password (user admin)
DASHBOARD_PASSWORD={{ dashboard_password | generate([A-Za-z0-9],20) }}
