PORT=22300
# The address the Joplin apps sync to (e.g. https://joplin.<domain>)
JOPLIN_BASE_URL={{ joplin_base_url }}
# Restoring a dump: type the OLD password (the dump resets the role to it)
JOPLIN_DB_PASSWORD={{ joplin_db_password | generate([A-Za-z0-9],32) }}
# Pin the version that made a dump while restoring (e.g. 3.4.3), then "latest"
JOPLIN_VERSION={{ joplin_version | default(latest) }}
