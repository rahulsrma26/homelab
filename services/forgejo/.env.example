PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
FORGEJO_DATA={{ forgejo_data | default(./data) }}
HTTP_PORT={{ forgejo_http_port | default(3002) }}
SSH_PORT={{ forgejo_ssh_port | default(2222) }}
FORGEJO_DOMAIN=git.{{ domain }}
FORGEJO_SSH_HOST={{ forgejo_ssh_host }}
TRAEFIK_IP={{ traefik_ip }}
# Actions artifacts and packages — local: in FORGEJO_DATA; s3: an S3 bucket (e.g.
# services/garage). Forgejo won't start while the S3 storage is unreachable.
COMPOSE_FILE=docker-compose.yml:compose.{{ forgejo_storage | choice(local,s3) }}.yml
PACKAGES_ENABLED={{ forgejo_packages_enabled | default(false) }}
ARTIFACT_RETENTION_DAYS={{ forgejo_artifact_retention_days | default(7) }}
LOG_RETENTION_DAYS={{ forgejo_log_retention_days | default(90) }}

# s3 mode only (Enter = empty in local mode); the endpoint as host:port
S3_ENDPOINT={{ s3_endpoint | default() }}
S3_BUCKET={{ s3_bucket | default(forgejo) }}
S3_REGION={{ s3_region | default(garage) }}
S3_ACCESS_KEY={{ s3_access_key | default() }}
S3_SECRET_KEY={{ s3_secret_key | default() }}
