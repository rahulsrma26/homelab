PORT=8075

# Where Paperless keeps its data/ (SQLite), media/ (the documents) and export/ — keep them
# together, so one snapshot always has a matching database and files. "." = this folder.
PAPERLESS_DIR={{ paperless_dir | default(.) }}
# Folder Paperless imports new documents from (and deletes them after import)
CONSUME_DIR={{ consume_dir | default(./consume) }}

# Paperless
PAPERLESS_URL=https://{{ paperless_hostname }}
PAPERLESS_SECRET_KEY={{ paperless_secret_key | generate([A-Za-z0-9],64) }}
PAPERLESS_TIME_ZONE={{ tz | default(Etc/UTC) }}
PAPERLESS_OCR_LANGUAGE=eng

# Admin account (only used on first run)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD={{ paperless_admin_password | generate([A-Za-z0-9],16) }}
PAPERLESS_ADMIN_MAIL={{ paperless_admin_mail }}
# Built-in AI (Paperless ≥ 3): suggestions for title, date, tags, correspondent and type, plus
# document chat; with any OpenAI-compatible server, e.g. http://<llm-host>:5050/v1
PAPERLESS_AI_ENABLED={{ ai_enabled | choice(true,false) }}
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_ENDPOINT={{ ai_llm_endpoint | default() }}
PAPERLESS_AI_LLM_MODEL={{ ai_llm_model | default(gemma-4-12b-it) }}
PAPERLESS_AI_LLM_API_KEY={{ ai_llm_api_key | default(none) }}
# Embeddings for document chat, computed on this host's CPU
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=huggingface

# Optional: Paperless-GPT (:3002) — OCR by the vision model above (much better than Tesseract on photos
# and poor scans), plus titles, tags, correspondents and custom fields (README)
COMPOSE_PROFILES=gpt-{{ paperless_gpt | choice(yes,no) }}
GPT_PORT=3002
# Paperless → My Profile → API Auth Token (after the first start), then `labber paperless-ngx restart`
PAPERLESS_API_TOKEN={{ paperless_api_token | default() }}
