PORT=8075

# Where Paperless keeps its data/ (SQLite), media/ (the documents) and export/ — keep them
# together, so one snapshot always has a matching database and files. "." = this folder.
PAPERLESS_DIR={{ paperless_dir | default(.) }}
# Folder Paperless imports new documents from (and deletes them after import)
CONSUME_DIR={{ consume_dir | default(./consume) }}

# Paperless
PAPERLESS_URL=https://{{ paperless_hostname }}
PAPERLESS_SECRET_KEY={{ paperless_secret_key | generate([A-Za-z0-9],64) }}
PAPERLESS_TIME_ZONE={{ tz | default(Etc/UTC) }}
PAPERLESS_OCR_LANGUAGE=eng

# Admin account (only used on first run)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD={{ paperless_admin_password | generate([A-Za-z0-9],16) }}
PAPERLESS_ADMIN_MAIL={{ paperless_admin_mail }}
# Optional containers, each a yes/no question:
#   paperless_gpt  Paperless-GPT (:3002) — LLM titles/tags/OCR, settings below
#   paperless_ai   Paperless-AI (:3003) — tagging + document chat, set up in its web UI
COMPOSE_PROFILES=gpt-{{ paperless_gpt | choice(yes,no) }},ai-{{ paperless_ai | choice(yes,no) }}

# Paperless-GPT (only if paperless_gpt = yes). API token: Paperless → My Profile → API Auth Token
GPT_PORT=3002
PAPERLESS_API_TOKEN={{ paperless_api_token | default() }}
OCR_PROVIDER=llm
LLM_PROVIDER=openai
LLM_MODEL={{ llm_model | default(unsloth/Qwen3.5-9B-MTP-GGUF:Q8_0) }}
VISION_LLM_PROVIDER=openai
VISION_LLM_MODEL={{ llm_model | default(unsloth/Qwen3.5-9B-MTP-GGUF:Q8_0) }}
# An OpenAI-compatible endpoint, e.g. http://<llm-host>:8080/v1 (llama.cpp, Ollama, …)
OPENAI_BASE_URL={{ llm_base_url | default() }}
OLLAMA_HOST={{ llm_base_url | default() }}
OPENAI_API_KEY={{ openai_api_key | default(none) }}
TOKEN_LIMIT=32000

# Paperless-AI (only if paperless_ai = yes)
AI_PORT=3003