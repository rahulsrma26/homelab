# Authelia's secrets (generated; keep them in the password manager: a restore needs the same
# storage key to read the TOTP secrets)
AUTHELIA_JWT_SECRET={{ authelia_jwt_secret | generate([A-Za-z0-9],64) }}
AUTHELIA_SESSION_SECRET={{ authelia_session_secret | generate([A-Za-z0-9],64) }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ authelia_storage_encryption_key | generate([A-Za-z0-9],64) }}

# The cookie domain: the domain your protected apps share (e.g. home.<domain>), and the portal's
# address inside it (e.g. https://auth.home.<domain>)
AUTHELIA_SESSION_DOMAIN={{ domain }}
AUTHELIA_URL=https://auth.{{ domain }}

LLDAP_JWT_SECRET={{ lldap_jwt_secret | generate([A-Za-z0-9],32) }}
LLDAP_ADMIN_PASSWORD={{ lldap_admin_password | generate([A-Za-z0-9],16) }}
LLDAP_BASE_DN={{ lldap_base_dn | default(dc=home,dc=lab) }}

# Their data (users, password hashes, TOTP secrets, sessions): folders that must exist, on a
# backed-up dataset, owned by PUID:PGID (Authelia runs as that user; LLDAP as uid 1000)
AUTHELIA_DATA={{ authelia_data | default(./data/authelia) }}
LLDAP_DATA={{ lldap_data | default(./data/lldap) }}
PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
