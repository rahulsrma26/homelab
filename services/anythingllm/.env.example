PORT=3004

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SIG_KEY=changeme
SIG_SALT=changeme
JWT_SECRET=changeme

# Optional: set a password to protect the UI
# AUTH_TOKEN=changeme

# ── LLM provider ─────────────────────────────────────────────────────────────
# Options: openai, anthropic, ollama, generic-openai, lmstudio, groq, mistral, ...
LLM_PROVIDER=generic-openai

# For a local llama.cpp / OpenAI-compatible endpoint:
GENERIC_OPEN_AI_BASE_PATH=http:/localhost:8123/v1
GENERIC_OPEN_AI_MODEL_PREF=qwen3.8-27b-gsq-rco
# GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=16384
# GENERIC_OPEN_AI_API_KEY=sk-dummy

# ── Embedding ─────────────────────────────────────────────────────────────────
# native uses a local model; switch to openai or ollama if preferred
EMBEDDING_ENGINE=native

# ── Vector database ───────────────────────────────────────────────────────────
# lancedb is embedded (no separate container needed)
VECTOR_DB=lancedb

# ── Whisper (STT for document audio) ─────────────────────────────────────────
# local runs a bundled Whisper model; or use generic-openai to hit llama.cpp
WHISPER_PROVIDER=local
