#!/bin/bash
# Builds a YOLOv9 ONNX model for Frigate with Docker (Frigate docs' export recipe).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODEL_SIZE="s"
IMG_SIZE="320"
OUTPUT="$SCRIPT_DIR/config/model_cache"

usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo "Builds a YOLOv9 ONNX model (yolov9-<size>-<img>.onnx) using Docker."
    echo ""
    echo "Options:"
    echo "  -m, --model-size SIZE   model size (default: s; options: t, s, m, c, e)"
    echo "  -i, --img-size SIZE     input size (default: 320; usually 320 or 640)"
    echo "  -o, --output DIR        where the .onnx goes (default: config/model_cache next to this script)"
    echo "  -h, --help              this help"
    echo ""
    echo "Example: $(basename "$0") -m s -i 320 -o /mnt/nvr/models"
    echo "         then in config.yml: model: path: /media/frigate/models/yolov9-s-320.onnx"
    exit "${1:-0}"
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -m|--model-size) MODEL_SIZE="${2:?}"; shift ;;
        -i|--img-size) IMG_SIZE="${2:?}"; shift ;;
        -o|--output) OUTPUT="${2:?}"; shift ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1"; usage 1 ;;
    esac
    shift
done

[[ "$IMG_SIZE" =~ ^[0-9]+$ ]] || { echo "Error: --img-size must be an integer."; exit 1; }
[[ "$MODEL_SIZE" =~ ^(t|s|m|c|e)$ ]] || { echo "Error: --model-size must be one of: t, s, m, c, e."; exit 1; }
mkdir -p "$OUTPUT"
NAME="yolov9-${MODEL_SIZE}-${IMG_SIZE}.onnx"

# an empty build context: nothing from the current folder is sent to Docker
CONTEXT=$(mktemp -d)
trap 'rm -rf "$CONTEXT"' EXIT

echo "Building $NAME into $OUTPUT ..."
docker build "$CONTEXT" --build-arg MODEL_SIZE="$MODEL_SIZE" --build-arg IMG_SIZE="$IMG_SIZE" --output "$OUTPUT" -f- <<'EOF'
FROM python:3.11 AS build
RUN apt-get update && apt-get install --no-install-recommends -y cmake libgl1 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.10.4 /uv /bin/
WORKDIR /yolov9
ADD https://github.com/WongKinYiu/yolov9.git .
RUN uv pip install --system -r requirements.txt
RUN uv pip install --system onnx==1.18.0 onnxruntime onnx-simplifier==0.4.* onnxscript
ARG MODEL_SIZE
ARG IMG_SIZE
ADD https://github.com/WongKinYiu/yolov9/releases/download/v0.1/yolov9-${MODEL_SIZE}-converted.pt yolov9-${MODEL_SIZE}.pt
RUN sed -i "s/ckpt = torch.load(attempt_download(w), map_location='cpu')/ckpt = torch.load(attempt_download(w), map_location='cpu', weights_only=False)/g" models/experimental.py
RUN python3 export.py --weights ./yolov9-${MODEL_SIZE}.pt --imgsz ${IMG_SIZE} --simplify --include onnx
FROM scratch
ARG MODEL_SIZE
ARG IMG_SIZE
COPY --from=build /yolov9/yolov9-${MODEL_SIZE}.onnx /yolov9-${MODEL_SIZE}-${IMG_SIZE}.onnx
EOF

[[ -s "$OUTPUT/$NAME" ]] || { echo "Error: $OUTPUT/$NAME was not written."; exit 1; }
echo "Built $OUTPUT/$NAME ($(du -h "$OUTPUT/$NAME" | cut -f1))."

# only the build cache (several GB of Python/torch layers); other images stay
echo "Removing the build cache..."
docker builder prune -af >/dev/null
