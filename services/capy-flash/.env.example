# OpenAI/Anthropic-compatible port and the key clients must send (Bearer or x-api-key)
PORT={{ capy_port | default(8123) }}
API_KEY={{ capy_api_key | generate(hex64) }}
MODEL_ID={{ capy_model_id | default(qwen3.8-27b) }}

# Model artifact (downloaded once into MODELS_DIR/capy-flash, checked against the SHA-256)
MODELS_DIR={{ models_dir | generated_dir(models) }}
MODEL_REPO=Feyd89/Qwen3.8-27B-QUASAR-QAT-nvfp4-NInfer
MODEL_REVISION=52f1246387e5730dc8556bb2315db52f6d5be155
MODEL_FILE=qwen3_8_27b_quasar_nvfp4.ninfer
MODEL_SHA256=808a0fa3bb5b3256aadef0d5c8264c106122d1e8483bd2cf74db4e1183cbb570

# Context: one shared KV pool for all requests, each request up to MAX_CONTEXT
MAX_CONTEXT=262144
KV_CAPACITY=262144
MAX_CONCURRENCY={{ capy_max_concurrency | default(3) }}

# Context cache: checkpoint slots on the GPUs, pinned RAM tier, disk tier (survives restarts)
DEVICE_STATE_SLOTS=16
HOST_KV_MIB=16384
CACHE_DIR={{ capy_cache_dir | generated_dir(cache) }}
DISK_CACHE_GIB=64

# Speculative decoding and thinking
DRAFT_TOKENS=4
THINKING_BUDGET=16384

# More server flags (see ninfer-serve --help), appended last
EXTRA_ARGS=
