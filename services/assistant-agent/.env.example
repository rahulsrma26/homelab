# Chat model — gemma-12b: Gemma 4 12B QAT (~9 GB VRAM, best quality); gemma-e4b: Gemma 4 E4B (~6 GB VRAM, faster, weaker tool calls)
# Second speech-to-text engine (the LLM's own is always on) — parakeet: Parakeet TDT 1.1B on the GPU; parakeet-cpu: Parakeet TDT 0.6B v3 on the CPU; parakeet-igpu: the same on an Intel/AMD iGPU (Vulkan); none
# Text-to-speech engine — omnivoice: OmniVoice on the GPU (natural); paradee: Paradee on the CPU
# Embedding server (optional) — embeddinggemma-2: EmbeddingGemma 2 on the GPU (~1 GB VRAM; text and images, for semantic search); none
# Reranker (optional) — qwen3-reranker: Qwen3-Reranker 0.6B on the GPU (~1.4 GB VRAM; orders search results by relevance, e.g. for LibreChat's web search); none
COMPOSE_FILE=docker-compose.yml:compose.llm-{{ llm | choice(gemma-12b,gemma-e4b) }}.yml:compose.stt-{{ stt_engine | choice(parakeet,parakeet-cpu,parakeet-igpu,none) }}.yml:compose.tts-{{ tts_engine | choice(omnivoice,paradee) }}.yml:compose.embed-{{ embeddings | choice(none,embeddinggemma-2) }}.yml:compose.rerank-{{ reranker | choice(none,qwen3-reranker) }}.yml
# parakeet only: model alias, URL or path (fetched into MODELS_DIR/parakeet on first start)
PARAKEET_MODEL={{ parakeet_model | default(https://huggingface.co/mudler/parakeet-cpp-gguf/resolve/main/tdt-1.1b-f16.gguf) }}
PARAKEET_VERSION={{ parakeet_version | default(v0.6.1) }}
# parakeet-cpu and parakeet-igpu: the model (0.6B v3 q8_0 is the fastest on both) and CPU threads
PARAKEET_CPU_MODEL={{ parakeet_cpu_model | default(https://huggingface.co/mudler/parakeet-cpp-gguf/resolve/main/tdt-0.6b-v3-q8_0.gguf) }}
PARAKEET_CPU_THREADS={{ parakeet_cpu_threads | default(4) }}
# Where models are cached (re-downloadable: on the no-backup disk when the guest has one)
MODELS_DIR={{ models_dir | generated_dir(models) }}
# Empty: the template's pinned CUDA 12 build. Another image only for a reason (e.g. a
# server-cuda13-b<build> tag, needs an NVIDIA driver 580 or newer) — pin its build too
LLAMA_IMAGE={{ llama_image | default() }}
CONTEXT_SIZE={{ context_size | default(65536) }}
# Requests served at once; the context is split between them (2: voice keeps its own slot and
# cached prompt while another client, e.g. Paperless, uses the other)
PARALLEL={{ parallel | default(2) }}
THREADS={{ threads | default(6) }}
BATCH_SIZE={{ batch_size | default(1024) }}
UBATCH_SIZE={{ ubatch_size | default(1024) }}
LLAMA_PORT={{ llama_port | default(5050) }}
# embeddinggemma-2 only: its port; the context, split between the requests served at once
# (16384 / 2: the model's full 8192 each); the batch must hold the longest single input
# (2048: text chunks, and images up to 1024 tokens; an image is ~280 by default)
EMBED_PORT={{ embed_port | default(5051) }}
EMBED_CONTEXT_SIZE={{ embed_context_size | default(16384) }}
EMBED_BATCH_SIZE={{ embed_batch_size | default(2048) }}
EMBED_PARALLEL={{ embed_parallel | default(2) }}
# qwen3-reranker only: its port; the context, split between the requests served at once
# (8192 / 2: 4096 tokens per query + document); the batch must hold the longest pair
RERANK_PORT={{ rerank_port | default(5052) }}
RERANK_CONTEXT_SIZE={{ rerank_context_size | default(8192) }}
RERANK_BATCH_SIZE={{ rerank_batch_size | default(4096) }}
RERANK_PARALLEL={{ rerank_parallel | default(2) }}
WYOMING_PORT={{ wyoming_port | default(10300) }}
# parakeet engines: their Wyoming server (STT only)
PARAKEET_WYOMING_PORT={{ parakeet_wyoming_port | default(10301) }}
STT_LANGUAGE={{ stt_language | default(en) }}
# Transcription prompt (sent in the OpenAI "prompt" field): verbatim speech only
STT_PROMPT={{ stt_prompt | default(Task: Speech recognition. Return only the spoken text verbatim. Do not translate, explain, summarize, answer, format, or add labels. If there is no intelligible speech, return an empty response.) }}
# Optional: a Hugging Face token for higher download rate limits
HF_TOKEN={{ hf_token | default() }}
# omnivoice only: f16 (q8_0 and fewer steps sound clearly worse)
OMNIVOICE_MODEL_URL={{ omnivoice_model_url | default(https://huggingface.co/audio-cpp/audio.cpp-gguf/resolve/main/OmniVoice-GGUF/omnivoice-f16.gguf) }}
# the voice in OmniVoice's fixed vocabulary (e.g. "male, middle-aged"); unknown words are rejected
OMNIVOICE_VOICE={{ omnivoice_voice | default(female, young adult) }}
OMNIVOICE_LANGUAGE={{ omnivoice_language | default(en) }}
AUDIOCPP_VERSION={{ audiocpp_version | default(v0.9.2-drama3-base-small) }}
# paradee only: CPU threads (2: ~74x real time; more gains little, and the bridge runs up to 3 sentences at once)
PARADEE_THREADS={{ paradee_threads | default(2) }}
