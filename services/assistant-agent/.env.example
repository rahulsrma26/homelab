# Speech-to-text engine — parakeet: Parakeet TDT (fast, separate container); gemma: the LLM itself
# Text-to-speech engine — omnivoice: OmniVoice on the GPU (natural); paradee: Paradee on one CPU core
COMPOSE_FILE=docker-compose.yml:compose.stt-{{ stt_engine | choice(parakeet,gemma) }}.yml:compose.tts-{{ tts_engine | choice(omnivoice,paradee) }}.yml
# parakeet only: model alias, URL or path (fetched into MODELS_DIR/parakeet on first start)
PARAKEET_MODEL={{ parakeet_model | default(https://huggingface.co/mudler/parakeet-cpp-gguf/resolve/main/tdt-1.1b-f16.gguf) }}
PARAKEET_VERSION={{ parakeet_version | default(v0.6.1) }}
# Model (Hugging Face repo:quant) and its MTP draft head; downloaded on first start
MODEL={{ model | default(unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL) }}
DRAFT_MODEL={{ draft_model | default(unsloth/gemma-4-12B-it-qat-GGUF:Q4_0) }}
MODEL_ALIAS={{ model_alias | default(gemma-4-12b-it) }}
# Where models are cached (a disk without backups is fine: they're re-downloadable)
MODELS_DIR={{ models_dir | default(/opt/generated/models) }}
# CUDA 12 build; use the server-cuda13 tag only with an NVIDIA driver 580 or newer
LLAMA_IMAGE={{ llama_image | default(ghcr.io/ggml-org/llama.cpp:server-cuda) }}
CONTEXT_SIZE={{ context_size | default(65536) }}
THREADS={{ threads | default(6) }}
BATCH_SIZE={{ batch_size | default(1024) }}
UBATCH_SIZE={{ ubatch_size | default(1024) }}
LLAMA_PORT={{ llama_port | default(5050) }}
WYOMING_PORT={{ wyoming_port | default(10300) }}
STT_LANGUAGE={{ stt_language | default(en) }}
# Transcription prompt (sent in the OpenAI "prompt" field): verbatim speech only
STT_PROMPT={{ stt_prompt | default(Task: Speech recognition. Return only the spoken text verbatim. Do not translate, explain, summarize, answer, format, or add labels. If there is no intelligible speech, return an empty response.) }}
# Optional: a Hugging Face token for higher download rate limits
HF_TOKEN={{ hf_token | default() }}
# omnivoice only: f16 (q8_0 and fewer steps sound clearly worse)
OMNIVOICE_MODEL_URL={{ omnivoice_model_url | default(https://huggingface.co/audio-cpp/audio.cpp-gguf/resolve/main/OmniVoice-GGUF/omnivoice-f16.gguf) }}
# the voice in OmniVoice's fixed vocabulary (e.g. "male, middle-aged"); unknown words are rejected
OMNIVOICE_VOICE={{ omnivoice_voice | default(female, young adult) }}
OMNIVOICE_LANGUAGE={{ omnivoice_language | default(en) }}
AUDIOCPP_VERSION={{ audiocpp_version | default(v0.9.2-drama3-base-small) }}
# paradee only: CPU threads (one is enough for ~50x real time)
PARADEE_THREADS={{ paradee_threads | default(1) }}
