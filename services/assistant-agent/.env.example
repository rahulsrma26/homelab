# ── Models ────────────────────────────────────────────────────────────────────
# All three from the same Unsloth release family — downloaded automatically on first start.
# https://huggingface.co/unsloth/gemma-4-12b-it-GGUF
MAIN_MODEL=unsloth/gemma-4-12b-it-GGUF:gemma-4-12b-it-Q8_0.gguf
MMPROJ_MODEL=unsloth/gemma-4-12b-it-GGUF:mmproj-gemma-4-12B-it-bf16.gguf
DRAFT_MODEL=unsloth/gemma-4-12b-it-GGUF:mtp-gemma-4-12b-it.gguf
MODEL_ALIAS=gemma-4-12b-it

# Hugging Face token (only needed if downloading gated models)
HF_TOKEN=

# ── llama.cpp ─────────────────────────────────────────────────────────────────
MODELS_DIR=/opt/generated/models
LLAMA_PORT=5050

# Reduce if VRAM runs out (12B Q8_0 + mmproj + 128k ctx ≈ 16 GB)
CTX_SIZE=128000

# MTP speculative decoding depth (3 is conservative and reliable)
SPEC_DRAFT_N=3

# ── Wyoming STT ───────────────────────────────────────────────────────────────
WYOMING_PORT=10300

# BCP-47 language code sent to Home Assistant (e.g. en, de, fr)
STT_LANGUAGE=en

# Transcription prompt — instructs Gemma to return only verbatim speech.
# Passed in the OpenAI "prompt" field, not as a system message.
STT_PROMPT=Task: Speech recognition. Return only the spoken text verbatim. Do not translate, explain, summarize, answer, format, or add labels. If there is no intelligible speech, return an empty response.
