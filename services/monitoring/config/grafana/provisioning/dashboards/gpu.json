        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * gpu_memory_used_bytes{instance=~\"$host\"} / gpu_memory_total_bytes{instance=~\"$host\"}",
