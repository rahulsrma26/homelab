{
  "uid": "labber-guests",
  "title": "Guests (VMs & LXCs)",
  "description": "VMs and LXCs set up with labber setup (Alloy, job guest-node-exporters).",
  "tags": [
    "homelab",
    "labber"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(node_boot_time_seconds{job=\"guest-node-exporters\"}, instance)",
        "definition": "label_values(node_boot_time_seconds{job=\"guest-node-exporters\"}, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Overview",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (instance) (node_boot_time_seconds{job=\"guest-node-exporters\",instance=~\"$instance\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "B",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"guest-node-exporters\",instance=~\"$instance\",mode=\"idle\"}[5m])))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "C",
          "expr": "100 * (1 - max by (instance) (node_memory_MemAvailable_bytes{job=\"guest-node-exporters\",instance=~\"$instance\"}) / max by (instance) (node_memory_MemTotal_bytes{job=\"guest-node-exporters\",instance=~\"$instance\"}))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "D",
          "expr": "100 * (1 - max by (instance) (node_filesystem_avail_bytes{job=\"guest-node-exporters\",instance=~\"$instance\",mountpoint=\"/\"}) / max by (instance) (node_filesystem_size_bytes{job=\"guest-node-exporters\",instance=~\"$instance\",mountpoint=\"/\"}))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "E",
          "expr": "sum by (instance) (node_systemd_unit_state{job=\"guest-node-exporters\",instance=~\"$instance\",state=\"failed\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "F",
          "expr": "max by (instance) (labber_reboot_required{job=\"guest-node-exporters\",instance=~\"$instance\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "G",
          "expr": "max by (instance) (labber_security_updates_pending{job=\"guest-node-exporters\",instance=~\"$instance\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "H",
          "expr": "sum by (instance) (labber_service_update_available{job=\"guest-node-exporters\",instance=~\"$instance\"})",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "instance": "Machine",
              "Value #A": "Uptime",
              "Value #B": "CPU %",
              "Value #C": "Memory %",
              "Value #D": "Disk / %",
              "Value #E": "Failed services",
              "Value #F": "Reboot needed",
              "Value #G": "Security updates",
              "Value #H": "Service updates"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk / %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk / %"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory %"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed services"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reboot needed"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Machine"
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "description": "CPU and memory are blank for LXCs on purpose \u2014 Proxmox reports those (see the Proxmox dashboard)."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU % (VMs)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"guest-node-exporters\",instance=~\"$instance\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory % (VMs)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"guest-node-exporters\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{job=\"guest-node-exporters\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk usage %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"guest-node-exporters\",instance=~\"$instance\"} / node_filesystem_size_bytes{job=\"guest-node-exporters\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk I/O",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_disk_read_bytes_total{job=\"guest-node-exporters\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} read"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(node_disk_written_bytes_total{job=\"guest-node-exporters\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Failed services",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_systemd_unit_state{job=\"guest-node-exporters\",instance=~\"$instance\",state=\"failed\"} == 1",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "host": true,
              "kind": true,
              "state": true,
              "type": true
            },
            "renameByName": {
              "instance": "Machine",
              "name": "Service"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Machine"
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 6
      }
    }
  ],
  "annotations": {
    "list": []
  }
}