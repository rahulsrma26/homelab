GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | generate([A-Za-z0-9],16) }}
INFLUXDB_ADMIN_PASSWORD={{ influxdb_admin_password | generate([A-Za-z0-9],16) }}
INFLUXDB_ADMIN_TOKEN={{ influxdb_admin_token | generate(hex64) }}
# InfluxDB's data: a folder (e.g. on a backed-up dataset), or empty for the named volume
INFLUXDB_DATA={{ influxdb_data | default() }}
PVE_USER=monitoring@pve
PVE_PASSWORD={{ pve_password }}
PVE_VERIFY_SSL=false
PVE_HOSTS={{ pve_hosts }}
# Traefik's metrics, host:port (its port 8082), comma-separated; empty: no certificate expiry alert
TRAEFIK_METRICS={{ traefik_metrics | default() }}
# Who may push metrics and logs (push-gate): a token per group (openssl rand -hex 32), given to
# that group's senders (labber setup --push-token-file, install-exporters.sh --push-token-file).
# PUSH_AUTH: log (a push without a token passes and shows as group=- in `docker logs push-gate`),
# on (refused), off. Empty tokens and log: as before (nothing refused) until you roll them out
PUSH_AUTH={{ push_auth | default(log) }}
PUSH_TOKEN_HOSTS={{ push_token_hosts | default() }}
PUSH_TOKEN_GUESTS={{ push_token_guests | default() }}
PUSH_TOKEN_CI={{ push_token_ci | default() }}
PUSH_TOKEN_DMZ={{ push_token_dmz | default() }}
# Where alerts go: telegram (the chats below) or ntfy (one topic, priority by severity)
ALERT_TARGET={{ alert_target | default(telegram) }}
# telegram: the loud chat (critical); the quiet one (warnings, the daily notes) falls back to it
TELEGRAM_BOT_TOKEN={{ telegram_bot_token | default() }}
TELEGRAM_CHAT_ID={{ telegram_chat_id | default() }}
TELEGRAM_MANAGER_BOT_TOKEN={{ telegram_manager_bot_token | default() }}
TELEGRAM_MANAGER_CHAT_ID={{ telegram_manager_chat_id | default() }}
# ntfy: its address (no trailing slash), the topic, a send-only token (services/ntfy)
NTFY_URL={{ ntfy_url | default() }}
NTFY_TOPIC={{ ntfy_topic | default(alerts) }}
NTFY_TOKEN={{ ntfy_token | default() }}
# outside watcher: Alertmanager sends the always-firing Watchdog here every minute (e.g. an Uptime
# Kuma push monitor's URL, http://<kuma>:3001/api/push/<token>); empty: no heartbeat
WATCHDOG_URL={{ watchdog_url | default() }}
LOKI_DATA={{ loki_data | default(loki-data) }}
