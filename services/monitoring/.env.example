GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | generate([A-Za-z0-9],16) }}
INFLUXDB_ADMIN_PASSWORD={{ influxdb_admin_password | generate([A-Za-z0-9],16) }}
INFLUXDB_ADMIN_TOKEN={{ influxdb_admin_token | generate(hex64) }}
PVE_USER=monitoring@pve
PVE_PASSWORD={{ pve_password }}
PVE_VERIFY_SSL=false
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_CHAT_ID={{ telegram_chat_id }}
