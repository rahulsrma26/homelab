GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | generate([A-Za-z0-9],16) }}
INFLUXDB_ADMIN_PASSWORD={{ influxdb_admin_password | generate([A-Za-z0-9],16) }}
INFLUXDB_ADMIN_TOKEN={{ influxdb_admin_token | generate(hex64) }}
PVE_USER=monitoring@pve
PVE_PASSWORD={{ pve_password }}
PVE_VERIFY_SSL=false
PVE_HOSTS={{ pve_hosts }}
# Where alerts go: telegram (the chats below) or ntfy (one topic, priority by severity)
ALERT_TARGET={{ alert_target | default(telegram) }}
# telegram: the loud chat (critical); the quiet one (warnings, the daily notes) falls back to it
TELEGRAM_BOT_TOKEN={{ telegram_bot_token | default() }}
TELEGRAM_CHAT_ID={{ telegram_chat_id | default() }}
TELEGRAM_MANAGER_BOT_TOKEN={{ telegram_manager_bot_token | default() }}
TELEGRAM_MANAGER_CHAT_ID={{ telegram_manager_chat_id | default() }}
# ntfy: its address (no trailing slash), the topic, a send-only token (services/ntfy)
NTFY_URL={{ ntfy_url | default() }}
NTFY_TOPIC={{ ntfy_topic | default(alerts) }}
NTFY_TOKEN={{ ntfy_token | default() }}
LOKI_DATA={{ loki_data | default(loki-data) }}
