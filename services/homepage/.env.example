PORT={{ port | default(3000) }}
# Homepage only answers for these host names (comma-separated; add :port when it isn't
# 80/443), e.g. home.<domain>,<lxc-ip>:3000 — anything else gets "host validation failed"
HOMEPAGE_ALLOWED_HOSTS={{ homepage_allowed_hosts }}
# Where the YAML config and your icons/images live. ./config = this service folder;
# on od01's apps LXC: /mnt/homepage/config and /mnt/homepage/images (common/config/homepage)
HOMEPAGE_CONFIG={{ homepage_config | default(./config) }}
HOMEPAGE_IMAGES={{ homepage_images | default(./images) }}
# The user Homepage writes its files as. 1000 = the usual first user; 0 where the config
# folder belongs to root, e.g. on od01's "common" dataset, so Filebrowser/Samba and
# Homepage agree on the owner
PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
