# Scraper (optional) — none: SearXNG only; firecrawl: Firecrawl next to it (URL → clean Markdown, JavaScript pages
# through a headless Chromium; for LibreChat's web search and n8n; ~2.6 GB RAM idle, ~3.1 GB with 8 pages at once)
COMPOSE_FILE=docker-compose.yml:compose.scraper-{{ scraper | default(none) }}.yml
PORT=5080
BASE_URL=https://{{ searxng_hostname }}

# SearXNG
SEARXNG_SECRET={{ searxng_secret | generate(hex64) }}

# Surfshark WireGuard — from Surfshark account → VPN → Manual setup → WireGuard
# Or download a WireGuard config file and copy Address/PrivateKey from [Interface]
WIREGUARD_PRIVATE_KEY={{ wireguard_private_key }}
WIREGUARD_ADDRESSES={{ wireguard_addresses }}

# firecrawl only: its API port (no API key: allow only its clients in the firewall), its job queue's
# database password, and how much it does at once (pages, browsers, jobs) and may use (RAM)
FIRECRAWL_PORT={{ firecrawl_port | default(3002) }}
FIRECRAWL_POSTGRES_PASSWORD={{ firecrawl_postgres_password | generate(hex64) }}
# its job queue's database: jobs only, nothing to keep (on the no-backup disk when the guest has one)
FIRECRAWL_DB_DIR={{ firecrawl_db_dir | generated_dir(firecrawl-db) }}
FIRECRAWL_CONCURRENT_PAGES={{ firecrawl_concurrent_pages | default(4) }}
FIRECRAWL_BROWSERS={{ firecrawl_browsers | default(2) }}
FIRECRAWL_CONCURRENT_JOBS={{ firecrawl_concurrent_jobs | default(3) }}
FIRECRAWL_WORKERS={{ firecrawl_workers | default(4) }}
FIRECRAWL_MEMORY={{ firecrawl_memory | default(4g) }}
FIRECRAWL_BROWSER_MEMORY={{ firecrawl_browser_memory | default(2g) }}
