PORT=5080
BASE_URL=https://{{ searxng_hostname }}

# SearXNG
SEARXNG_SECRET={{ searxng_secret | generate(hex64) }}

# Surfshark WireGuard — from Surfshark account → VPN → Manual setup → WireGuard
# Or download a WireGuard config file and copy Address/PrivateKey from [Interface]
WIREGUARD_PRIVATE_KEY={{ wireguard_private_key }}
WIREGUARD_ADDRESSES={{ wireguard_addresses }}
