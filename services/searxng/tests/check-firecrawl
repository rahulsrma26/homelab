#!/bin/bash
# scraper=firecrawl: Firecrawl scrapes a page to Markdown and searches through this SearXNG (run by hand)
set -euo pipefail
port=$(grep -E '^FIRECRAWL_PORT=' .env | cut -d= -f2 | tr -d "'\"")
api="http://localhost:${port:-3002}/v2"
curl -sf -X POST "$api/scrape" -H 'Content-Type: application/json' -d '{"url":"https://example.com","formats":["markdown"]}' \
    | python3 -c 'import sys,json; d=json.load(sys.stdin); assert d["success"] and "Example Domain" in d["data"]["markdown"]; print("firecrawl: scrape ok")'
curl -sf -X POST "$api/search" -H 'Content-Type: application/json' -d '{"query":"searxng","limit":3}' \
    | python3 -c 'import sys,json; d=json.load(sys.stdin); assert d["success"] and d["data"]["web"]; print("firecrawl: search ok (%d results)" % len(d["data"]["web"]))'
