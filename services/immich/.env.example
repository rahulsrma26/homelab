# Library (originals, thumbnails, encoded videos, Immich's own DB backups) — mounted at
# /data in the container. On od01: the LXC's bind mount of spool/encrypted/vault/photos.
UPLOAD_LOCATION={{ upload_location | default(/mnt/photos) }}
# Postgres data: on the machine's own (fast) disk, inside the service folder
DB_DATA_LOCATION={{ db_data_location | default(./postgres) }}
# "v3" = the newest v3.x.y on every update, never a surprise jump to v4 (a major version
# needs reading its breaking changes first). Restoring a backup: the version that made it
# (in the dump's name, e.g. v2.0.1), then upgrade.
IMMICH_VERSION={{ immich_version | default(v3) }}

DB_USERNAME=immich
DB_DATABASE_NAME=immich
# Restoring a backup: type the OLD password here (the dump resets the role to it)
DB_PASSWORD={{ db_password | generate([A-Za-z0-9],32) }}

TZ={{ tz | default(Etc/UTC) }}

# Optional containers, each a yes/no question:
#   immich_ml           local machine learning (OpenVINO on the iGPU). Another ML server
#                       (e.g. on a GPU, for big re-indexing jobs) can be added in
#                       Admin → Machine Learning → URL, before or after this one
#   immich_kiosk        Immich Kiosk slideshow (:3502)
#   immich_frame        ImmichFrame photo frame (:3503)
#   immich_power_tools  Immich Power Tools (:3504)
COMPOSE_PROFILES=ml-{{ immich_ml | choice(yes,no) }},kiosk-{{ immich_kiosk | choice(yes,no) }},frame-{{ immich_frame | choice(yes,no) }},powertools-{{ immich_power_tools | choice(yes,no) }}

# Immich Kiosk (only if immich_kiosk = yes). API key: Immich → Account Settings → API Keys
# (a restored database keeps the old key — reuse it)
KIOSK_IMMICH_API_KEY={{ kiosk_immich_api_key | default() }}
KIOSK_CONFIG_LOCATION={{ kiosk_config_location | default(./kiosk-config) }}
KIOSK_LANG={{ kiosk_lang | default(en_GB) }}

# ImmichFrame (only if immich_frame = yes): password for its /admin page
IMMICHFRAME_ADMIN_PASSWORD={{ immichframe_admin_password | generate([A-Za-z0-9],20) }}
IMMICHFRAME_CONFIG_LOCATION={{ immichframe_config_location | default(./immichframe-config) }}

# Immich Power Tools (only if immich_power_tools = yes): its own API key, and the address
# you open Immich at (for links back to it), e.g. https://photos.<domain>
POWER_TOOLS_IMMICH_API_KEY={{ power_tools_immich_api_key | default() }}
EXTERNAL_IMMICH_URL={{ external_immich_url | default() }}
