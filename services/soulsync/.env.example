PORT={{ port | default(8008) }}
TZ={{ tz | default(Etc/UTC) }}
# User SoulSync writes files as
PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
# Where downloads land (outside the library), and the final music library
DOWNLOADS_DIR={{ downloads_dir | default(./downloads) }}
MUSIC_LIBRARY_DIR={{ music_library_dir | default(./library) }}
# Spotify / Tidal OAuth callback ports
SPOTIFY_CALLBACK_PORT={{ spotify_callback_port | default(8888) }}
TIDAL_CALLBACK_PORT={{ tidal_callback_port | default(8889) }}
# slskd (Soulseek client): its web login and the API key SoulSync uses
# yes: slskd on this network · vpn: slskd only through gluetun · no: without slskd
COMPOSE_PROFILES=slskd-{{ slskd | choice(vpn,yes,no) }}
SLSKD_PORT={{ slskd_port | default(5030) }}
# Soulseek peer port (with a VPN that forwards a fixed port: that port)
SLSKD_LISTEN_PORT={{ slskd_listen_port | default(50300) }}
SLSKD_API_KEY={{ slskd_api_key | generate([A-Za-z0-9],32) }}
SLSKD_USERNAME={{ slskd_username | default(admin) }}
SLSKD_PASSWORD={{ slskd_password | generate([A-Za-z0-9],20) }}
# Soulseek account slskd logs in with (a new, unused name is registered on first login)
SOULSEEK_USERNAME={{ soulseek_username }}
SOULSEEK_PASSWORD={{ soulseek_password }}
# VPN for slskd-vpn (gluetun, WireGuard): provider name as gluetun spells it, and the
# [Interface] PrivateKey / Address (with its mask, e.g. /16) from the provider's WireGuard config
VPN_SERVICE_PROVIDER={{ vpn_service_provider | default(surfshark) }}
WIREGUARD_PRIVATE_KEY={{ wireguard_private_key | default() }}
WIREGUARD_ADDRESSES={{ wireguard_addresses | default() }}
VPN_SERVER_COUNTRIES={{ vpn_server_countries | default(Netherlands) }}
