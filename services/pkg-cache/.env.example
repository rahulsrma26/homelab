# Where the caches live (disposable; a disk without backups is fine)
CACHE_DIR={{ cache_dir | default(./cache) }}
APT_PORT={{ apt_port | default(3142) }}
MIRROR_PORT={{ mirror_port | default(5000) }}
# Days a package nobody asked for is kept; how long an image layer is kept after its last pull
APT_KEEP_DAYS={{ apt_keep_days | default(4) }}
MIRROR_KEEP={{ mirror_keep | default(168h) }}
# The package cache's size cap (GiB): over it, the least recently used packages go first, down to 80 %.
# The image mirror has no cap of its own (it drops layers MIRROR_KEEP after caching them): give
# CACHE_DIR a quota (e.g. a ZFS dataset) above APT_MAX_GB + what a week of images takes
APT_MAX_GB={{ apt_max_gb | default(40) }}
# Optional: a Docker Hub login (a read-only access token) raises the pull limit from 100 to 200 per 6 hours
DOCKER_HUB_USER={{ docker_hub_user | default() }}
DOCKER_HUB_TOKEN={{ docker_hub_token | default() }}
