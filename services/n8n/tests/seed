#!/usr/bin/env python3
# A fresh instance: the owner account and one workflow, "labseed", for tests/check to find.
import sys
sys.path.insert(0, __file__.rsplit('/', 1)[0]); from _api import req, wait_ready, login, data, OWNER
wait_ready()
st, out = req('POST', '/rest/owner/setup', OWNER)
if st != 200: raise SystemExit(f'owner setup: {st} {out}')
login()
wf = {'name': 'labseed', 'nodes': [], 'connections': {}, 'settings': {}, 'active': False}
st, out = req('POST', '/rest/workflows', wf)
if st != 200: raise SystemExit(f'workflow: {st} {out}')
print('seed: owner and workflow', data(out).get('id'))
