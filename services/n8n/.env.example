# The address n8n is reached at (its editor and webhooks), without https://, e.g. n8n.home.<domain>
N8N_HOST={{ n8n_host }}
PORT={{ n8n_port | default(5678) }}
# Encrypts the credentials stored in n8n: keep a copy in the password manager — without it a
# restored database can't decrypt them
N8N_ENCRYPTION_KEY={{ n8n_encryption_key | generate(hex64) }}
# Workflows, credentials, execution history (SQLite); the folder must exist and belong to PUID:PGID
N8N_DATA={{ n8n_data | default(./data) }}
PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
TZ={{ tz | default(Etc/UTC) }}
# How long finished executions are kept, in hours (336 = 14 days)
N8N_EXECUTIONS_MAX_AGE_HOURS={{ n8n_executions_max_age_hours | default(336) }}
