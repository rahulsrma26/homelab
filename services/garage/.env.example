PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
GARAGE_DIR={{ garage_dir | default(.) }}
S3_PORT={{ garage_s3_port | default(3900) }}
GARAGE_RPC_SECRET={{ garage_rpc_secret | generate(hex64) }}
GARAGE_DEFAULT_BUCKET={{ garage_bucket | default(forgejo) }}
GARAGE_DEFAULT_ACCESS_KEY=GK{{ garage_access_key | generate(hex24) }}
GARAGE_DEFAULT_SECRET_KEY={{ garage_secret_key | generate(hex64) }}
