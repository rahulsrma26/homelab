# The address the apps and browser extensions use (https://…); logins with passkeys are tied to it
VAULTWARDEN_DOMAIN=https://{{ vaultwarden_host }}
PORT={{ vaultwarden_port | default(8222) }}
# Database, attachments and signing key; the folder must exist and belong to PUID:PGID
VAULTWARDEN_DATA={{ vaultwarden_data | default(./data) }}
PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
TZ={{ tz | default(Etc/UTC) }}

# Admin page (/admin): empty = off. To turn it on, put an Argon2 hash here (never the
# plain token): docker run --rm -it vaultwarden/server:1.37.4 /vaultwarden hash
ADMIN_TOKEN={{ vaultwarden_admin_token | default() }}

# Push notifications to the mobile apps: an installation id/key from bitwarden.com/host
PUSH_ENABLED={{ vaultwarden_push | choice(false,true) }}
PUSH_INSTALLATION_ID={{ push_installation_id | default() }}
PUSH_INSTALLATION_KEY={{ push_installation_key | default() }}
