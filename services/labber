# an Intel or AMD GPU that can do video decode (a passed-through iGPU). VMs also have
# /dev/dri/card0 for the virtual display (vendor 0x1234), which doesn't count.
has_media_gpu() {
    local v
    for v in /sys/class/drm/renderD*/device/vendor; do
        [[ -f "$v" ]] || continue
        case "$(cat "$v")" in 0x8086|0x1002) return 0 ;; esac
    done
    return 1
}

