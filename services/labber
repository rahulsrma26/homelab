#!/usr/bin/env bash
# labber moved to labber/labber (since 4.0.0 it is a folder: the script plus the config
# files it installs). This forwarder stays at the old path for labbers installed before
# 4.0.0, which self-update from here, and for the old `bash <(curl …/services/labber)`
# commands.
#
# Run as the installed /usr/local/bin/labber, it migrates that install to the new
# layout (/usr/local/lib/labber, linked from /usr/local/bin/labber), then runs the
# command it was given. Otherwise (or without root) it just runs the new labber once.
set -euo pipefail

VERSION="4.0.0"
LABBER_URL="${LABBER_URL:-https://codeload.github.com/rahulsrma26/homelab/tar.gz/refs/heads/main}"
LABBER_BIN="/usr/local/bin/labber"

forward() {
    local tmp script dir
    tmp=$(mktemp -d /tmp/labber-forward-XXXXXX)
    if ! curl -fsSL "$LABBER_URL" 2>/dev/null | tar -xzf - -C "$tmp" 2>/dev/null \
        || ! script=$(find "$tmp" -mindepth 3 -maxdepth 3 -type f -path '*/labber/labber' -print -quit | grep .); then
        rm -rf "$tmp"
        echo "error: could not download labber from $LABBER_URL" >&2
        exit 1
    fi
    dir=$(dirname "$script")

    # the installed pre-4.0 labber: move it to the new layout, using the new labber's
    # own installer (sourcing labber only defines its functions)
    local self; self=$(readlink -f "${BASH_SOURCE[0]:-}" 2>/dev/null || true)
    if [[ "$self" == "$LABBER_BIN" ]]; then
        local s=""
        if (( EUID != 0 )); then
            if sudo -n true 2>/dev/null; then s="sudo"
            elif [[ -t 0 ]]; then echo ":: labber moved to /usr/local/lib/labber — sudo is needed once to move it" >&2; s="sudo"
            fi
        fi
        if (( EUID == 0 )) || [[ -n "$s" ]]; then
            if $s bash -c 'source "$1"; labber_place "$2"' _ "$script" "$dir" < /dev/null; then
                rm -rf "$tmp"
                echo "✓ labber moved to /usr/local/lib/labber (v$(grep -m1 '^VERSION=' "$LABBER_BIN" | cut -d'"' -f2))" >&2
                exec "$LABBER_BIN" "$@"
            fi
            echo "! couldn't move labber to /usr/local/lib/labber — running it from a download this time" >&2
        else
            echo "! labber moved to /usr/local/lib/labber — run 'sudo labber update' once to move this install" >&2
        fi
    fi

    local rc=0
    bash "$script" "$@" || rc=$?
    rm -rf "$tmp"
    exit "$rc"
}

# everything is in a function, so `curl … | bash -s …` reads the whole script first
forward "$@"
