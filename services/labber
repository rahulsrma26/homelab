st_admin_status() {
    local a; a=$(setup_admin_name)
    if [[ -n "$a" ]] && id -nG "$a" | grep -qw sudo; then echo "done: $a"; else echo "todo"; fi
}
st_admin_run() {
    local name
    while true; do
        name=$(ask "admin username (you'll SSH in as this user)")
        [[ "$name" =~ ^[a-z_][a-z0-9_-]{0,31}$ && "$name" != root ]] && break
        warn "use lowercase letters, digits, - or _"
    done
    if ! id "$name" &>/dev/null; then
        info "creating $name — choose a password (it's used for sudo)"
        adduser --gecos "" "$name" || return 1
    fi
    usermod -aG sudo "$name" || return 1
    if getent group _ssh >/dev/null; then usermod -aG _ssh "$name"; fi
    # keys Proxmox (or you) put on root also let you in as the admin user
    if [[ -s /root/.ssh/authorized_keys ]]; then
        local key
        while IFS= read -r key; do
            [[ "$key" =~ ^(ssh-|ecdsa-|sk-) ]] && add_ssh_key "$name" "$key"
        done < /root/.ssh/authorized_keys
        ok "copied root's SSH keys to $name"
    fi
    state_set admin "$name"
    SETUP_USER="$name"
}

current_tz() {
    if [[ -f /etc/timezone ]]; then cat /etc/timezone
    else readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||' || true; fi
}
st_hostname_status() {
    local tz; tz=$(current_tz)
    if [[ -z "$tz" || "$tz" == *UTC* ]]; then echo "todo: timezone ${tz:-unset}"; else echo "done: $(hostname), $tz"; fi
}
st_hostname_run() {
    local cur_tz def_tz tz
    cur_tz=$(current_tz)
    def_tz="$cur_tz"; [[ -z "$def_tz" || "$def_tz" == *UTC* ]] && def_tz="Europe/London"
    tz=$(ask "timezone" "$def_tz")
    if [[ -f "/usr/share/zoneinfo/$tz" ]]; then
        ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
        echo "$tz" > /etc/timezone
        ok "timezone $tz"
    else
        warn "unknown timezone '$tz' — skipped (list: ls /usr/share/zoneinfo)"
    fi

    local cur new; cur=$(hostname)
    new=$(ask "hostname" "$cur")
    if [[ ! "$new" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]; then
        warn "invalid hostname '$new' — skipped"
    elif [[ "$new" != "$cur" ]]; then
        if [[ "$SETUP_VIRT" == lxc ]]; then
            # Proxmox rewrites an LXC's hostname and /etc/hosts at every start
            SETUP_HOST_CMDS+=("pct set <CTID> --hostname $new && pct reboot <CTID>")
            info "hostname is managed by Proxmox for LXCs — command added to the summary"
        else
            hostnamectl set-hostname "$new" 2>/dev/null || { echo "$new" > /etc/hostname; hostname "$new"; }
            if grep -q '^127\.0\.1\.1' /etc/hosts; then
                sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$new/" /etc/hosts
            else
                printf '127.0.1.1\t%s\n' "$new" >> /etc/hosts
            fi
            ok "hostname $new"
        fi
    fi
}

st_ssh_status() {
    local u; u=$(setup_login_user)
    if [[ -f "$SETUP_SSH_CONF" ]]; then echo "done"
    elif has_ssh_key "$u"; then echo "todo"
    else echo "todo: no SSH key for $u yet"; fi
}
st_ssh_run() {
    pkg_installed openssh-server || apt_install openssh-server || return 1
    if ! grep -qiE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf' /etc/ssh/sshd_config; then
        warn "/etc/ssh/sshd_config doesn't include sshd_config.d — skipped"
        return 0
    fi

    local user; user=$(setup_login_user)
    if ! has_ssh_key "$user"; then
        warn "no SSH key installed for $user — password logins stay on until there is one"
        local key; key=$(ask "paste your public key (ssh-ed25519 …), or Enter to skip")
        if [[ "$key" =~ ^(ssh-(ed25519|rsa)|ecdsa-sha2-[a-z0-9-]+|sk-[a-z0-9@.-]+)[[:space:]]+[A-Za-z0-9+/=]+ ]]; then
            add_ssh_key "$user" "$key"; ok "key added for $user"
        else
            [[ -z "$key" ]] || warn "that doesn't look like a public key"
            SETUP_NOTES+=("add your key from your Mac: ssh-copy-id $user@$(primary_ip) — then run 'labber setup' again for key-only SSH")
            return 0
        fi
    fi

    # root: key-only in an LXC; off in a VM once an admin with sudo can log in instead
    local root_policy="prohibit-password"
    if [[ "$SETUP_VIRT" == vm ]]; then
        if [[ "$user" != root ]] && id -nG "$user" | grep -qw sudo; then
            root_policy="no"
        else
            warn "no admin user with sudo yet — root keeps key-only login"
        fi
    fi

    mkdir -p "$(dirname "$SETUP_SSH_CONF")"
    cat > "$SETUP_SSH_CONF" <<EOF
# managed by labber setup — delete this file to undo
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin $root_policy
EOF
    if ! /usr/sbin/sshd -t 2>/dev/null; then
        rm -f "$SETUP_SSH_CONF"
        warn "sshd rejected the config — nothing changed"
        return 1
    fi
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || systemctl restart ssh
    echo
    info "keep this session open, and from a SECOND terminal on your Mac run:"
    echo -e "    ${W}ssh $user@$(primary_ip)${N}"
    if yesno "did that log in without asking for a password?" n; then
        ok "SSH is key-only (root: $root_policy)"
    else
        rm -f "$SETUP_SSH_CONF"
        systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
        warn "reverted — password logins are back on"
    fi
}

