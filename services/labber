#!/usr/bin/env bash
# labber — homelab service manager
set -euo pipefail

VERSION="2.6.1"
# The LABBER_* environment variables are for tests only: they point labber at a
# local copy of the repo and a separate services folder. Leave them unset normally.
REPO="${LABBER_REPO:-https://github.com/rahulsrma26/homelab.git}"
LABBER_URL="${LABBER_URL:-https://raw.githubusercontent.com/rahulsrma26/homelab/refs/heads/main/services/labber}"
LABBER_BIN="/usr/local/bin/labber"
SERVICE_BASE="${LABBER_SERVICE_BASE:-/opt/homelab/services}"

# ── colours ───────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    R=$'\033[0;31m' G=$'\033[0;32m' Y=$'\033[1;33m'
    B=$'\033[0;34m' C=$'\033[0;36m' W=$'\033[1m' N=$'\033[0m'
else
    R='' G='' Y='' B='' C='' W='' N=''
fi

die()  { echo -e "${R}error: $*${N}" >&2; exit 1; }
info() { echo -e "${C}:: $*${N}"; }
ok()   { echo -e "${G}✓ $*${N}"; }
warn() { echo -e "${Y}! $*${N}"; }

# ── helpers ───────────────────────────────────────────────────────────────────

check_deps() {
    local miss=()
    for cmd in docker git; do command -v "$cmd" &>/dev/null || miss+=("$cmd"); done
    (( ${#miss[@]} == 0 )) || die "missing: ${miss[*]}"
}

check_svc_writable() {
    if (( EUID == 0 )); then
        warn "running as root — service files will be owned by root"
        if [[ -n "${SUDO_USER:-}" ]]; then
            warn "ownership will be fixed to ${SUDO_USER} after install"
        else
            warn "consider running as a regular user instead"
        fi
        mkdir -p "$SERVICE_BASE"
    elif [[ ! -d "$SERVICE_BASE" ]]; then
        # Directory doesn't exist — try to create it with sudo
        info "creating $SERVICE_BASE..."
        sudo mkdir -p "$SERVICE_BASE" && sudo chown "$(whoami):$(whoami)" "$SERVICE_BASE" \
            || die "could not create $SERVICE_BASE — run: sudo mkdir -p $SERVICE_BASE && sudo chown $(whoami):$(whoami) $SERVICE_BASE"
    elif [[ ! -w "$SERVICE_BASE" ]]; then
        die "$SERVICE_BASE is not writable by $(whoami) — fix with: sudo chown -R $(whoami):$(whoami) $SERVICE_BASE"
    fi
}

svc_dir() { echo "$SERVICE_BASE/$1"; }

need_svc() {
    local dir; dir=$(svc_dir "$1")
    [[ -f "$dir/docker-compose.yml" ]] || die "'$1' not installed (no docker-compose.yml at $dir)"
    echo "$dir"
}

list_installed() {
    [[ -d "$SERVICE_BASE" ]] || return 0
    find "$SERVICE_BASE" -maxdepth 3 -name "docker-compose.yml" -exec dirname {} \; \
        | sed "s|^$SERVICE_BASE/||" | sort
}

pick() {
    local prompt="$1"; shift; local items=("$@")
    (( ${#items[@]} > 0 )) || die "nothing to pick from"
    echo -e "\n${W}${prompt}${N}" >&2
    for i in "${!items[@]}"; do printf "  %2d) %s\n" "$((i+1))" "${items[$i]}" >&2; done
    echo >&2
    local n
    while true; do
        read -rp "choice [1-${#items[@]}]: " n
        [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#items[@]} )) && break
        echo -e "${Y}! invalid choice${N}" >&2
    done
    echo "${items[$((n-1))]}"
}

# service names are paths under $SERVICE_BASE: no "..", no leading slash or dot,
# so nothing built from them (cd, cp, rm -rf) can point outside it
valid_svc_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$ && "$1" != *..* ]]
}

# resolve service: use CLI arg if given, else interactive pick from installed
resolve_svc() {
    if [[ -n "${1:-}" ]]; then
        valid_svc_name "$1" || die "invalid service name '$1'"
        echo "$1"; return
    fi
    local svcs; mapfile -t svcs < <(list_installed)
    (( ${#svcs[@]} > 0 )) || die "no services installed under $SERVICE_BASE"
    pick "Select service:" "${svcs[@]}"
}

# sparse-clone one top-level repo directory into a fresh temp dir; prints the path.
# The caller sets the cleanup trap with the path expanded, e.g.
#   trap "rm -rf '$tmpdir'" EXIT
# (a trap that refers to a function-local variable runs after the function has
# returned, when the variable no longer exists, so it would delete nothing)
clone_repo_dir() {
    local tmpdir; tmpdir=$(mktemp -d /tmp/homelab-deploy-XXXXXX)
    # set -e doesn't apply inside $(...), so fail explicitly
    if ! git clone --depth=1 --sparse --filter=blob:none -q "$REPO" "$tmpdir" \
        || ! git -C "$tmpdir" sparse-checkout set "$1"; then
        rm -rf "$tmpdir"
        echo -e "${R}error: could not fetch $REPO${N}" >&2
        return 1
    fi
    echo "$tmpdir"
}

# copy a service's files from the repo over the installed copy, keeping .env.
# The backup sits next to .env (same owner and permissions) rather than in /tmp,
# and is left behind if anything fails, so the .env is never lost.
copy_svc_files() {
    local src="$1" dest="$2"
    [[ -f "$dest/.env" ]] && cp -p "$dest/.env" "$dest/.env.labber-bak"
    cp -r "$src/." "$dest/"
    if [[ -f "$dest/.env.labber-bak" ]]; then mv -f "$dest/.env.labber-bak" "$dest/.env"; fi
}

# under sudo, files labber copies end up owned by root: hand them back to the
# person who ran sudo. Only the files that came from the repo — never service
# data, which may deliberately belong to another user (postgres runs as 999).
give_back_files() {
    local src="$1" dest="$2" f
    (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]] || return 0
    while IFS= read -r f; do
        chown -h "$SUDO_USER:" "$dest/$f" 2>/dev/null || true
    done < <(cd "$src" && find . -mindepth 1 | sed 's|^\./||')
    chown "$SUDO_USER:" "$dest" 2>/dev/null || true
}

# fetch new images (and rebuild locally built ones) while the old containers keep
# running, then swap them over. If a pull or build fails the service stays up.
#   - pull --ignore-buildable: images built from a local Dockerfile can't be pulled
#   - build --pull: rebuild local images on a fresh base image
#   - image prune: only dangling images — never touches other services' containers
compose_refresh() {
    local dir="$1"
    # older compose releases don't know --ignore-buildable; fall back to not
    # failing on images that can only be built
    if docker compose pull --help 2>/dev/null | grep -q -- '--ignore-buildable'; then
        (cd "$dir" && docker compose pull --ignore-buildable)
    else
        (cd "$dir" && docker compose pull --ignore-pull-failures)
    fi
    # only build when something is built locally (avoids a "No services to build" warning)
    if grep -qE '^[[:space:]]+build:' "$dir/docker-compose.yml"; then
        (cd "$dir" && docker compose build --pull)
    fi
    (cd "$dir" && docker compose down --remove-orphans)
    (cd "$dir" && docker compose up -d)
    docker image prune -f >/dev/null
}

# home directory of the person running labber (their own home, even under sudo)
target_home() {
    if [[ -n "${SUDO_USER:-}" ]]; then getent passwd "$SUDO_USER" | cut -d: -f6; else echo "$HOME"; fi
}

# put a downloaded labber at $LABBER_BIN without overwriting the running file in
# place: copy next to it, then rename. A running labber keeps reading the old file.
place_bin() {
    local src="$1" sudo_cmd=""
    (( EUID == 0 )) || sudo_cmd="sudo"
    $sudo_cmd cp "$src" "$LABBER_BIN.new"
    $sudo_cmd chmod 755 "$LABBER_BIN.new"
    $sudo_cmd mv -f "$LABBER_BIN.new" "$LABBER_BIN"
    rm -f "$src"
}

# ── .env placeholders ─────────────────────────────────────────────────────────
# Placeholder values used in .env.example:
#   _changeme_          you must provide it (e.g. an API token from another app)
#   _changeme_min_N_    any value of at least N characters; autofill: N random letters/digits
#   _changeme_hex_N_    exactly N hex characters;           autofill: random hex
#   _changeme_b64_N_    base64 of N random bytes;            autofill: random
#   _changeme_md5_      same as _changeme_hex_32_
#   _changeme_sha256_   same as _changeme_hex_64_
#   _changeme_uuid_     a UUID;                              autofill: random UUID
#   changeme, <...>     older style — you must provide it

# N random characters from a tr character set, e.g. rand_chars 32 'A-Za-z0-9'
rand_chars() {
    local out=""
    while (( ${#out} < $1 )); do
        out+=$(head -c 4096 /dev/urandom | LC_ALL=C tr -dc "$2")
    done
    echo "${out:0:$1}"
}

rand_uuid() {
    if [[ -r /proc/sys/kernel/random/uuid ]]; then cat /proc/sys/kernel/random/uuid
    else uuidgen | tr 'A-Z' 'a-z'; fi
}

# placeholder rule for a value: prints "<kind> <length>", or nothing if not a placeholder
placeholder_rule() {
    local v="$1"
    case "$v" in
        _changeme_|changeme) echo "manual 0" ;;
        _changeme_md5_)      echo "hex 32" ;;
        _changeme_sha256_)   echo "hex 64" ;;
        _changeme_uuid_)     echo "uuid 36" ;;
        *)
            if [[ "$v" =~ ^_changeme_(min|hex|b64)_([0-9]+)_$ ]]; then
                echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
            elif [[ "$v" =~ \<[^\>]+\> ]]; then
                echo "manual 0"
            fi
            ;;
    esac
}

rule_desc() {
    case "$1" in
        manual) echo "required" ;;
        min)    echo "at least $2 characters" ;;
        hex)    echo "$2 hex characters" ;;
        b64)    echo "base64 of $2 random bytes" ;;
        uuid)   echo "UUID" ;;
    esac
}

rule_generate() {
    case "$1" in
        min)  rand_chars "$2" 'A-Za-z0-9' ;;
        hex)  rand_chars "$2" 'a-f0-9' ;;
        b64)  head -c "$2" /dev/urandom | base64 | tr -d '\n' ;;
        uuid) rand_uuid ;;
    esac
}

# is a typed value acceptable for the rule?
rule_valid() {
    local kind="$1" len="$2" v="$3"
    [[ -n "$v" ]] || return 1
    case "$kind" in
        min)  (( ${#v} >= len )) ;;
        hex)  [[ "$v" =~ ^[0-9a-fA-F]+$ ]] && (( ${#v} == len )) ;;
        uuid) [[ "$v" =~ ^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$ ]] ;;
        *)    return 0 ;;
    esac
}

# value of KEY in an env file, the way compose reads it: quotes removed, and for
# unquoted values a trailing " # comment" dropped. Tolerates Windows line endings.
env_get() {
    local file="$1" key="$2" line
    line=$(grep -E "^[[:space:]]*${key}=" "$file" 2>/dev/null | tail -1) || return 0
    line="${line%$'\r'}"
    line="${line#*=}"
    if [[ "$line" =~ ^\"([^\"]*)\" || "$line" =~ ^\'([^\']*)\' ]]; then
        line="${BASH_REMATCH[1]}"
    else
        [[ "$line" =~ ^(.*[^[:space:]])?[[:space:]]+#.*$ ]] && line="${BASH_REMATCH[1]}"
        line="${line%"${line##*[![:space:]]}"}"
    fi
    echo "$line"
}

# set KEY=value in an env file (rewritten in place, keeps owner/permissions).
# Values with spaces or special characters are single-quoted so compose takes them
# literally. A trailing " # comment" on the line is kept.
env_set() {
    local file="$1" key="$2" val="$3"
    if [[ ! "$val" =~ ^[A-Za-z0-9_./:@+=,-]*$ ]]; then
        if [[ "$val" != *"'"* ]]; then
            val="'$val'"
        else
            warn "$key contains both ' and special characters — check how it was written in $file"
        fi
    fi
    local tmp; tmp=$(mktemp)
    K="$key" V="$val" awk '
        !done && $0 ~ "^[[:space:]]*" ENVIRON["K"] "=" {
            sub(/\r$/, "")
            comment = ""
            if (match($0, /[ \t]+#.*$/)) comment = substr($0, RSTART)
            print ENVIRON["K"] "=" ENVIRON["V"] comment
            done = 1; next
        }
        { print }
    ' "$file" > "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
}

# prompts need a person at the keyboard (not cron, not a pipe)
interactive() { [[ -t 0 ]]; }

# keys in .env.example that .env doesn't have yet are appended (with their placeholder)
sync_env_keys() {
    local dir="$1" line key added=()
    [[ -f "$dir/.env.example" && -f "$dir/.env" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
        key="${BASH_REMATCH[1]}"
        grep -qE "^[[:space:]]*${key}=" "$dir/.env" && continue
        [[ -s "$dir/.env" && -n "$(tail -c1 "$dir/.env")" ]] && echo >> "$dir/.env"
        echo "$line" >> "$dir/.env"
        added+=("$key")
    done < "$dir/.env.example"
    (( ${#added[@]} == 0 )) || info "added new settings from .env.example: ${added[*]}"
}

# keys in .env whose value is still a placeholder: prints "KEY kind len" per line
env_placeholders() {
    local file="$1" key val rule
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
        key="${BASH_REMATCH[1]}"; val=$(env_get "$file" "$key")
        rule=$(placeholder_rule "$val")
        [[ -z "$rule" ]] || echo "$key $rule"
    done < "$file"
}

# walk through every placeholder in .env: generate it, or let the user type it
fill_env_placeholders() {
    local env="$1" items
    mapfile -t items < <(env_placeholders "$env")
    (( ${#items[@]} > 0 )) || return 0
    if ! interactive; then
        warn "$env has ${#items[@]} unset value(s) — run labber interactively to fill them"
        return 0
    fi

    local auto_n=0 it
    for it in "${items[@]}"; do [[ "${it#* }" != manual* ]] && auto_n=$((auto_n + 1)); done
    echo; info "${#items[@]} setting(s) in $env need a value"

    local autofill="n" ans
    if (( auto_n > 0 )); then
        read -rp "Generate the $auto_n secret(s) that can be generated? [Y/n] " ans
        [[ "$ans" =~ ^[Nn]$ ]] || autofill="y"
    fi

    local key kind len val
    for it in "${items[@]}"; do
        read -r key kind len <<< "$it"
        if [[ "$kind" != manual && "$autofill" == y ]]; then
            env_set "$env" "$key" "$(rule_generate "$kind" "$len")"
            ok "$key generated ($(rule_desc "$kind" "$len"))"
            continue
        fi
        # show templates like https://joplin.<your-domain> as a hint; bare tokens add nothing
        local hint="" cur; cur=$(env_get "$env" "$key")
        [[ "$cur" == *"<"*">"* ]] && hint=" — format: $cur"
        while true; do
            if [[ "$kind" == manual ]]; then
                read -rp "  $key ($(rule_desc "$kind" "$len")$hint), Enter to skip: " val
                [[ -n "$val" ]] || { warn "$key left unset"; break; }
            else
                read -rsp "  $key ($(rule_desc "$kind" "$len")), Enter to generate: " val; echo
                [[ -n "$val" ]] || val=$(rule_generate "$kind" "$len")
            fi
            if rule_valid "$kind" "$len" "$val"; then env_set "$env" "$key" "$val"; ok "$key set"; break; fi
            warn "needs $(rule_desc "$kind" "$len") — try again"
        done
    done
}

# before starting: refuse quietly-broken configs unless the user insists
confirm_env_complete() {
    local env="$1" left
    left=$(env_placeholders "$env" | awk '{print $1}' | tr '\n' ' ')
    [[ -n "$left" ]] || return 0
    warn "still unset in $env: $left"
    interactive || return 1
    local ans; read -rp "Start anyway? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

# ── compose inspection ────────────────────────────────────────────────────────

# fully resolved compose config (variables from .env substituted)
compose_cfg() { (cd "$1" && docker compose config 2>/dev/null) || true; }

compose_project() { awk '/^name:/ { print $2; exit }' <<< "$1"; }

# host paths of bind mounts in a resolved config
cfg_bind_sources() {
    awk '
        /^[[:space:]]*- type: bind[[:space:]]*$/ { b = 1; next }
        b && /^[[:space:]]*source:/ { sub(/^[[:space:]]*source:[[:space:]]*/, ""); gsub(/^"|"$/, ""); print; b = 0; next }
        /^[[:space:]]*- / { b = 0 }
    ' <<< "$1" | sort -u
}

# host ports published in a resolved config
cfg_published_ports() {
    awk '/^[[:space:]]*published:/ { gsub(/"/, "", $2); if ($2 ~ /^[0-9]+$/) print $2 }' <<< "$1" | sort -un
}

# uid:gid that service data should belong to: PUID/PGID or UID/GID from .env,
# else the person running labber
data_owner() {
    local env="$1/.env" user uid gid
    uid=$(env_get "$env" PUID); [[ -n "$uid" ]] || uid=$(env_get "$env" UID)
    gid=$(env_get "$env" PGID); [[ -n "$gid" ]] || gid=$(env_get "$env" GID)
    user="${SUDO_USER:-$(id -un)}"
    [[ "$uid" =~ ^[0-9]+$ ]] || uid=$(id -u "$user")
    [[ "$gid" =~ ^[0-9]+$ ]] || gid=$(id -g "$user")
    echo "$uid:$gid"
}

# create missing bind-mount folders owned by the service's user. Left to Docker,
# they'd be created as root and the container couldn't write to them.
# Existing paths are never touched; sources that look like files are only reported.
ensure_bind_dirs() {
    local dir="$1" cfg="$2" owner src top sudo_cmd=""
    owner=$(data_owner "$dir")
    (( EUID == 0 )) || sudo_cmd="sudo"
    while IFS= read -r src; do
        [[ -n "$src" && ! -e "$src" ]] || continue
        # device nodes, sockets and kernel paths (e.g. /dev/dri/renderD128 on a host
        # without a GPU) must never be created as folders
        case "$src" in
            /dev/*|/proc/*|/sys/*|/run/*|/var/run/*)
                warn "bind mount $src is missing on this host (not creating system paths)"
                continue ;;
        esac
        if [[ "$(basename "$src")" == *.* ]]; then
            warn "bind mount $src is missing (looks like a file — not creating it)"
            continue
        fi
        # topmost folder that doesn't exist yet, so new parents get the right owner too
        top="$src"
        while [[ ! -e "$(dirname "$top")" ]]; do top=$(dirname "$top"); done
        if mkdir -p "$src" 2>/dev/null || { [[ -n "$sudo_cmd" ]] && sudo mkdir -p "$src"; }; then
            if [[ "$owner" == "$(id -u):$(id -g)" && -O "$top" ]] || $sudo_cmd chown -R "$owner" "$top"; then
                ok "created $src (owner $owner)"
            else
                warn "created $src but could not set its owner to $owner"
            fi
        else
            warn "could not create $src"
        fi
    done < <(cfg_bind_sources "$cfg")
}

# who is already using a host port, ignoring this project's own containers.
# Prints "container <name>" or "a process on this host", or nothing if free.
port_user() {
    local port="$1" project="$2" line proj name ports
    # "|" not tab: read collapses whitespace separators, so a container without a
    # compose project (empty first field) would shift every field by one
    while IFS='|' read -r proj name ports; do
        [[ -n "$project" && "$proj" == "$project" ]] && continue
        if [[ "$ports" =~ :${port}-\> ]]; then echo "container $name"; return; fi
    done < <(docker ps --format '{{.Label "com.docker.compose.project"}}|{{.Names}}|{{.Ports}}' 2>/dev/null)
    command -v ss &>/dev/null || return 0
    # ports this project already publishes show up in ss too (docker-proxy) — skip those
    if docker ps --filter "label=com.docker.compose.project=$project" --format '{{.Ports}}' 2>/dev/null \
        | grep -qE ":${port}->"; then
        return
    fi
    if ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}$"; then
        echo "a process on this host"
    fi
}

# warn about published ports that are already taken; returns 1 if the user aborts
check_ports() {
    local cfg="$1" project port who conflicts=()
    project=$(compose_project "$cfg")
    while IFS= read -r port; do
        [[ -n "$port" ]] || continue
        who=$(port_user "$port" "$project")
        [[ -z "$who" ]] || conflicts+=("$port (in use by $who)")
    done < <(cfg_published_ports "$cfg")
    (( ${#conflicts[@]} == 0 )) && return 0
    warn "port conflict:"
    printf "    %s\n" "${conflicts[@]}" >&2
    warn "change the port in .env, or stop whatever is using it"
    interactive || return 1
    local ans; read -rp "Start anyway? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

# everything to check before (re)starting a service; returns 1 if the user aborts.
# --no-fill: the caller has just been through the .env prompts, don't repeat them
preflight() {
    local dir="$1" fill="${2:-}" cfg
    sync_env_keys "$dir"
    if [[ -f "$dir/.env" && "$fill" != --no-fill ]]; then fill_env_placeholders "$dir/.env"; fi
    [[ ! -f "$dir/.env" ]] || confirm_env_complete "$dir/.env" || return 1
    cfg=$(compose_cfg "$dir")
    [[ -n "$cfg" ]] || { warn "invalid compose config — see: cd $dir && docker compose config"; return 1; }
    check_ports "$cfg" || return 1
    ensure_bind_dirs "$dir" "$cfg"
}

# ── update checks ─────────────────────────────────────────────────────────────

UPDATES_FILE="$SERVICE_BASE/.labber-updates"

# does any pulled image of this service have a newer version in its registry?
# prints yes / no / unknown (unknown: no buildx, offline, or only local images)
image_update_status() {
    local dir="$1" img remote local_digests result="unknown"
    command -v docker &>/dev/null && docker buildx version &>/dev/null || { echo unknown; return; }
    while IFS= read -r img; do
        [[ -n "$img" ]] || continue
        local_digests=$(docker image inspect --format '{{join .RepoDigests " "}}' "$img" 2>/dev/null) || continue
        [[ -n "$local_digests" ]] || continue          # built locally, nothing to compare
        remote=$(docker buildx imagetools inspect "$img" 2>/dev/null | awk '/^Digest:/ { print $2; exit }') || true
        [[ -n "$remote" ]] || continue
        if [[ " $local_digests " == *"@$remote "* ]]; then
            [[ "$result" == yes ]] || result="no"
        else
            result="yes"
        fi
    done < <(cd "$dir" && docker compose config --images 2>/dev/null | sort -u)
    echo "$result"
}

# do the repo's files for this service differ from the installed copy?
config_update_status() {
    local src="$1" dest="$2" f
    [[ -d "$src" ]] || { echo unknown; return; }
    while IFS= read -r f; do
        cmp -s "$src/$f" "$dest/$f" || { echo yes; return; }
    done < <(cd "$src" && find . -type f | sed 's|^\./||')
    echo no
}

do_check_updates() {
    check_deps
    local svcs; mapfile -t svcs < <(list_installed)
    (( ${#svcs[@]} > 0 )) || { warn "no services installed under $SERVICE_BASE"; return; }

    info "fetching repo..."
    local tmpdir; tmpdir=$(clone_repo_dir services/)
    trap "rm -rf '$tmpdir'" EXIT

    local now; now=$(date +%s)
    local out="" s img cfg
    echo
    for s in "${svcs[@]}"; do
        printf "  %-30s " "$s"
        img=$(image_update_status "$(svc_dir "$s")")
        cfg=$(config_update_status "$tmpdir/services/$s" "$(svc_dir "$s")")
        out+="$s"$'\t'"$img"$'\t'"$cfg"$'\t'"$now"$'\n'
        update_label "$img" "$cfg"; echo
    done
    printf "%s" "$out" > "$UPDATES_FILE" 2>/dev/null || warn "could not write $UPDATES_FILE"
    echo
    info "apply with: labber <svc> update   (config + images)  or  labber <svc> rebuild   (images only)"
}

# after a rebuild/update the cached "update available" flags are stale: record
# the new state for this service (empty argument = keep the cached value)
mark_updated() {
    local svc="$1" img="$2" cfg="$3"
    [[ -f "$UPDATES_FILE" && -w "$UPDATES_FILE" ]] || return 0
    local tmp; tmp=$(mktemp)
    awk -F'\t' -v OFS='\t' -v s="$svc" -v i="$img" -v c="$cfg" '
        $1 == s { if (i != "") $2 = i; if (c != "") $3 = c }
        { print }
    ' "$UPDATES_FILE" > "$tmp"
    cat "$tmp" > "$UPDATES_FILE"
    rm -f "$tmp"
}

# coloured summary for an image/config update pair
update_label() {
    local img="$1" cfg="$2" parts=()
    [[ "$img" == yes ]] && parts+=("${Y}new image${N}")
    [[ "$cfg" == yes ]] && parts+=("${Y}repo config changed${N}")
    if (( ${#parts[@]} > 0 )); then
        echo -ne "${parts[0]}"; (( ${#parts[@]} < 2 )) || echo -ne ", ${parts[1]}"
    elif [[ "$img" == unknown && "$cfg" == unknown ]]; then
        echo -ne "update status unknown"
    else
        echo -ne "${G}up to date${N}"
    fi
}

# ── commands ──────────────────────────────────────────────────────────────────

do_install() {
    check_deps
    check_svc_writable

    info "fetching service list from repo..."
    local tmpdir; tmpdir=$(clone_repo_dir services/)
    trap "rm -rf '$tmpdir'" EXIT

    local avail; mapfile -t avail < <(
        find "$tmpdir/services" -maxdepth 3 -name "docker-compose.yml" -exec dirname {} \; \
            | sed "s|^$tmpdir/services/||" | sort
    )

    local svc="${1:-}"; [[ -n "$svc" ]] || svc=$(pick "Select service to install:" "${avail[@]}")
    valid_svc_name "$svc" || die "invalid service name '$svc'"
    local src="$tmpdir/services/$svc"
    [[ -d "$src" ]] || die "service '$svc' not found in repo"

    local dest; dest=$(svc_dir "$svc")
    local new_env=0 fresh=0

    if [[ -d "$dest" ]]; then
        warn "'$svc' already installed at $dest"
        local ans; read -rp "Reinstall? (overwrites config files, preserves .env) [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { info "aborted"; return; }
        copy_svc_files "$src" "$dest"
    else
        fresh=1
        mkdir -p "$dest"
        cp -r "$src/." "$dest/"
        if [[ -f "$dest/.env.example" && ! -f "$dest/.env" ]]; then
            cp "$dest/.env.example" "$dest/.env"
            new_env=1
        fi
    fi

    # show README if present
    if [[ -f "$dest/README.txt" ]]; then
        echo; echo -e "${W}--- README ---${N}"
        cat "$dest/README.txt"
        echo -e "${W}--------------${N}"; echo
    fi

    if (( new_env )); then
        info ".env created from .env.example"
        fill_env_placeholders "$dest/.env"
        warn "review the other settings (ports, paths, URLs) before starting:"
        warn "  ${W}nano $dest/.env${N}"
        if interactive; then read -rp "Press Enter when ready, or Ctrl+C to abort... "; fi
    fi

    if (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]]; then
        # fresh install: nothing but labber's files yet, so the whole folder is safe to
        # chown. Reinstall: only the repo files — a recursive chown would also hit
        # container data owned by other users and break it (e.g. postgres, mongo)
        if (( fresh )); then
            chown -R "$SUDO_USER:" "$dest"
        else
            give_back_files "$src" "$dest"
        fi
        ok "ownership of $dest set to $SUDO_USER"
    fi

    local pf_opt=""; if (( new_env )); then pf_opt="--no-fill"; fi
    preflight "$dest" $pf_opt || { info "not started — fix the above, then run: labber $svc start"; return; }
    info "pulling/building images and starting $svc..."
    compose_refresh "$dest"
    mark_updated "$svc" no no
    ok "$svc is running"
    (cd "$dest" && docker compose ps)
}

do_uninstall() {
    check_deps
    check_svc_writable
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")

    warn "uninstalling '$svc' from $dir"
    local ans; read -rp "Stop and remove containers + images? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { info "aborted"; return; }

    # list images first (needs the compose file), remove containers, then remove
    # images one by one: `down --rmi all` aborts the whole uninstall if another
    # service still uses one of the images (e.g. a shared mongo/redis)
    local images; mapfile -t images < <(cd "$dir" && docker compose config --images 2>/dev/null | sort -u)
    info "stopping '$svc' and removing containers..."
    (cd "$dir" && docker compose down --remove-orphans)
    ok "containers removed"
    local img
    for img in "${images[@]}"; do
        if docker image rm "$img" >/dev/null 2>&1; then
            ok "removed image $img"
        else
            warn "kept image $img (still used by another container, or not present)"
        fi
    done

    read -rp "Delete service directory $dir? (removes config, data, .env) [y/N] " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        # container data is often owned by other users (e.g. uid 999), which a
        # normal user can't delete — retry those with sudo
        if ! rm -rf "$dir" 2>/dev/null; then
            warn "some files belong to other users (container data) — removing with sudo"
            sudo rm -rf -- "$dir"
        fi
        ok "service directory deleted"
    else
        info "service directory kept at $dir"
    fi

    ok "'$svc' uninstalled"
}

do_start() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    preflight "$dir" || { info "aborted"; return; }
    info "starting $svc..."
    # up -d (not start): recreates containers if they were removed while stopped
    (cd "$dir" && docker compose up -d)
    ok "done"
}

do_stop() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    info "stopping $svc..."
    (cd "$dir" && docker compose stop)
    ok "done"
}

do_restart() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    info "restarting $svc..."
    (cd "$dir" && docker compose up -d --force-recreate)
    ok "done"
}

do_rebuild() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    preflight "$dir" || { info "aborted"; return; }
    info "rebuilding '$svc': pull/build → down → up → prune dangling images"
    compose_refresh "$dir"
    mark_updated "$svc" no ""
    ok "'$svc' rebuilt and running"
    (cd "$dir" && docker compose ps)
}

do_svc_upgrade() {
    check_deps
    check_svc_writable
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")

    info "fetching latest '$svc' from repo..."
    local tmpdir; tmpdir=$(clone_repo_dir services/)
    trap "rm -rf '$tmpdir'" EXIT

    local src="$tmpdir/services/$svc"
    [[ -d "$src" ]] || die "service '$svc' not found in repo"

    copy_svc_files "$src" "$dir"
    give_back_files "$src" "$dir"

    preflight "$dir" || { info "files updated but not restarted — run: labber $svc start"; return; }
    info "rebuilding '$svc': pull/build → down → up → prune dangling images"
    compose_refresh "$dir"
    mark_updated "$svc" no no
    ok "'$svc' updated and running"
    (cd "$dir" && docker compose ps)
}

do_shell() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    local ctrs; mapfile -t ctrs < <(cd "$dir" && docker compose ps --format '{{.Name}}' 2>/dev/null || true)
    (( ${#ctrs[@]} > 0 )) || die "no running containers for '$svc'"
    local ctr="${ctrs[0]}"
    (( ${#ctrs[@]} > 1 )) && ctr=$(pick "Select container:" "${ctrs[@]}")
    info "entering $ctr..."
    # pick the shell up front: falling back on bash's exit code would open a
    # second shell whenever the last command in the bash session failed
    if docker exec "$ctr" sh -c 'command -v bash' >/dev/null 2>&1; then
        docker exec -it "$ctr" bash
    else
        docker exec -it "$ctr" sh
    fi
}

do_logs() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    (cd "$dir" && docker compose logs -f)
}

do_status() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    (cd "$dir" && docker compose ps)
}

# `labber <svc>` with no command: show its status and what can be done with it
do_svc_info() {
    do_status "$1"
    echo
    echo -e "${W}commands:${N} labber $1 <install|uninstall|start|stop|restart|rebuild|update|shell|logs|status|go>"
}

do_go() {
    local svc; svc=$(resolve_svc "${1:-}")
    need_svc "$svc" >/dev/null
    local dir; dir=$(svc_dir "$svc")
    if [[ -t 1 ]]; then
        # stdout is a terminal — not captured by shell function, cd won't happen
        info "Directory: ${W}$dir${N}"
        warn "to actually cd there, run: labber $svc go   (requires self-install + source ~/.bashrc)"
    else
        # stdout captured by shell function — just print the path for cd
        echo "$dir"
    fi
}

# remove a labber-managed block from a .bashrc: from the line equal to $2 up to
# the first line matching regex $3. Blank lines directly before the block go too,
# so reinstalling doesn't pile up empty lines. The file is rewritten in place
# (not replaced) so it keeps its owner and permissions, even under sudo.
_strip_rc_block() {
    local rc="$1" start="$2" end_re="$3"
    grep -qxF "$start" "$rc" 2>/dev/null || return 0
    local tmp; tmp=$(mktemp)
    awk -v start="$start" -v end_re="$end_re" '
        skip         { if ($0 ~ end_re) skip = 0; next }
        $0 == start  { blank = 0; skip = 1; next }
        /^[ \t]*$/   { blank++; next }
                     { while (blank > 0) { print ""; blank-- } print }
        END          { while (blank > 0) { print ""; blank-- } }
    ' "$rc" > "$tmp"
    cat "$tmp" > "$rc"
    rm -f "$tmp"
}

# under sudo, a .bashrc that labber had to create would belong to root
_fix_rc_owner() {
    if (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]]; then chown "$SUDO_USER:" "$1" 2>/dev/null || true; fi
}

_install_shell_fn() {
    local rc; rc="$(target_home)/.bashrc"
    _strip_rc_block "$rc" "# labber shell function" '^}$'
    cat >> "$rc" <<'BASHRC'

# labber shell function
labber() {
  if [[ "$2" == go ]]; then
    cd "$(/usr/local/bin/labber "$1" go)"
  else
    /usr/local/bin/labber "$@"
  fi
}
BASHRC
    _fix_rc_owner "$rc"
    ok "shell function updated in $rc"
}

_install_completion_fn() {
    local rc; rc="$(target_home)/.bashrc"
    # remove the old block so we always install the latest version
    _strip_rc_block "$rc" "# labber completion" '^complete -F _labber_complete labber$'
    cat >> "$rc" <<'BASHRC'

# labber completion
_labber_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local arg1="${COMP_WORDS[1]}"
    local svc_cmds="install uninstall start stop restart rebuild update shell logs status go"
    local global_cmds="install deploy setup ls check-updates clean update tool help"
    local svcs; svcs=$(find /opt/homelab/services -maxdepth 3 -name docker-compose.yml \
        -exec dirname {} \; 2>/dev/null | sed 's|.*/services/||' | sort)
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$global_cmds $svcs" -- "$cur") )
    elif [[ $COMP_CWORD -eq 2 && ! " $global_cmds " =~ " $arg1 " ]]; then
        # labber <svc> <cmd>: complete with service commands
        COMPREPLY=( $(compgen -W "$svc_cmds" -- "$cur") )
    fi
}
complete -F _labber_complete labber
BASHRC
    _fix_rc_owner "$rc"
    ok "tab completion updated in $rc"
}

do_self_install() {
    command -v curl &>/dev/null || die "curl is required for self-install"
    if [[ -f "$LABBER_BIN" ]]; then
        local ans; read -rp "labber already installed at $LABBER_BIN. Overwrite? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { info "aborted"; return; }
    fi
    info "installing labber to $LABBER_BIN..."
    local tmp; tmp=$(mktemp /tmp/labber-install-XXXXXX)
    curl -fsSL "$LABBER_URL" -o "$tmp" || { rm -f "$tmp"; die "download failed: $LABBER_URL"; }
    place_bin "$tmp"
    ok "labber installed to $LABBER_BIN"
    _install_shell_fn
    local ans; read -rp "Enable tab completion? [Y/n] " ans
    [[ "$ans" =~ ^[Nn]$ ]] || _install_completion_fn
    warn "run 'source ~/.bashrc' or open a new terminal to activate"
}

do_update() {
    local sudo_cmd=""
    (( EUID == 0 )) || sudo_cmd="sudo"

    info "running system update..."
    $sudo_cmd apt update && $sudo_cmd apt upgrade -y
    ok "system updated"
    echo
    if [[ ! -f "$LABBER_BIN" ]]; then
        warn "labber not installed at $LABBER_BIN"
        local ans; read -rp "Install now? [Y/n] " ans
        [[ "$ans" =~ ^[Nn]$ ]] || do_self_install
        return
    fi
    info "checking for labber update..."
    if ! command -v curl &>/dev/null; then
        warn "curl not found — skipping labber self-update"
        return
    fi
    local tmp; tmp=$(mktemp /tmp/labber-update-XXXXXX)
    if ! curl -fsSL "$LABBER_URL" -o "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        warn "labber self-update failed (network issue?) — binary unchanged"
        return
    fi
    local remote_ver; remote_ver=$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)
    if [[ "$remote_ver" == "$VERSION" ]]; then
        ok "labber already on latest (v${VERSION})"
        rm -f "$tmp"
        return
    fi
    place_bin "$tmp"
    ok "labber updated: v${VERSION} → v${remote_ver}"
    echo
    info "checking shell integration..."
    _install_shell_fn
    # refresh completion only if it was enabled at install time
    if grep -qxF "# labber completion" "$(target_home)/.bashrc" 2>/dev/null; then _install_completion_fn; fi
    warn "run 'source ~/.bashrc' to apply any changes"
}

do_tool() {
    local tool="${1:-}"
    [[ -n "$tool" ]] || die "usage: labber tool <name>  |  labber tool ls"

    local tmpdir; tmpdir=$(clone_repo_dir tools/)
    trap "rm -rf '$tmpdir'" EXIT

    if [[ "$tool" == "ls" || "$tool" == "list" ]]; then
        local available
        mapfile -t available < <(find "$tmpdir/tools" -maxdepth 1 -name "*.sh" \
            -exec basename {} .sh \; | sort)
        (( ${#available[@]} > 0 )) || { warn "no tools found in repo"; return; }
        echo
        echo -e "${W}available tools:${N}"
        for t in "${available[@]}"; do printf "  %s\n" "$t"; done
        return
    fi

    local script="$tmpdir/tools/${tool}.sh"
    [[ -f "$script" ]] || die "tool '$tool' not found — run: labber tool ls"

    info "installing $tool..."
    bash "$script"
    ok "$tool installed"
}

do_clean() {
    check_deps
    warn "this will remove ALL unused containers, images, networks, and volumes"
    local ans; read -rp "Confirm [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { info "aborted"; return; }
    docker system prune -af --volumes
    ok "docker cleaned"
}

do_ls() {
    echo
    show_overview
}

# ── status overview ───────────────────────────────────────────────────────────

# one line per service: containers up, health problems, published ports, and
# update status from the last `labber check-updates`
#   ● jellyfin        1/1 up   :8096         up to date
#   ● librechat       3/4 up   :3080,:3003   1 unhealthy   new image
show_overview() {
    local svcs; mapfile -t svcs < <(list_installed)
    if (( ${#svcs[@]} == 0 )); then
        echo -e "  ${Y}no services installed${N}"
        return
    fi

    local s state health ports total up bad restarting port_list dot problems upd checked=""
    for s in "${svcs[@]}"; do
        total=0 up=0 bad=0 restarting=0 finished=0 port_list=""
        local code
        while IFS='|' read -r state health code ports; do
            [[ -n "$state" ]] || continue
            # one-shot containers (init/migration jobs) that finished cleanly aren't "down"
            if [[ "$state" == exited && "$code" == 0 ]]; then finished=$((finished + 1)); continue; fi
            total=$((total + 1))
            [[ "$state" == running ]] && up=$((up + 1))
            [[ "$state" == restarting ]] && restarting=$((restarting + 1))
            [[ "$health" == unhealthy ]] && bad=$((bad + 1))
            port_list+=" $(grep -oE '[0-9]+->' <<< "$ports" | tr -d '>-' | tr '\n' ' ' || true)"
        done < <(cd "$(svc_dir "$s")" && docker compose ps -a --format '{{.State}}|{{.Health}}|{{.ExitCode}}|{{.Ports}}' 2>/dev/null || true)

        port_list=$(tr ' ' '\n' <<< "$port_list" | grep -E '^[0-9]+$' | sort -un | sed 's/^/:/' | paste -sd, - || true)

        problems=""
        (( bad == 0 ))        || problems+="${R}${bad} unhealthy${N} "
        (( restarting == 0 )) || problems+="${R}${restarting} restarting${N} "

        # colour kept separate from the text so printf's column widths line up
        local col
        # a stopped service's containers often exit with code 0 too, so they count here
        if (( total + finished == 0 )); then col="$R"; state="not created"
        elif (( up == 0 ));  then col="$R"; state="stopped"
        elif (( up < total || bad > 0 || restarting > 0 )); then col="$Y"; state="${up}/${total} up"
        else col="$G"; state="${up}/${total} up"
        fi
        dot="${col}●${N}"

        upd=""
        if [[ -f "$UPDATES_FILE" ]]; then
            local line; line=$(awk -F'\t' -v s="$s" '$1 == s' "$UPDATES_FILE")
            if [[ -n "$line" ]]; then
                local img cfg ts
                IFS=$'\t' read -r _ img cfg ts <<< "$line"
                upd=$(update_label "$img" "$cfg")
                checked="$ts"
            fi
        fi

        printf "  %b %-28s %b%-12s%b %-18s %b%b\n" "$dot" "$s" "$col" "$state" "$N" "${port_list:--}" "$problems" "$upd"
    done

    echo
    if [[ -n "$checked" ]]; then
        local days=$(( ( $(date +%s) - checked ) / 86400 ))
        echo -e "  update info from $( (( days == 0 )) && echo today || echo "$days day(s) ago") — refresh: ${W}labber check-updates${N}"
    else
        echo -e "  check for updates: ${W}labber check-updates${N}"
    fi
}

# ── setup: prepare a fresh LXC or VM ──────────────────────────────────────────
# `labber setup` walks a checklist of steps for a new Debian/Ubuntu LXC or VM.
# Every step checks first, so re-running only does what's still missing.

LABBER_STATE_DIR="/var/lib/labber"
SETUP_SSH_CONF="/etc/ssh/sshd_config.d/10-labber.conf"
SETUP_JOURNAL_CONF="/etc/systemd/journald.conf.d/10-labber.conf"
SETUP_STEPS=(update packages admin hostname ssh unattended journal docker dockerlogs guestagent labber fzf nfs fail2ban network)
SETUP_VIRT=""          # lxc | vm
SETUP_USER=""          # who user-level steps are for: the admin user on a VM, else root
SETUP_HOST_CMDS=()     # commands to run on the Proxmox host (printed at the end)
SETUP_NOTES=()         # anything else the user needs to do
SETUP_NET_PENDING=0    # a static-IP change is waiting for confirmation
SETUP_NET_NEW=""       # the address it changes to

# small key=value store so re-runs remember choices (admin user, network choice)
state_get() {
    awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' \
        "$LABBER_STATE_DIR/setup.state" 2>/dev/null || true
}
state_set() {
    local f="$LABBER_STATE_DIR/setup.state"
    mkdir -p "$LABBER_STATE_DIR"; touch "$f"
    { grep -v "^$1=" "$f" || true; echo "$1=$2"; } > "$f.tmp"
    mv "$f.tmp" "$f"
}

detect_virt() {
    local v=""
    command -v systemd-detect-virt &>/dev/null && v=$(systemd-detect-virt 2>/dev/null || true)
    case "$v" in
        lxc|lxc-libvirt) echo lxc ;;
        kvm|qemu|vmware|microsoft|oracle|xen|bochs|parallels) echo vm ;;
        none) echo bare ;;
        *) if grep -qa 'container=lxc' /proc/1/environ 2>/dev/null; then echo lxc; else echo unknown; fi ;;
    esac
}

pkg_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }
apt_install() { DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$@"; }
user_home() { getent passwd "$1" | cut -d: -f6; }

# ask "question" [default] → prints the answer (prompt goes to stderr)
ask() {
    local ans
    read -rp "  $1${2:+ [$2]}: " ans
    echo "${ans:-${2:-}}"
}
# yesno "question" y|n → exit status
yesno() {
    local ans def="${2:-n}"
    read -rp "  $1 [$([[ $def == y ]] && echo Y/n || echo y/N)] " ans
    ans="${ans:-$def}"
    [[ "$ans" =~ ^[Yy] ]]
}

valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local o; for o in "${BASH_REMATCH[@]:1}"; do (( o <= 255 )) || return 1; done
}

net_iface() { ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i+1); exit } }'; }
net_gw()    { ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "via") { print $(i+1); exit } }'; }
net_cidr()  { ip -4 -o addr show dev "$1" scope global 2>/dev/null | awk '{ print $4; exit }'; }
net_dns()   { awk '/^nameserver/ { print $2 }' /etc/resolv.conf 2>/dev/null | paste -sd' ' - || true; }
primary_ip() { local c; c=$(net_cidr "$(net_iface)"); echo "${c%/*}"; }

# the admin user on this machine, if we know one
setup_admin_name() {
    local u; u=$(state_get admin)
    if [[ -n "$u" ]] && id "$u" &>/dev/null; then echo "$u"; return; fi
    if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]]; then echo "$SUDO_USER"; fi
}

# the account you SSH in as: the admin user on a VM (once it exists), else root
setup_login_user() {
    local a; a=$(setup_admin_name)
    if [[ "$SETUP_VIRT" == vm && -n "$a" ]]; then echo "$a"; else echo root; fi
}

has_ssh_key() {
    grep -qE '^(ssh-(ed25519|rsa)|ecdsa-sha2-|sk-)' "$(user_home "$1")/.ssh/authorized_keys" 2>/dev/null
}

add_ssh_key() {
    local user="$1" key="$2" home; home=$(user_home "$user")
    install -d -m 700 -o "$user" -g "$(id -gn "$user")" "$home/.ssh"
    touch "$home/.ssh/authorized_keys"
    grep -qxF "$key" "$home/.ssh/authorized_keys" || echo "$key" >> "$home/.ssh/authorized_keys"
    chmod 600 "$home/.ssh/authorized_keys"
    chown "$user:" "$home/.ssh/authorized_keys"
}

step_title() {
    case "$1" in
        update)     echo "system update (apt full-upgrade)" ;;
        packages)   echo "base packages" ;;
        admin)      echo "admin user with sudo" ;;
        hostname)   echo "hostname + timezone" ;;
        ssh)        echo "SSH: key-only logins" ;;
        unattended) echo "automatic security updates" ;;
        journal)    echo "limit systemd journal to 200 MB" ;;
        docker)     echo "Docker (official repo) + compose/buildx" ;;
        dockerlogs) echo "Docker log rotation (10 MB x 3)" ;;
        guestagent) echo "qemu-guest-agent" ;;
