st_network_status() {
    local iface c; iface=$(net_iface); c=$(net_cidr "$iface")
    local choice; choice=$(state_get network)
    if [[ -n "$choice" ]]; then echo "done: $choice"
    elif [[ -z "$iface" ]]; then echo "todo: no network detected"
    elif ip -4 addr show dev "$iface" 2>/dev/null | grep -q dynamic; then echo "todo: DHCP ${c:-}"
    else echo "done: static ${c:-}"; fi
}
st_network_run() {
    local iface cidr gw dns mac
    iface=$(net_iface); cidr=$(net_cidr "$iface"); gw=$(net_gw); dns=$(net_dns)
    mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null || true)
    [[ -n "$iface" && -n "$cidr" ]] || { warn "couldn't detect the network — skipped"; return 0; }

    echo
    echo -e "  current:  ${W}$cidr${N} on $iface   gateway $gw   DNS ${dns:--}   MAC $mac"
    echo "  1) UniFi DHCP reservation — recommended: nothing changes here, all IPs stay in UniFi"
    if [[ "$SETUP_VIRT" == lxc ]]; then
        echo "  2) static IP set by Proxmox (Proxmox owns an LXC's network config)"
    else
        echo "  2) static IP on this machine (rolls back unless you confirm from the new IP)"
    fi
    echo "  3) skip"
    local choice; choice=$(ask "choice" 1)
    case "$choice" in
        1)
            echo
            info "in UniFi: Client Devices → the device with MAC $mac → Settings → Fixed IP Address"
            info "set the IP you want (currently ${cidr%/*}); it applies at the next DHCP renewal or reboot"
            state_set network "UniFi reservation ($mac)"
            ;;
        2)
            local ip prefix new_gw new_dns
            while true; do
                ip=$(ask "new IP" "${cidr%/*}"); prefix=$(ask "prefix length" "${cidr#*/}")
                new_gw=$(ask "gateway" "$gw"); new_dns=$(ask "DNS servers (space-separated)" "$dns")
                local ok_all=1 d
                valid_ipv4 "$ip" && valid_ipv4 "$new_gw" && [[ "$prefix" =~ ^[0-9]+$ ]] && (( prefix >= 8 && prefix <= 32 )) || ok_all=0
                for d in $new_dns; do valid_ipv4 "$d" || ok_all=0; done
                (( ok_all )) && break
                warn "invalid address — try again"
            done
            if [[ "$SETUP_VIRT" == lxc ]]; then
                # rewrite only ip= and gw= in the existing net0 line, keeping bridge/MAC/firewall/VLAN tag
                SETUP_HOST_CMDS+=("pct set <CTID> --net0 \"\$(pct config <CTID> | sed -n 's/^net0: //p' | sed -E 's/,?gw=[^,]*//; s|ip=[^,]*|ip=$ip/$prefix|'),gw=$new_gw\"")
                [[ -z "$new_dns" || "$new_dns" == "$dns" ]] || SETUP_HOST_CMDS+=("pct set <CTID> --nameserver \"$new_dns\"")
                SETUP_HOST_CMDS+=("pct reboot <CTID>")
                state_set network "static $ip/$prefix (via Proxmox)"
            else
                setup_static_vm "$iface" "$ip" "$prefix" "$new_gw" "$new_dns" || return 1
            fi
            ;;
        *) info "network unchanged" ;;
    esac
}

# write a static config for a VM, apply it in the background (the SSH session will
# drop if the IP changes), and roll back after 2 minutes unless confirmed with
# `labber setup --confirm-ip`. Supports ifupdown (Debian) and netplan (Ubuntu).
setup_static_vm() {
    local iface="$1" ip="$2" prefix="$3" gw="$4" dns="$5"
    local st="$LABBER_STATE_DIR" bak="$LABBER_STATE_DIR/ip-backup"
    mkdir -p "$bak"; rm -f "$bak"/* "$st/ip-confirmed" "$st/ip-result"
    local apply="" restore=""

    if command -v netplan &>/dev/null && compgen -G "/etc/netplan/*.yaml" >/dev/null; then
        local np="/etc/netplan/90-labber-$iface.yaml" ns=""
        [[ -n "$dns" ]] && ns="      nameservers: { addresses: [$(echo "$dns" | sed 's/ /, /g')] }"
        cat > "$bak/netplan.new" <<EOF
# managed by labber setup — delete this file and run 'netplan apply' to undo
network:
  version: 2
  ethernets:
    $iface:
      dhcp4: false
      addresses: [$ip/$prefix]
      routes: [{ to: default, via: $gw }]
$ns
EOF
        apply="install -m 600 '$bak/netplan.new' '$np' && netplan apply"
        restore="rm -f '$np' && netplan apply"
    elif command -v ifup &>/dev/null; then
        local f="" c
        for c in /etc/network/interfaces /etc/network/interfaces.d/*; do
            [[ -f "$c" ]] && grep -qE "^[[:space:]]*iface[[:space:]]+$iface[[:space:]]+inet[[:space:]]" "$c" && { f="$c"; break; }
        done
        [[ -n "$f" ]] || { warn "no 'iface $iface inet' entry in /etc/network/interfaces* — use a UniFi reservation instead"; return 1; }
        cp -p "$f" "$bak/interfaces.orig"
        awk -v ifc="$iface" -v addr="$ip/$prefix" -v gw="$gw" '
            $1 == "iface" && $2 == ifc && $3 == "inet" {
                print "iface " ifc " inet static"; print "    address " addr; print "    gateway " gw
                inblk = 1; next
            }
            inblk && /^[[:space:]]/ { if ($1 ~ /^(address|netmask|gateway|broadcast|network)$/) next; print; next }
            { inblk = 0; print }
        ' "$f" > "$bak/interfaces.new"
        apply="cp '$bak/interfaces.new' '$f'"
        restore="cp '$bak/interfaces.orig' '$f'"
        # stop the DHCP client for this interface, then bring it up with the new config
        local cycle="(dhclient -r '$iface' 2>/dev/null; pkill -f 'dhclient.*$iface'; dhcpcd -k '$iface' 2>/dev/null; pkill -f 'dhcpcd.*$iface'; ip -4 addr flush dev '$iface'; ifdown --force '$iface' 2>/dev/null; ifup --force '$iface')"
        apply+=" && $cycle"
        restore+=" && $cycle"
        # resolv.conf: only when it's a plain file (not managed by systemd-resolved), and
        # only AFTER the cycle — releasing a dhcpcd lease rewrites resolv.conf and would
        # wipe the nameservers (found on Debian 13, which uses dhcpcd)
        if [[ -n "$dns" && -f /etc/resolv.conf && ! -L /etc/resolv.conf ]]; then
            cp -p /etc/resolv.conf "$bak/resolv.orig"
            { grep -E '^(search|domain|options)' /etc/resolv.conf || true; for c in $dns; do echo "nameserver $c"; done; } > "$bak/resolv.new"
            apply+=" && cp '$bak/resolv.new' /etc/resolv.conf"
            restore+=" && cp '$bak/resolv.orig' /etc/resolv.conf"
        fi
    else
        warn "unsupported network manager — use a UniFi reservation instead"
        return 1
    fi

    cat > "$st/ip-apply.sh" <<EOF
#!/bin/bash
# written by labber setup: apply a static IP, roll back unless confirmed within 2 minutes
sleep 5
$apply
for i in \$(seq 60); do
    if [[ -f '$st/ip-confirmed' ]]; then echo confirmed > '$st/ip-result'; rm -f '$st/ip-confirmed'; exit 0; fi
    sleep 2
done
$restore
echo "rolled back \$(date)" > '$st/ip-result'
EOF
    chmod 700 "$st/ip-apply.sh"
    setsid nohup bash "$st/ip-apply.sh" > "$st/ip-apply.log" 2>&1 < /dev/null &
    state_set network_pending "static $ip/$prefix"
    SETUP_NET_PENDING=1
    SETUP_NET_NEW="$ip"
}

# `labber setup --confirm-ip`, run from the new address
setup_confirm_ip() {
    (( EUID == 0 )) || die "run as root: sudo labber setup --confirm-ip"
    local pending; pending=$(state_get network_pending)
    [[ -n "$pending" ]] || die "no IP change is waiting for confirmation"
    touch "$LABBER_STATE_DIR/ip-confirmed"
    local i
    for i in $(seq 10); do
        if grep -qs confirmed "$LABBER_STATE_DIR/ip-result"; then
            state_set network "$pending"; state_set network_pending ""
            ok "IP change confirmed: $pending"
            return
        fi
        sleep 1
    done
    rm -f "$LABBER_STATE_DIR/ip-confirmed"
    warn "too late — the change was already rolled back ($(cat "$LABBER_STATE_DIR/ip-result" 2>/dev/null || echo unknown))"
}

do_setup() {
    if [[ "${1:-}" == --confirm-ip ]]; then setup_confirm_ip; return; fi
    interactive || die "setup is interactive — run it in a terminal"
    if (( EUID != 0 )); then
        # re-run under sudo when labber is a real file (not `bash <(curl …)`)
        if [[ -f "$0" && "$0" != /dev/* && "$0" != /proc/* ]]; then exec sudo bash "$0" setup; fi
        die "setup needs root — run it as root, or: sudo labber setup"
    fi
    [[ -d /etc/pve ]] && die "this is a Proxmox host — setup is for LXCs and VMs"
    command -v apt-get &>/dev/null || die "setup supports Debian/Ubuntu (apt) only"

    SETUP_VIRT=$(detect_virt)
    if [[ "$SETUP_VIRT" != lxc && "$SETUP_VIRT" != vm ]]; then
        warn "couldn't tell whether this is an LXC or a VM (detected: $SETUP_VIRT)"
        yesno "treat it as a VM?" y || die "aborted"
        SETUP_VIRT=vm
    fi
    SETUP_USER=$(setup_admin_name); [[ -n "$SETUP_USER" ]] || SETUP_USER=root

    # checklist: pre-select steps that still need doing (optional ones start off)
    local ids=() sel=() stat=() id s
    for id in "${SETUP_STEPS[@]}"; do
        step_applies "$id" || continue
        s=$("st_${id}_status")
        ids+=("$id"); stat+=("$s")
        if [[ "$s" == todo* ]] && ! step_optional "$id"; then sel+=(1); else sel+=(0); fi
    done

    local n i input
    while true; do
        echo -e "\n${W}labber setup${N} — $(hostname), ${SETUP_VIRT^^}, user: $SETUP_USER\n"
        for i in "${!ids[@]}"; do
            local mark="[ ]"; (( sel[i] )) && mark="[${G}x${N}]"
            local sc="$G"; [[ "${stat[$i]}" == todo* ]] && sc="$Y"
            printf "  %2d %b %-46s %b%s%b\n" "$((i+1))" "$mark" "$(step_title "${ids[$i]}")" "$sc" "${stat[$i]}" "$N"
        done
        echo
        read -rp "toggle by number (e.g. 3 5), a = all, n = none, Enter = run, q = quit: " input
        case "$input" in
            "") break ;;
            q|Q) info "nothing changed"; return ;;
            a|A) for i in "${!sel[@]}"; do sel[i]=1; done ;;
            n|N) for i in "${!sel[@]}"; do sel[i]=0; done ;;
            *) for n in $input; do
                   if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#ids[@]} )); then
                       sel[n-1]=$(( 1 - sel[n-1] ))
                   fi
               done ;;
        esac
    done

    local done_steps=() failed=()
    for i in "${!ids[@]}"; do
        (( sel[i] )) || continue
        id="${ids[$i]}"
        echo; info "$(step_title "$id")"
        # `if` keeps one failing step from aborting the whole setup
        if "st_${id}_run"; then done_steps+=("$id"); else failed+=("$id"); warn "$(step_title "$id") failed"; fi
    done

    echo; echo -e "${W}── setup summary ──${N}"
    (( ${#done_steps[@]} == 0 )) || ok "done: ${done_steps[*]}"
    (( ${#failed[@]} == 0 )) || warn "failed: ${failed[*]} — fix and run 'labber setup' again"
    if (( ${#SETUP_HOST_CMDS[@]} )); then
        echo; warn "run on the Proxmox host (replace <CTID>/<VMID> with this guest's ID):"
        printf "    %s\n" "${SETUP_HOST_CMDS[@]}"
    fi
    if (( ${#SETUP_NOTES[@]} )); then
        echo; for n in "${SETUP_NOTES[@]}"; do info "$n"; done
    fi
    if (( SETUP_NET_PENDING )); then
        echo
        warn "the new IP applies in 5 seconds — this session will probably disconnect"
        warn "within 2 minutes, connect to the NEW address and confirm, or it rolls back:"
        echo -e "    ${W}ssh $(setup_login_user)@$SETUP_NET_NEW${N}   then   ${W}sudo labber setup --confirm-ip${N}"
    fi
}

# ── interactive menu ──────────────────────────────────────────────────────────

show_menu() {
    echo -e "\n${W}${B}labber v${VERSION} — homelab service manager${N}\n"
    echo -e "${W}installed services:${N}"
    show_overview
    echo

    local cmds=(  deploy  uninstall  start  stop  restart  rebuild  shell  logs  status  ls  check-updates  go  clean  update  setup )
    local descs=(
        "deploy a service from repo"
        "stop and remove a service"
        "start service containers"
        "stop service containers"
        "recreate service containers"
        "pull/build new images, then recreate containers"
        "enter a running container shell"
        "follow service logs"
        "show container status"
        "list installed services and status"
        "check which services have updates"
        "go to service directory"
        "remove all unused containers, images, volumes"
        "system apt update + upgrade labber"
        "prepare this LXC/VM (users, SSH, Docker, network...)"
    )

    echo -e "${W}commands:${N}"
    for i in "${!cmds[@]}"; do
        printf "  %2d) %-12s %s\n" "$((i+1))" "${cmds[$i]}" "${descs[$i]}"
    done
    echo

    local n
    while true; do
        read -rp "choice [1-${#cmds[@]}] or q to quit: " n
        [[ "$n" == "q" || "$n" == "Q" ]] && exit 0
        [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#cmds[@]} )) && break
        warn "invalid choice"
    done
    local chosen="${cmds[$((n-1))]}"
    [[ "$chosen" == "deploy" ]] && { do_install ""; return; }
    "do_${chosen//-/_}" ""
}

# ── usage ─────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
${W}labber v${VERSION}${N} — homelab service manager

${W}Usage:${N}
  labber [svc] <command>

${W}Commands:${N}
  [svc] install     deploy a service from the repo (also: deploy)
  [svc] uninstall   stop and remove a service
  [svc] start       start containers (docker compose up -d)
  [svc] stop        docker compose stop
  [svc] restart     recreate containers (docker compose up -d --force-recreate)
  [svc] rebuild     pull/build new images, then recreate containers
  [svc] update      pull latest config from repo + rebuild (preserves .env)
  [svc] shell       enter a running container shell
  [svc] logs        follow docker compose logs
  [svc] status      show container status
  [svc] go          cd to service directory
  setup             prepare this fresh LXC/VM (interactive checklist; re-runnable)
  ls                list services: containers up, health, ports, updates
  check-updates     check images and repo config for updates (cron-able)
  clean             remove all unused containers, images, networks, and volumes
  tool <name>       install a tool from the tools/ directory in the repo
  tool ls           list available tools
  update            system apt update + upgrade + labber self-update
  install           install labber to /usr/local/bin + shell function
  <svc>             show a service's status and commands
  (no args)         interactive menu

${W}.env placeholders${N} (in .env.example — filled in on install/update/start):
  _changeme_           you provide it       _changeme_hex_N_   N random hex characters
  _changeme_min_N_     ≥ N characters       _changeme_b64_N_   base64 of N random bytes
  _changeme_md5_       = _changeme_hex_32_  _changeme_sha256_  = _changeme_hex_64_
  _changeme_uuid_      a random UUID        changeme, <...>    older style — you provide it

${W}Before every start${N} labber also checks for port conflicts and creates missing
bind-mount folders owned by PUID/PGID (or UID/GID) from .env, else by you.

${W}Weekly update check${N} (add with: crontab -e):
  0 6 * * 1  /usr/local/bin/labber check-updates >/dev/null 2>&1

${W}Note:${N}
  'labber <svc> go' requires the shell function installed by 'labber install'.
  After install, run: source ~/.bashrc

${W}Fresh LXC/VM${N} (as root — only curl needed):
  apt update && apt install -y curl
  bash <(curl -fsSL https://raw.githubusercontent.com/rahulsrma26/homelab/refs/heads/main/services/labber) setup

${W}Just install labber:${N}
  bash <(curl -fsSL https://raw.githubusercontent.com/rahulsrma26/homelab/refs/heads/main/services/labber) install
EOF
}

# ── main ──────────────────────────────────────────────────────────────────────

labber_main() {
    local SVC CMD _tmp
    SVC="${1:-}"; shift 2>/dev/null || true
    CMD="${1:-}"; shift 2>/dev/null || true

    # Global commands have no service prefix — detect when SVC slot holds a global cmd
    _GLOBAL_CMDS="install deploy setup ls check-updates clean update tool help -h --help"
    if [[ " $_GLOBAL_CMDS " =~ " $SVC " ]]; then
        _tmp="$CMD"; CMD="$SVC"; SVC="$_tmp"
    elif [[ -z "$CMD" ]]; then
        # `labber <svc>` alone → that service's status; otherwise treat it as a command
        if [[ -n "$SVC" && -f "$(svc_dir "$SVC")/docker-compose.yml" ]]; then
            CMD="info"
        else
            CMD="$SVC"; SVC=""
        fi
    fi

    case "$CMD" in
        install|deploy)
            # `labber install` installs labber itself; `labber <svc> install` deploys a
            # service; `labber deploy` picks a service to deploy
            if [[ -n "$SVC" || "$CMD" == deploy ]]; then do_install "$SVC"; else do_self_install; fi
            ;;
        info)      do_svc_info  "$SVC" ;;
        uninstall) do_uninstall "$SVC" ;;
        start)     do_start     "$SVC" ;;
        stop)      do_stop      "$SVC" ;;
        restart)   do_restart   "$SVC" ;;
        rebuild)   do_rebuild   "$SVC" ;;
        shell)     do_shell     "$SVC" ;;
        logs)      do_logs      "$SVC" ;;
        status)    do_status    "$SVC" ;;
        ls)        do_ls ;;
        check-updates) do_check_updates ;;
        setup)     do_setup     "$SVC" ;;
        go)        do_go        "$SVC" ;;
        clean)     do_clean ;;
        tool)      do_tool      "$SVC" ;;
        update)
            if [[ -n "$SVC" ]]; then do_svc_upgrade "$SVC"; else do_update; fi
            ;;
        help|-h|--help) usage ;;
        "")        show_menu ;;
        *) die "unknown command '$CMD' — run: labber help" ;;
    esac
}

# run only when executed (including `bash <(curl …)`), not when sourced by the tests
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    labber_main "$@"
fi
