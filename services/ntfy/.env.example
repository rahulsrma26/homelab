# The address you open ntfy at (https://…); also used in the links it sends
NTFY_BASE_URL=https://{{ ntfy_host }}
PORT={{ ntfy_port | default(8091) }}
PUID={{ puid | default(1000) }}
PGID={{ pgid | default(1000) }}
TZ={{ tz | default(Etc/UTC) }}
# Your web login: user admin
NTFY_ADMIN_PASSWORD={{ ntfy_admin_password | generate([A-Za-z0-9],24) }}
# Send-only token (Alertmanager and other publishers) and read-only token (readers), every topic
NTFY_PUBLISH_TOKEN=tk_{{ ntfy_publish_token | generate([a-z0-9],29) }}
NTFY_READ_TOKEN=tk_{{ ntfy_read_token | generate([a-z0-9],29) }}
# How long messages are kept (e.g. 168h = a week)
NTFY_KEEP={{ ntfy_keep | default(168h) }}
