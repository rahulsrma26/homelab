#!/usr/bin/env bash
# labber — homelab service manager
set -euo pipefail

VERSION="4.0.0"
# The LABBER_* environment variables are for tests only: they point labber at a
# local copy of the repo and a separate services folder. Leave them unset normally.
REPO="${LABBER_REPO:-https://github.com/rahulsrma26/homelab.git}"
# labber is this script plus the config files it installs (files/), downloaded together
# as the repo's tarball (a consistent snapshot, ~100 KB; needs only curl and tar)
LABBER_URL="${LABBER_URL:-https://codeload.github.com/rahulsrma26/homelab/tar.gz/refs/heads/main}"
LABBER_LIB="/usr/local/lib/labber"         # installed copy: labber + files/
LABBER_BIN="/usr/local/bin/labber"         # a link to $LABBER_LIB/labber
SERVICE_BASE="${LABBER_SERVICE_BASE:-/opt/homelab/services}"
# this labber's own files/ — next to the script (installed, or a repo checkout). Run
# as `bash <(curl …)` or `curl … | bash` there are none: setup downloads them
# (labber_need_files)
LABBER_FILES=""
_self=$(readlink -f "${BASH_SOURCE[0]:-}" 2>/dev/null || true)
if [[ -n "${BASH_SOURCE[0]:-}" && -f "$_self" ]]; then LABBER_FILES="$(dirname "$_self")/files"; fi
unset _self

# ── colours ───────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    R=$'\033[0;31m' G=$'\033[0;32m' Y=$'\033[1;33m'
    B=$'\033[0;34m' C=$'\033[0;36m' W=$'\033[1m' N=$'\033[0m'
else
    R='' G='' Y='' B='' C='' W='' N=''
fi

die()  { echo -e "${R}error: $*${N}" >&2; exit 1; }
info() { echo -e "${C}:: $*${N}"; }
ok()   { echo -e "${G}✓ $*${N}"; }
warn() { echo -e "${Y}! $*${N}"; }

# ── helpers ───────────────────────────────────────────────────────────────────

check_deps() {
    local miss=()
    for cmd in docker git; do command -v "$cmd" &>/dev/null || miss+=("$cmd"); done
    (( ${#miss[@]} == 0 )) || die "missing: ${miss[*]}"
}

check_svc_writable() {
    if (( EUID == 0 )); then
        warn "running as root — service files will be owned by root"
        if [[ -n "${SUDO_USER:-}" ]]; then
            warn "ownership will be fixed to ${SUDO_USER} after install"
        else
            warn "consider running as a regular user instead"
        fi
        mkdir -p "$SERVICE_BASE"
    elif [[ ! -d "$SERVICE_BASE" ]]; then
        # Directory doesn't exist — try to create it with sudo
        info "creating $SERVICE_BASE..."
        # (< /dev/null on sudo calls: Debian's sudo relays keyboard input to the command
        # through its own pty, which would swallow answers typed ahead for labber's prompts)
        sudo mkdir -p "$SERVICE_BASE" < /dev/null && sudo chown "$(whoami):$(whoami)" "$SERVICE_BASE" < /dev/null \
            || die "could not create $SERVICE_BASE — run: sudo mkdir -p $SERVICE_BASE && sudo chown $(whoami):$(whoami) $SERVICE_BASE"
    elif [[ ! -w "$SERVICE_BASE" ]]; then
        die "$SERVICE_BASE is not writable by $(whoami) — fix with: sudo chown -R $(whoami):$(whoami) $SERVICE_BASE"
    fi
}

svc_dir() { echo "$SERVICE_BASE/$1"; }

need_svc() {
    local dir; dir=$(svc_dir "$1")
    [[ -f "$dir/docker-compose.yml" ]] || die "'$1' not installed (no docker-compose.yml at $dir)"
    echo "$dir"
}

list_installed() {
    [[ -d "$SERVICE_BASE" ]] || return 0
    find "$SERVICE_BASE" -maxdepth 3 -name "docker-compose.yml" -exec dirname {} \; \
        | sed "s|^$SERVICE_BASE/||" | sort
}

pick() {
    local prompt="$1"; shift; local items=("$@")
    (( ${#items[@]} > 0 )) || die "nothing to pick from"
    echo -e "\n${W}${prompt}${N}" >&2
    for i in "${!items[@]}"; do printf "  %2d) %s\n" "$((i+1))" "${items[$i]}" >&2; done
    echo >&2
    local n
    while true; do
        read -rp "choice [1-${#items[@]}]: " n
        [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#items[@]} )) && break
        echo -e "${Y}! invalid choice${N}" >&2
    done
    echo "${items[$((n-1))]}"
}

# service names are paths under $SERVICE_BASE: no "..", no leading slash or dot,
# so nothing built from them (cd, cp, rm -rf) can point outside it
valid_svc_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$ && "$1" != *..* ]]
}

# resolve service: use CLI arg if given, else interactive pick from installed
resolve_svc() {
    if [[ -n "${1:-}" ]]; then
        valid_svc_name "$1" || die "invalid service name '$1'"
        echo "$1"; return
    fi
    local svcs; mapfile -t svcs < <(list_installed)
    (( ${#svcs[@]} > 0 )) || die "no services installed under $SERVICE_BASE"
    pick "Select service:" "${svcs[@]}"
}

# sparse-clone one top-level repo directory into a fresh temp dir; prints the path.
# The caller sets the cleanup trap with the path expanded, e.g.
#   trap "rm -rf '$tmpdir'" EXIT
# (a trap that refers to a function-local variable runs after the function has
# returned, when the variable no longer exists, so it would delete nothing)
clone_repo_dir() {
    local tmpdir; tmpdir=$(mktemp -d /tmp/homelab-deploy-XXXXXX)
    # set -e doesn't apply inside $(...), so fail explicitly. stdin from /dev/null: git
    # must never eat answers typed ahead for labber's prompts; output is just progress
    if ! git clone --depth=1 --sparse --filter=blob:none -q "$REPO" "$tmpdir" < /dev/null >/dev/null 2>&1 \
        || ! git -C "$tmpdir" sparse-checkout set "$1" < /dev/null >/dev/null 2>&1; then
        rm -rf "$tmpdir"
        echo -e "${R}error: could not fetch $REPO${N}" >&2
        return 1
    fi
    echo "$tmpdir"
}

# copy a service's files from the repo over the installed copy, keeping .env.
# The backup sits next to .env (same owner and permissions) rather than in /tmp,
# and is left behind if anything fails, so the .env is never lost.
copy_svc_files() {
    local src="$1" dest="$2"
    [[ -f "$dest/.env" ]] && cp -p "$dest/.env" "$dest/.env.labber-bak"
    cp -r "$src/." "$dest/"
    if [[ -f "$dest/.env.labber-bak" ]]; then mv -f "$dest/.env.labber-bak" "$dest/.env"; fi
}

# under sudo, files labber copies end up owned by root: hand them back to the
# person who ran sudo. Only the files that came from the repo — never service
# data, which may deliberately belong to another user (postgres runs as 999).
give_back_files() {
    local src="$1" dest="$2" f
    (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]] || return 0
    while IFS= read -r f; do
        chown -h "$SUDO_USER:" "$dest/$f" 2>/dev/null || true
    done < <(cd "$src" && find . -mindepth 1 | sed 's|^\./||')
    chown "$SUDO_USER:" "$dest" 2>/dev/null || true
}

# fetch new images (and rebuild locally built ones) while the old containers keep
# running, then swap them over. If a pull or build fails the service stays up.
#   - pull --ignore-buildable: images built from a local Dockerfile can't be pulled
#   - build --pull: rebuild local images on a fresh base image
#   - image prune: only dangling images — never touches other services' containers
compose_refresh() {
    local dir="$1"
    # older compose releases don't know --ignore-buildable; fall back to not
    # failing on images that can only be built
    if docker compose pull --help 2>/dev/null | grep -q -- '--ignore-buildable'; then
        (cd "$dir" && docker compose pull --ignore-buildable)
    else
        (cd "$dir" && docker compose pull --ignore-pull-failures)
    fi
    # only build when something is built locally (avoids a "No services to build" warning)
    if grep -qE '^[[:space:]]+build:' "$dir/docker-compose.yml"; then
        (cd "$dir" && docker compose build --pull)
    fi
    (cd "$dir" && docker compose down --remove-orphans)
    (cd "$dir" && docker compose up -d)
    docker image prune -f >/dev/null
}

# home directory of the person running labber (their own home, even under sudo)
target_home() {
    if [[ -n "${SUDO_USER:-}" ]]; then getent passwd "$SUDO_USER" | cut -d: -f6; else echo "$HOME"; fi
}

# download labber (script + files/) from $LABBER_URL and unpack it into the empty
# dir $1; prints the path of the unpacked labber folder
labber_download() {
    local into="$1" script
    curl -fsSL "$LABBER_URL" 2>/dev/null | tar -xzf - -C "$into" 2>/dev/null || return 1
    script=$(find "$into" -mindepth 3 -maxdepth 3 -type f -path '*/labber/labber' -print -quit)
    [[ -n "$script" && -d "$(dirname "$script")/files" ]] || return 1
    dirname "$script"
}

# version of the labber script in folder $1
labber_version_of() { grep -m1 '^VERSION=' "$1/labber" | cut -d'"' -f2; }

# install the labber folder $1 (script + files/) as $LABBER_LIB, linked from
# $LABBER_BIN. The old folder is moved aside, not overwritten: a running labber keeps
# reading its (now deleted) script. The link replaces whatever was at $LABBER_BIN —
# before 4.0 that was the script itself.
labber_place() {
    local src="$1" s=""
    (( EUID == 0 )) || s="sudo"
    $s rm -rf "$LABBER_LIB.new" "$LABBER_LIB.old" < /dev/null
    $s mkdir -p "$LABBER_LIB.new" < /dev/null
    $s cp -R "$src/." "$LABBER_LIB.new/" < /dev/null
    $s chown -R root:root "$LABBER_LIB.new" < /dev/null
    $s chmod -R u=rwX,go=rX "$LABBER_LIB.new" < /dev/null
    $s chmod 755 "$LABBER_LIB.new/labber" < /dev/null
    if [[ -e "$LABBER_LIB" ]]; then $s mv "$LABBER_LIB" "$LABBER_LIB.old" < /dev/null; fi
    $s mv "$LABBER_LIB.new" "$LABBER_LIB" < /dev/null
    $s ln -sfn "$LABBER_LIB/labber" "$LABBER_BIN.new" < /dev/null
    $s mv -f "$LABBER_BIN.new" "$LABBER_BIN" < /dev/null
    $s rm -rf "$LABBER_LIB.old" < /dev/null
}

# setup run as `bash <(curl …)` has no files/ next to it: download them for this run
labber_need_files() {
    [[ -n "$LABBER_FILES" && -d "$LABBER_FILES" ]] && return 0
    local tmp dir; tmp=$(mktemp -d /tmp/labber-files-XXXXXX)
    trap "rm -rf '$tmp'" EXIT
    dir=$(labber_download "$tmp") || die "could not download labber's files from $LABBER_URL"
    LABBER_FILES="$dir/files"
}

# print labber file $1 (a path under files/) with each @NAME@ replaced:
#   labber_file alloy/base.alloy VIRT=vm LOKI=http://…
# Values go in literally (no regex or & handling), so they can hold any character.
labber_file() {
    local f="$LABBER_FILES/$1" content kv; shift
    [[ -f "$f" ]] || { echo -e "${R}error: labber file missing: $f${N}" >&2; return 1; }
    content=$(< "$f")
    for kv in "$@"; do content="${content//"@${kv%%=*}@"/"${kv#*=}"}"; done
    printf '%s\n' "$content"
}

# ── .env templates ────────────────────────────────────────────────────────────
# Values in .env.example can contain Jinja-like placeholders, filled in on
# install/update/start (anywhere inside a value, e.g. http://{{ host }}:{{ port | default(80) }}):
#   {{ name }}                            you provide it (required)
#   {{ name | default(8000) }}            asked; Enter keeps the default (default() = empty)
#   {{ name | generate(hex64) }}          a secret, typed hidden; Enter generates it
#       hexN            N random hex characters (typed value: exactly N hex chars)
#       base64_N        N random bytes, base64-encoded
#       uuid            a random UUID
#       [set],N         N random characters from a tr-style set, e.g. [A-Za-z0-9],16
#                       (typed value: at least N characters)
# A name used several times in one .env is asked once and filled in everywhere.

TPL_RE='\{\{[[:space:]]*([a-z_][a-z0-9_]*)[[:space:]]*(\|[[:space:]]*(default|generate)\(([^}]*)\)[[:space:]]*)?\}\}'

# N random characters from a tr character set, e.g. rand_chars 32 'A-Za-z0-9'
rand_chars() {
    local out=""
    while (( ${#out} < $1 )); do
        out+=$(head -c 4096 /dev/urandom | LC_ALL=C tr -dc "$2")
    done
    echo "${out:0:$1}"
}

rand_uuid() {
    if [[ -r /proc/sys/kernel/random/uuid ]]; then cat /proc/sys/kernel/random/uuid
    else uuidgen | tr 'A-Z' 'a-z'; fi
}

# every placeholder in a string, one per line: "name<TAB>function<TAB>argument"
tpl_list() {
    local rest="$1"
    while [[ "$rest" =~ $TPL_RE ]]; do
        printf '%s\t%s\t%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
        rest="${rest#*"${BASH_REMATCH[0]}"}"
    done
}

# $1 with every placeholder named $2 replaced by $3 (others left as they are)
tpl_fill() {
    local s="$1" name="$2" val="$3" out="" m n
    while [[ "$s" =~ $TPL_RE ]]; do
        m="${BASH_REMATCH[0]}"; n="${BASH_REMATCH[1]}"
        out+="${s%%"$m"*}"
        if [[ "$n" == "$name" ]]; then out+="$val"; else out+="$m"; fi
        s="${s#*"$m"}"
    done
    printf '%s' "$out$s"
}

# generate(...) specs: is it one we know?
gen_known() { [[ "$1" =~ ^(hex[0-9]+|base64_[0-9]+|uuid|\[.+\],[0-9]+)$ ]]; }

gen_desc() {
    case "$1" in
        hex*)     echo "${1#hex} hex characters" ;;
        base64_*) echo "base64 of ${1#base64_} random bytes" ;;
        uuid)     echo "a UUID" ;;
        *)        echo "at least ${1##*,} characters" ;;
    esac
}

gen_value() {
    case "$1" in
        hex*)     rand_chars "${1#hex}" 'a-f0-9' ;;
        base64_*) head -c "${1#base64_}" /dev/urandom | base64 | tr -d '\n' ;;
        uuid)     rand_uuid ;;
        *)        local set="${1%,*}"; set="${set#[}"; set="${set%]}"
                  rand_chars "${1##*,}" "$set" ;;
    esac
}

# is a typed value acceptable for the generator?
gen_valid() {
    local spec="$1" v="$2"
    [[ -n "$v" ]] || return 1
    case "$spec" in
        hex*)     [[ "$v" =~ ^[0-9a-fA-F]+$ ]] && (( ${#v} == ${spec#hex} )) ;;
        uuid)     [[ "$v" =~ ^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$ ]] ;;
        base64_*) return 0 ;;
        *)        (( ${#v} >= ${spec##*,} )) ;;
    esac
}

# value of KEY in an env file, the way compose reads it: quotes removed, and for
# unquoted values a trailing " # comment" dropped. Tolerates Windows line endings.
env_get() {
    local file="$1" key="$2" line
    line=$(grep -E "^[[:space:]]*${key}=" "$file" 2>/dev/null | tail -1) || return 0
    line="${line%$'\r'}"
    line="${line#*=}"
    if [[ "$line" =~ ^\"([^\"]*)\" || "$line" =~ ^\'([^\']*)\' ]]; then
        line="${BASH_REMATCH[1]}"
    else
        [[ "$line" =~ ^(.*[^[:space:]])?[[:space:]]+#.*$ ]] && line="${BASH_REMATCH[1]}"
        line="${line%"${line##*[![:space:]]}"}"
    fi
    echo "$line"
}

# set KEY=value in an env file (rewritten in place, keeps owner/permissions).
# Values with spaces or special characters are single-quoted so compose takes them
# literally. A trailing " # comment" on the line is kept.
env_set() {
    local file="$1" key="$2" val="$3"
    if [[ ! "$val" =~ ^[A-Za-z0-9_./:@+=,-]*$ ]]; then
        if [[ "$val" != *"'"* ]]; then
            val="'$val'"
        else
            warn "$key contains both ' and special characters — check how it was written in $file"
        fi
    fi
    local tmp; tmp=$(mktemp)
    K="$key" V="$val" awk '
        !done && $0 ~ "^[[:space:]]*" ENVIRON["K"] "=" {
            sub(/\r$/, "")
            comment = ""
            if (match($0, /[ \t]+#.*$/)) comment = substr($0, RSTART)
            print ENVIRON["K"] "=" ENVIRON["V"] comment
            done = 1; next
        }
        { print }
    ' "$file" > "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
}

# prompts need a person at the keyboard (not cron, not a pipe)
interactive() { [[ -t 0 ]]; }

# keys in .env.example that .env doesn't have yet are appended (with their placeholder)
sync_env_keys() {
    local dir="$1" line key added=()
    [[ -f "$dir/.env.example" && -f "$dir/.env" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
        key="${BASH_REMATCH[1]}"
        grep -qE "^[[:space:]]*${key}=" "$dir/.env" && continue
        [[ -s "$dir/.env" && -n "$(tail -c1 "$dir/.env")" ]] && echo >> "$dir/.env"
        echo "$line" >> "$dir/.env"
        added+=("$key")
    done < "$dir/.env.example"
    (( ${#added[@]} == 0 )) || info "added new settings from .env.example: ${added[*]}"
}

# keys in .env whose value still contains a placeholder, one per line
env_placeholders() {
    local file="$1" line key
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
        key="${BASH_REMATCH[1]}"
        if [[ "$(env_get "$file" "$key")" =~ $TPL_RE ]]; then echo "$key"; fi
    done < "$file"
}

# ask for every placeholder in .env (each name once), then fill them in
fill_env_placeholders() {
    local env="$1" keys
    mapfile -t keys < <(env_placeholders "$env")
    (( ${#keys[@]} > 0 )) || return 0
    if ! interactive; then
        warn "$env has ${#keys[@]} unset value(s) — run labber interactively to fill them"
        return 0
    fi

    # each name once, in order of appearance (the first occurrence's function wins)
    local -A func arg value
    local order=() k name f a
    for k in "${keys[@]}"; do
        while IFS=$'\t' read -r name f a; do
            [[ -n "${func[$name]+set}" ]] && continue
            func[$name]="${f:-required}"; arg[$name]="$a"; order+=("$name")
        done < <(tpl_list "$(env_get "$env" "$k")")
    done
    echo; info "${#order[@]} value(s) to fill in for $env"

    # secrets: offer to generate them all at once
    local gens=() n
    for n in "${order[@]}"; do [[ "${func[$n]}" == generate ]] && gens+=("$n"); done
    local autofill=n ans
    if (( ${#gens[@]} )); then
        read -rp "Generate ${gens[*]}? [Y/n] " ans
        [[ "$ans" =~ ^[Nn]$ ]] || autofill=y
    fi

    local v
    for n in "${order[@]}"; do
        case "${func[$n]}" in
            generate)
                if ! gen_known "${arg[$n]}"; then warn "$n: unknown generator '${arg[$n]}' — left unset"; continue; fi
                if [[ "$autofill" == y ]]; then
                    value[$n]=$(gen_value "${arg[$n]}"); ok "$n generated ($(gen_desc "${arg[$n]}"))"; continue
                fi
                while true; do
                    read -rsp "  $n ($(gen_desc "${arg[$n]}")), Enter to generate: " v; echo
                    [[ -n "$v" ]] || v=$(gen_value "${arg[$n]}")
                    gen_valid "${arg[$n]}" "$v" && break
                    warn "needs $(gen_desc "${arg[$n]}") — try again"
                done
                value[$n]="$v"; ok "$n set" ;;
            default)
                read -rp "  $n [${arg[$n]}]: " v
                value[$n]="${v:-${arg[$n]}}" ;;
            *)
                read -rp "  $n (required), Enter to skip: " v
                if [[ -n "$v" ]]; then value[$n]="$v"; else warn "$n left unset"; fi ;;
        esac
    done

    # fill each key's value with the answers (unanswered placeholders stay)
    local val
    for k in "${keys[@]}"; do
        val=$(env_get "$env" "$k")
        for n in "${!value[@]}"; do val=$(tpl_fill "$val" "$n" "${value[$n]}"); done
        env_set "$env" "$k" "$val"
    done
}

# before starting: refuse quietly-broken configs unless the user insists
confirm_env_complete() {
    local env="$1" left
    left=$(env_placeholders "$env" | tr '\n' ' ')
    [[ -n "$left" ]] || return 0
    warn "still unset in $env: $left"
    interactive || return 1
    local ans; read -rp "Start anyway? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

# ── compose inspection ────────────────────────────────────────────────────────

# fully resolved compose config (variables from .env substituted)
compose_cfg() { (cd "$1" && docker compose config 2>/dev/null) || true; }

compose_project() { awk '/^name:/ { print $2; exit }' <<< "$1"; }

# host paths of bind mounts in a resolved config
cfg_bind_sources() {
    awk '
        /^[[:space:]]*- type: bind[[:space:]]*$/ { b = 1; next }
        b && /^[[:space:]]*source:/ { sub(/^[[:space:]]*source:[[:space:]]*/, ""); gsub(/^"|"$/, ""); print; b = 0; next }
        /^[[:space:]]*- / { b = 0 }
    ' <<< "$1" | sort -u
}

# host ports published in a resolved config
cfg_published_ports() {
    awk '/^[[:space:]]*published:/ { gsub(/"/, "", $2); if ($2 ~ /^[0-9]+$/) print $2 }' <<< "$1" | sort -un
}

# uid:gid that service data should belong to: PUID/PGID or UID/GID from .env,
# else the person running labber
data_owner() {
    local env="$1/.env" user uid gid
    uid=$(env_get "$env" PUID); [[ -n "$uid" ]] || uid=$(env_get "$env" UID)
    gid=$(env_get "$env" PGID); [[ -n "$gid" ]] || gid=$(env_get "$env" GID)
    user="${SUDO_USER:-$(id -un)}"
    [[ "$uid" =~ ^[0-9]+$ ]] || uid=$(id -u "$user")
    [[ "$gid" =~ ^[0-9]+$ ]] || gid=$(id -g "$user")
    echo "$uid:$gid"
}

# create missing bind-mount folders owned by the service's user. Left to Docker,
# they'd be created as root and the container couldn't write to them.
# Existing paths are never touched; sources that look like files are only reported.
ensure_bind_dirs() {
    local dir="$1" cfg="$2" owner src top sudo_cmd=""
    owner=$(data_owner "$dir")
    (( EUID == 0 )) || sudo_cmd="sudo"
    while IFS= read -r src; do
        [[ -n "$src" && ! -e "$src" ]] || continue
        # device nodes, sockets and kernel paths (e.g. /dev/dri/renderD128 on a host
        # without a GPU) must never be created as folders
        case "$src" in
            /dev/*|/proc/*|/sys/*|/run/*|/var/run/*)
                warn "bind mount $src is missing on this host (not creating system paths)"
                continue ;;
        esac
        if [[ "$(basename "$src")" == *.* ]]; then
            warn "bind mount $src is missing (looks like a file — not creating it)"
            continue
        fi
        # topmost folder that doesn't exist yet, so new parents get the right owner too
        top="$src"
        while [[ ! -e "$(dirname "$top")" ]]; do top=$(dirname "$top"); done
        if mkdir -p "$src" 2>/dev/null || { [[ -n "$sudo_cmd" ]] && sudo mkdir -p "$src" < /dev/null; }; then
            if [[ "$owner" == "$(id -u):$(id -g)" && -O "$top" ]] || $sudo_cmd chown -R "$owner" "$top" < /dev/null; then
                ok "created $src (owner $owner)"
            else
                warn "created $src but could not set its owner to $owner"
            fi
        else
            warn "could not create $src"
        fi
    done < <(cfg_bind_sources "$cfg")
}

# who is already using a host port, ignoring this project's own containers.
# Prints "container <name>" or "a process on this host", or nothing if free.
port_user() {
    local port="$1" project="$2" line proj name ports
    # "|" not tab: read collapses whitespace separators, so a container without a
    # compose project (empty first field) would shift every field by one
    while IFS='|' read -r proj name ports; do
        [[ -n "$project" && "$proj" == "$project" ]] && continue
        if [[ "$ports" =~ :${port}-\> ]]; then echo "container $name"; return; fi
    done < <(docker ps --format '{{.Label "com.docker.compose.project"}}|{{.Names}}|{{.Ports}}' 2>/dev/null)
    command -v ss &>/dev/null || return 0
    # ports this project already publishes show up in ss too (docker-proxy) — skip those
    if docker ps --filter "label=com.docker.compose.project=$project" --format '{{.Ports}}' 2>/dev/null \
        | grep -qE ":${port}->"; then
        return
    fi
    if ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}$"; then
        echo "a process on this host"
    fi
}

# warn about published ports that are already taken; returns 1 if the user aborts
check_ports() {
    local cfg="$1" project port who conflicts=()
    project=$(compose_project "$cfg")
    while IFS= read -r port; do
        [[ -n "$port" ]] || continue
        who=$(port_user "$port" "$project")
        [[ -z "$who" ]] || conflicts+=("$port (in use by $who)")
    done < <(cfg_published_ports "$cfg")
    (( ${#conflicts[@]} == 0 )) && return 0
    warn "port conflict:"
    printf "    %s\n" "${conflicts[@]}" >&2
    warn "change the port in .env, or stop whatever is using it"
    interactive || return 1
    local ans; read -rp "Start anyway? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

# everything to check before (re)starting a service; returns 1 if the user aborts.
# --no-fill: the caller has just been through the .env prompts, don't repeat them
preflight() {
    local dir="$1" fill="${2:-}" cfg
    sync_env_keys "$dir"
    if [[ -f "$dir/.env" && "$fill" != --no-fill ]]; then fill_env_placeholders "$dir/.env"; fi
    [[ ! -f "$dir/.env" ]] || confirm_env_complete "$dir/.env" || return 1
    cfg=$(compose_cfg "$dir")
    [[ -n "$cfg" ]] || { warn "invalid compose config — see: cd $dir && docker compose config"; return 1; }
    check_ports "$cfg" || return 1
    ensure_bind_dirs "$dir" "$cfg"
}

# ── update checks ─────────────────────────────────────────────────────────────

UPDATES_FILE="$SERVICE_BASE/.labber-updates"

# does any pulled image of this service have a newer version in its registry?
# prints yes / no / unknown (unknown: no buildx, offline, or only local images)
image_update_status() {
    local dir="$1" img remote local_digests result="unknown"
    command -v docker &>/dev/null && docker buildx version &>/dev/null || { echo unknown; return; }
    while IFS= read -r img; do
        [[ -n "$img" ]] || continue
        local_digests=$(docker image inspect --format '{{join .RepoDigests " "}}' "$img" 2>/dev/null) || continue
        [[ -n "$local_digests" ]] || continue          # built locally, nothing to compare
        remote=$(docker buildx imagetools inspect "$img" 2>/dev/null | awk '/^Digest:/ { print $2; exit }') || true
        [[ -n "$remote" ]] || continue
        if [[ " $local_digests " == *"@$remote "* ]]; then
            [[ "$result" == yes ]] || result="no"
        else
            result="yes"
        fi
    done < <(cd "$dir" && docker compose config --images 2>/dev/null | sort -u)
    echo "$result"
}

# do the repo's files for this service differ from the installed copy?
config_update_status() {
    local src="$1" dest="$2" f
    [[ -d "$src" ]] || { echo unknown; return; }
    while IFS= read -r f; do
        cmp -s "$src/$f" "$dest/$f" || { echo yes; return; }
    done < <(cd "$src" && find . -type f | sed 's|^\./||')
    echo no
}

do_check_updates() {
    check_deps
    local svcs; mapfile -t svcs < <(list_installed)
    (( ${#svcs[@]} > 0 )) || { warn "no services installed under $SERVICE_BASE"; return; }

    info "fetching repo..."
    local tmpdir; tmpdir=$(clone_repo_dir services/)
    trap "rm -rf '$tmpdir'" EXIT

    local now; now=$(date +%s)
    local out="" s img cfg
    echo
    for s in "${svcs[@]}"; do
        printf "  %-30s " "$s"
        img=$(image_update_status "$(svc_dir "$s")")
        cfg=$(config_update_status "$tmpdir/services/$s" "$(svc_dir "$s")")
        out+="$s"$'\t'"$img"$'\t'"$cfg"$'\t'"$now"$'\n'
        update_label "$img" "$cfg"; echo
    done
    printf "%s" "$out" > "$UPDATES_FILE" 2>/dev/null || warn "could not write $UPDATES_FILE"
    echo
    info "apply with: labber <svc> update   (config + images)  or  labber <svc> rebuild   (images only)"
}

# after a rebuild/update the cached "update available" flags are stale: record
# the new state for this service (empty argument = keep the cached value)
mark_updated() {
    local svc="$1" img="$2" cfg="$3"
    [[ -f "$UPDATES_FILE" && -w "$UPDATES_FILE" ]] || return 0
    local tmp; tmp=$(mktemp)
    awk -F'\t' -v OFS='\t' -v s="$svc" -v i="$img" -v c="$cfg" '
        $1 == s { if (i != "") $2 = i; if (c != "") $3 = c }
        { print }
    ' "$UPDATES_FILE" > "$tmp"
    cat "$tmp" > "$UPDATES_FILE"
    rm -f "$tmp"
}

# coloured summary for an image/config update pair
update_label() {
    local img="$1" cfg="$2" parts=()
    [[ "$img" == yes ]] && parts+=("${Y}new image${N}")
    [[ "$cfg" == yes ]] && parts+=("${Y}repo config changed${N}")
    if (( ${#parts[@]} > 0 )); then
        echo -ne "${parts[0]}"; (( ${#parts[@]} < 2 )) || echo -ne ", ${parts[1]}"
    elif [[ "$img" == unknown && "$cfg" == unknown ]]; then
        echo -ne "update status unknown"
    else
        echo -ne "${G}up to date${N}"
    fi
}

# ── commands ──────────────────────────────────────────────────────────────────

do_install() {
    check_deps
    check_svc_writable

    info "fetching service list from repo..."
    local tmpdir; tmpdir=$(clone_repo_dir services/)
    trap "rm -rf '$tmpdir'" EXIT

    local avail; mapfile -t avail < <(
        find "$tmpdir/services" -maxdepth 3 -name "docker-compose.yml" -exec dirname {} \; \
            | sed "s|^$tmpdir/services/||" | sort
    )

    local svc="${1:-}"; [[ -n "$svc" ]] || svc=$(pick "Select service to install:" "${avail[@]}")
    valid_svc_name "$svc" || die "invalid service name '$svc'"
    local src="$tmpdir/services/$svc"
    [[ -d "$src" ]] || die "service '$svc' not found in repo"

    local dest; dest=$(svc_dir "$svc")
    local new_env=0 fresh=0

    if [[ -d "$dest" ]]; then
        warn "'$svc' already installed at $dest"
        local ans; read -rp "Reinstall? (overwrites config files, preserves .env) [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { info "aborted"; return; }
        copy_svc_files "$src" "$dest"
    else
        fresh=1
        mkdir -p "$dest"
        cp -r "$src/." "$dest/"
        if [[ -f "$dest/.env.example" && ! -f "$dest/.env" ]]; then
            cp "$dest/.env.example" "$dest/.env"
            new_env=1
        fi
    fi

    # show README if present
    if [[ -f "$dest/README.txt" ]]; then
        echo; echo -e "${W}--- README ---${N}"
        cat "$dest/README.txt"
        echo -e "${W}--------------${N}"; echo
    fi

    if (( new_env )); then
        info ".env created from .env.example"
        fill_env_placeholders "$dest/.env"
        warn "review the other settings (ports, paths, URLs) before starting:"
        warn "  ${W}nano $dest/.env${N}"
        if interactive; then read -rp "Press Enter when ready, or Ctrl+C to abort... "; fi
    fi

    if (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]]; then
        # fresh install: nothing but labber's files yet, so the whole folder is safe to
        # chown. Reinstall: only the repo files — a recursive chown would also hit
        # container data owned by other users and break it (e.g. postgres, mongo)
        if (( fresh )); then
            chown -R "$SUDO_USER:" "$dest"
        else
            give_back_files "$src" "$dest"
        fi
        ok "ownership of $dest set to $SUDO_USER"
    fi

    local pf_opt=""; if (( new_env )); then pf_opt="--no-fill"; fi
    preflight "$dest" $pf_opt || { info "not started — fix the above, then run: labber $svc start"; return; }
    info "pulling/building images and starting $svc..."
    compose_refresh "$dest"
    mark_updated "$svc" no no
    ok "$svc is running"
    (cd "$dest" && docker compose ps)
}

do_uninstall() {
    check_deps
    check_svc_writable
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")

    warn "uninstalling '$svc' from $dir"
    local ans; read -rp "Stop and remove containers + images? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { info "aborted"; return; }

    # list images first (needs the compose file), remove containers, then remove
    # images one by one: `down --rmi all` aborts the whole uninstall if another
    # service still uses one of the images (e.g. a shared mongo/redis)
    local images; mapfile -t images < <(cd "$dir" && docker compose config --images 2>/dev/null | sort -u)
    local project; project=$(compose_project "$(compose_cfg "$dir")")
    info "stopping '$svc' and removing containers..."
    (cd "$dir" && docker compose down --remove-orphans)
    ok "containers removed"
    local img
    for img in "${images[@]}"; do
        if docker image rm "$img" >/dev/null 2>&1; then
            ok "removed image $img"
        else
            warn "kept image $img (still used by another container, or not present)"
        fi
    done

    read -rp "Delete service directory $dir? (removes config, data, .env, and its Docker volumes) [y/N] " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        # named volumes hold data too (e.g. grafana-data) — compose leaves them behind
        if [[ -n "$project" ]]; then
            local vol
            while IFS= read -r vol; do
                [[ -n "$vol" ]] || continue
                if docker volume rm "$vol" >/dev/null 2>&1; then ok "removed volume $vol"; else warn "kept volume $vol (in use?)"; fi
            done < <(docker volume ls -q --filter "label=com.docker.compose.project=$project")
        fi
        # container data is often owned by other users (e.g. uid 999), which a
        # normal user can't delete — retry those with sudo
        if ! rm -rf "$dir" 2>/dev/null; then
            warn "some files belong to other users (container data) — removing with sudo"
            sudo rm -rf -- "$dir" < /dev/null
        fi
        ok "service directory deleted"
    else
        info "service directory kept at $dir"
    fi

    ok "'$svc' uninstalled"
}

do_start() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    preflight "$dir" || { info "aborted"; return; }
    info "starting $svc..."
    # up -d (not start): recreates containers if they were removed while stopped
    (cd "$dir" && docker compose up -d)
    ok "done"
}

do_stop() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    info "stopping $svc..."
    (cd "$dir" && docker compose stop)
    ok "done"
}

do_restart() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    info "restarting $svc..."
    (cd "$dir" && docker compose up -d --force-recreate)
    ok "done"
}

do_rebuild() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    preflight "$dir" || { info "aborted"; return; }
    info "rebuilding '$svc': pull/build → down → up → prune dangling images"
    compose_refresh "$dir"
    mark_updated "$svc" no ""
    ok "'$svc' rebuilt and running"
    (cd "$dir" && docker compose ps)
}

do_svc_upgrade() {
    check_deps
    check_svc_writable
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")

    info "fetching latest '$svc' from repo..."
    local tmpdir; tmpdir=$(clone_repo_dir services/)
    trap "rm -rf '$tmpdir'" EXIT

    local src="$tmpdir/services/$svc"
    [[ -d "$src" ]] || die "service '$svc' not found in repo"

    copy_svc_files "$src" "$dir"
    give_back_files "$src" "$dir"

    preflight "$dir" || { info "files updated but not restarted — run: labber $svc start"; return; }
    info "rebuilding '$svc': pull/build → down → up → prune dangling images"
    compose_refresh "$dir"
    mark_updated "$svc" no no
    ok "'$svc' updated and running"
    (cd "$dir" && docker compose ps)
}

do_shell() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    local ctrs; mapfile -t ctrs < <(cd "$dir" && docker compose ps --format '{{.Name}}' 2>/dev/null || true)
    (( ${#ctrs[@]} > 0 )) || die "no running containers for '$svc'"
    local ctr="${ctrs[0]}"
    (( ${#ctrs[@]} > 1 )) && ctr=$(pick "Select container:" "${ctrs[@]}")
    info "entering $ctr..."
    # pick the shell up front: falling back on bash's exit code would open a
    # second shell whenever the last command in the bash session failed
    if docker exec "$ctr" sh -c 'command -v bash' >/dev/null 2>&1; then
        docker exec -it "$ctr" bash
    else
        docker exec -it "$ctr" sh
    fi
}

do_logs() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    (cd "$dir" && docker compose logs -f)
}

do_status() {
    check_deps
    local svc; svc=$(resolve_svc "${1:-}")
    local dir; dir=$(need_svc "$svc")
    (cd "$dir" && docker compose ps)
}

# `labber <svc>` with no command: show its status and what can be done with it
do_svc_info() {
    do_status "$1"
    echo
    echo -e "${W}commands:${N} labber $1 <install|uninstall|start|stop|restart|rebuild|update|shell|logs|status|go>"
}

do_go() {
    local svc; svc=$(resolve_svc "${1:-}")
    need_svc "$svc" >/dev/null
    local dir; dir=$(svc_dir "$svc")
    if [[ -t 1 ]]; then
        # stdout is a terminal — not captured by shell function, cd won't happen
        info "Directory: ${W}$dir${N}"
        warn "to actually cd there, run: labber $svc go   (requires self-install + source ~/.bashrc)"
    else
        # stdout captured by shell function — just print the path for cd
        echo "$dir"
    fi
}

# remove a labber-managed block from a .bashrc: from the line equal to $2 up to
# the first line matching regex $3. Blank lines directly before the block go too,
# so reinstalling doesn't pile up empty lines. The file is rewritten in place
# (not replaced) so it keeps its owner and permissions, even under sudo.
_strip_rc_block() {
    local rc="$1" start="$2" end_re="$3"
    grep -qxF "$start" "$rc" 2>/dev/null || return 0
    local tmp; tmp=$(mktemp)
    awk -v start="$start" -v end_re="$end_re" '
        skip         { if ($0 ~ end_re) skip = 0; next }
        $0 == start  { blank = 0; skip = 1; next }
        /^[ \t]*$/   { blank++; next }
                     { while (blank > 0) { print ""; blank-- } print }
        END          { while (blank > 0) { print ""; blank-- } }
    ' "$rc" > "$tmp"
    cat "$tmp" > "$rc"
    rm -f "$tmp"
}

# under sudo, a .bashrc that labber had to create would belong to root
_fix_rc_owner() {
    if (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]]; then chown "$SUDO_USER:" "$1" 2>/dev/null || true; fi
}

# shell startup files labber keeps its blocks in: ~/.bashrc, plus ~/.zshrc if the
# user has one (zsh reuses the bash completion through bashcompinit)
_labber_rcs() {
    local h; h=$(target_home)
    echo "$h/.bashrc"
    if [[ -f "$h/.zshrc" ]]; then echo "$h/.zshrc"; fi
}

_install_shell_fn() {
    local rc
    while IFS= read -r rc; do
        _strip_rc_block "$rc" "# labber shell function" '^}$'
        cat >> "$rc" <<'BASHRC'

# labber shell function
labber() {
  if [[ "$2" == go ]]; then
    cd "$(/usr/local/bin/labber "$1" go)"
  else
    /usr/local/bin/labber "$@"
  fi
}
BASHRC
        _fix_rc_owner "$rc"
        ok "shell function updated in $rc"
    done < <(_labber_rcs)
}

_install_completion_fn() {
    local rc
    while IFS= read -r rc; do
        # remove the old block so we always install the latest version
        _strip_rc_block "$rc" "# labber completion" '^complete -F _labber_complete labber$'
        {
            echo; echo "# labber completion"
            [[ "$rc" == *.zshrc ]] && echo "autoload -U +X bashcompinit && bashcompinit"
            cat <<'BASHRC'
_labber_complete() {
    local cur arg1
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        # zsh's bashcompinit: COMP_CWORD counts from 0 but the array from 1
        cur="${COMP_WORDS[COMP_CWORD+1]}"; arg1="${COMP_WORDS[2]}"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"; arg1="${COMP_WORDS[1]}"
    fi
    local svc_cmds="install uninstall start stop restart rebuild update shell logs status go"
    local global_cmds="install deploy setup ls check-updates clean update tool help"
    local svcs; svcs=$(find /opt/homelab/services -maxdepth 3 -name docker-compose.yml \
        -exec dirname {} \; 2>/dev/null | sed 's|.*/services/||' | sort)
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$global_cmds $svcs" -- "$cur") )
    elif [[ $COMP_CWORD -eq 2 && ! " $global_cmds " =~ " $arg1 " ]]; then
        # labber <svc> <cmd>: complete with service commands
        COMPREPLY=( $(compgen -W "$svc_cmds" -- "$cur") )
    fi
}
complete -F _labber_complete labber
BASHRC
        } >> "$rc"
        _fix_rc_owner "$rc"
        ok "tab completion updated in $rc"
    done < <(_labber_rcs)
}

do_self_install() {
    command -v curl &>/dev/null || die "curl is required for self-install"
    if [[ -f "$LABBER_BIN" ]]; then
        local ans; read -rp "labber already installed at $LABBER_BIN. Overwrite? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { info "aborted"; return; }
    fi
    info "installing labber to $LABBER_LIB..."
    local tmp dir; tmp=$(mktemp -d /tmp/labber-install-XXXXXX)
    dir=$(labber_download "$tmp") || { rm -rf "$tmp"; die "download failed: $LABBER_URL"; }
    labber_place "$dir"; rm -rf "$tmp"
    ok "labber installed to $LABBER_LIB, linked from $LABBER_BIN"
    _install_shell_fn
    local ans; read -rp "Enable tab completion? [Y/n] " ans
    [[ "$ans" =~ ^[Nn]$ ]] || _install_completion_fn
    warn "run 'source ~/.bashrc' or open a new terminal to activate"
}

do_update() {
    local sudo_cmd=""
    (( EUID == 0 )) || sudo_cmd="sudo"

    info "running system update..."
    $sudo_cmd apt update < /dev/null && $sudo_cmd apt upgrade -y < /dev/null
    ok "system updated"
    echo
    if [[ ! -f "$LABBER_BIN" ]]; then
        warn "labber not installed at $LABBER_BIN"
        local ans; read -rp "Install now? [Y/n] " ans
        [[ "$ans" =~ ^[Nn]$ ]] || do_self_install
        return
    fi
    info "checking for labber update..."
    if ! command -v curl &>/dev/null; then
        warn "curl not found — skipping labber self-update"
        return
    fi
    local tmp dir; tmp=$(mktemp -d /tmp/labber-update-XXXXXX)
    if ! dir=$(labber_download "$tmp"); then
        rm -rf "$tmp"
        warn "labber self-update failed (network issue?) — labber unchanged"
        return
    fi
    local remote_ver; remote_ver=$(labber_version_of "$dir")
    # same version, and already installed as a folder (not a pre-4.0 single file)
    if [[ "$remote_ver" == "$VERSION" && -d "$LABBER_LIB/files" ]]; then
        ok "labber already on latest (v${VERSION})"
        rm -rf "$tmp"
        return
    fi
    labber_place "$dir"; rm -rf "$tmp"
    ok "labber updated: v${VERSION} → v${remote_ver}"
    echo
    info "checking shell integration..."
    _install_shell_fn
    # refresh completion only if it was enabled at install time
    if grep -qxF "# labber completion" "$(target_home)/.bashrc" 2>/dev/null; then _install_completion_fn; fi
    warn "run 'source ~/.bashrc' to apply any changes"
}

do_tool() {
    local tool="${1:-}"
    [[ -n "$tool" ]] || die "usage: labber tool <name>  |  labber tool ls"

    local tmpdir; tmpdir=$(clone_repo_dir tools/)
    trap "rm -rf '$tmpdir'" EXIT

    if [[ "$tool" == "ls" || "$tool" == "list" ]]; then
        local available
        mapfile -t available < <(find "$tmpdir/tools" -maxdepth 1 -name "*.sh" \
            -exec basename {} .sh \; | sort)
        (( ${#available[@]} > 0 )) || { warn "no tools found in repo"; return; }
        echo
        echo -e "${W}available tools:${N}"
        for t in "${available[@]}"; do printf "  %s\n" "$t"; done
        return
    fi

    local script="$tmpdir/tools/${tool}.sh"
    [[ -f "$script" ]] || die "tool '$tool' not found — run: labber tool ls"

    info "installing $tool..."
    bash "$script"
    ok "$tool installed"
}

do_clean() {
    check_deps
    warn "this will remove ALL unused containers, images, networks, and volumes"
    local ans; read -rp "Confirm [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { info "aborted"; return; }
    docker system prune -af --volumes
    ok "docker cleaned"
}

do_ls() {
    echo
    show_overview
}

# ── status overview ───────────────────────────────────────────────────────────

# one line per service: containers up, health problems, published ports, and
# update status from the last `labber check-updates`
#   ● jellyfin        1/1 up   :8096         up to date
#   ● librechat       3/4 up   :3080,:3003   1 unhealthy   new image
show_overview() {
    local svcs; mapfile -t svcs < <(list_installed)
    if (( ${#svcs[@]} == 0 )); then
        echo -e "  ${Y}no services installed${N}"
        return
    fi

    local s state health ports total up bad restarting port_list dot problems upd checked=""
    for s in "${svcs[@]}"; do
        total=0 up=0 bad=0 restarting=0 finished=0 port_list=""
        local code
        while IFS='|' read -r state health code ports; do
            [[ -n "$state" ]] || continue
            # one-shot containers (init/migration jobs) that finished cleanly aren't "down"
            if [[ "$state" == exited && "$code" == 0 ]]; then finished=$((finished + 1)); continue; fi
            total=$((total + 1))
            [[ "$state" == running ]] && up=$((up + 1))
            [[ "$state" == restarting ]] && restarting=$((restarting + 1))
            [[ "$health" == unhealthy ]] && bad=$((bad + 1))
            port_list+=" $(grep -oE '[0-9]+->' <<< "$ports" | tr -d '>-' | tr '\n' ' ' || true)"
        done < <(cd "$(svc_dir "$s")" && docker compose ps -a --format '{{.State}}|{{.Health}}|{{.ExitCode}}|{{.Ports}}' 2>/dev/null || true)

        port_list=$(tr ' ' '\n' <<< "$port_list" | grep -E '^[0-9]+$' | sort -un | sed 's/^/:/' | paste -sd, - || true)

        problems=""
        (( bad == 0 ))        || problems+="${R}${bad} unhealthy${N} "
        (( restarting == 0 )) || problems+="${R}${restarting} restarting${N} "

        # colour kept separate from the text so printf's column widths line up
        local col
        # a stopped service's containers often exit with code 0 too, so they count here
        if (( total + finished == 0 )); then col="$R"; state="not created"
        elif (( up == 0 ));  then col="$R"; state="stopped"
        elif (( up < total || bad > 0 || restarting > 0 )); then col="$Y"; state="${up}/${total} up"
        else col="$G"; state="${up}/${total} up"
        fi
        dot="${col}●${N}"

        upd=""
        if [[ -f "$UPDATES_FILE" ]]; then
            local line; line=$(awk -F'\t' -v s="$s" '$1 == s' "$UPDATES_FILE")
            if [[ -n "$line" ]]; then
                local img cfg ts
                IFS=$'\t' read -r _ img cfg ts <<< "$line"
                upd=$(update_label "$img" "$cfg")
                checked="$ts"
            fi
        fi

        printf "  %b %-28s %b%-12s%b %-18s %b%b\n" "$dot" "$s" "$col" "$state" "$N" "${port_list:--}" "$problems" "$upd"
    done

    echo
    if [[ -n "$checked" ]]; then
        local days=$(( ( $(date +%s) - checked ) / 86400 ))
        echo -e "  update info from $( (( days == 0 )) && echo today || echo "$days day(s) ago") — refresh: ${W}labber check-updates${N}"
    else
        echo -e "  check for updates: ${W}labber check-updates${N}"
    fi
}

# ── setup: prepare a fresh LXC or VM ──────────────────────────────────────────
# `labber setup` walks a checklist of steps for a new Debian/Ubuntu LXC or VM.
# Every step checks first, so re-running only does what's still missing.

LABBER_STATE_DIR="/var/lib/labber"
SETUP_SSH_CONF="/etc/ssh/sshd_config.d/10-labber.conf"
SETUP_JOURNAL_CONF="/etc/systemd/journald.conf.d/10-labber.conf"
SETUP_STEPS=(update packages locale admin hostname timesync ssh unattended journal swap docker dockerlogs guestagent healthcheck alloy zsh labber fzf nfs fail2ban network)
SETUP_VIRT=""          # lxc | vm
SETUP_USER=""          # who user-level steps are for: the admin user on a VM, else root
SETUP_HOST_CMDS=()     # commands to run on the Proxmox host (printed at the end)
SETUP_NOTES=()         # anything else the user needs to do
SETUP_NET_PENDING=0    # a static-IP change is waiting for confirmation
SETUP_NET_NEW=""       # the address it changes to
SETUP_DOCKER=1         # 0: not a Docker host — Docker steps are left out

# small key=value store so re-runs remember choices (admin user, network choice)
state_get() {
    awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' \
        "$LABBER_STATE_DIR/setup.state" 2>/dev/null || true
}
state_set() {
    local f="$LABBER_STATE_DIR/setup.state"
    mkdir -p "$LABBER_STATE_DIR"; touch "$f"
    { grep -v "^$1=" "$f" || true; echo "$1=$2"; } > "$f.tmp"
    mv "$f.tmp" "$f"
}

detect_virt() {
    local v=""
    command -v systemd-detect-virt &>/dev/null && v=$(systemd-detect-virt 2>/dev/null || true)
    case "$v" in
        lxc|lxc-libvirt) echo lxc ;;
        kvm|qemu|vmware|microsoft|oracle|xen|bochs|parallels) echo vm ;;
        none) echo bare ;;
        *) if grep -qa 'container=lxc' /proc/1/environ 2>/dev/null; then echo lxc; else echo unknown; fi ;;
    esac
}

pkg_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }
# package commands read from /dev/null: otherwise apt/dpkg (and their maintainer
# scripts) can swallow answers typed ahead for setup's own questions
apt_get() { DEBIAN_FRONTEND=noninteractive apt-get "$@" < /dev/null; }
apt_install() { apt_get install -y -q "$@"; }
user_home() { getent passwd "$1" | cut -d: -f6; }

# ask "question" [default] → prints the answer (prompt goes to stderr)
ask() {
    local ans
    read -rp "  $1${2:+ [$2]}: " ans
    echo "${ans:-${2:-}}"
}
# yesno "question" y|n → exit status
yesno() {
    local ans def="${2:-n}"
    read -rp "  $1 [$([[ $def == y ]] && echo Y/n || echo y/N)] " ans
    ans="${ans:-$def}"
    [[ "$ans" =~ ^[Yy] ]]
}

valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local o; for o in "${BASH_REMATCH[@]:1}"; do (( o <= 255 )) || return 1; done
}

net_iface() { ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i+1); exit } }'; }
net_gw()    { ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "via") { print $(i+1); exit } }'; }
net_cidr()  { ip -4 -o addr show dev "$1" scope global 2>/dev/null | awk '{ print $4; exit }'; }
net_dns()   { awk '/^nameserver/ { print $2 }' /etc/resolv.conf 2>/dev/null | paste -sd' ' - || true; }
primary_ip() { local c; c=$(net_cidr "$(net_iface)"); echo "${c%/*}"; }

# the admin user on this machine, if we know one
setup_admin_name() {
    local u; u=$(state_get admin)
    if [[ -n "$u" ]] && id "$u" &>/dev/null; then echo "$u"; return; fi
    if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]]; then echo "$SUDO_USER"; fi
}

# the account you SSH in as: the admin user on a VM (once it exists), else root
setup_login_user() {
    local a; a=$(setup_admin_name)
    if [[ "$SETUP_VIRT" == vm && -n "$a" ]]; then echo "$a"; else echo root; fi
}

has_ssh_key() {
    grep -qE '^(ssh-(ed25519|rsa)|ecdsa-sha2-|sk-)' "$(user_home "$1")/.ssh/authorized_keys" 2>/dev/null
}

add_ssh_key() {
    local user="$1" key="$2" home; home=$(user_home "$user")
    install -d -m 700 -o "$user" -g "$(id -gn "$user")" "$home/.ssh"
    touch "$home/.ssh/authorized_keys"
    grep -qxF "$key" "$home/.ssh/authorized_keys" || echo "$key" >> "$home/.ssh/authorized_keys"
    chmod 600 "$home/.ssh/authorized_keys"
    chown "$user:" "$home/.ssh/authorized_keys"
}

step_title() {
    case "$1" in
        update)     echo "system update (apt full-upgrade)" ;;
        packages)   echo "base packages" ;;
        admin)      echo "admin user with sudo" ;;
        locale)     echo "locale" ;;
        hostname)   echo "hostname + timezone" ;;
        timesync)   echo "time sync (NTP)" ;;
        swap)       echo "swap: zram and/or disk (asks)" ;;
        healthcheck) echo "reboot/update checks (login message + metric)" ;;
        alloy)      echo "Grafana Alloy: metrics + logs to monitoring" ;;
        zsh)        echo "zsh + powerlevel10k (admin user; root on an LXC)" ;;
        ssh)        echo "SSH: key-only logins" ;;
        unattended) echo "automatic security updates" ;;
        journal)    echo "limit systemd journal to 200 MB" ;;
        docker)     echo "Docker (official repo) + compose/buildx" ;;
        dockerlogs) echo "Docker log rotation (10 MB x 3)" ;;
        guestagent) echo "qemu-guest-agent" ;;
        labber)     echo "install labber (for the admin user on a VM)" ;;
        fzf)        echo "fzf (from repo tools/)" ;;
        nfs)        echo "NFS client (nfs-common)" ;;
        fail2ban)   echo "fail2ban for SSH" ;;
        network)    echo "network: fixed IP" ;;
    esac
}

step_applies() {
    case "$1" in
        admin|guestagent|timesync|swap) [[ "$SETUP_VIRT" == vm ]] ;;
        docker|dockerlogs) (( SETUP_DOCKER )) ;;
        nfs)              [[ "$SETUP_VIRT" != lxc ]] ;;
        *)                true ;;
    esac
}

# optional steps start unticked
step_optional() {
    case "$1" in
        nfs|fail2ban|swap) return 0 ;;
        *) return 1 ;;
    esac
}

# ── setup steps: st_<id>_status prints "done[: detail]" or "todo[: detail]" ───

st_update_status() { echo "todo"; }
st_update_run() {
    apt_get update -q || return 1
    apt_get -y -q \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade || return 1
    apt_get -y -q autoremove
}

# an Intel or AMD GPU that can do video decode (a passed-through iGPU). VMs also have
# /dev/dri/card0 for the virtual display (vendor 0x1234), which doesn't count.
has_media_gpu() {
    local v
    for v in /sys/class/drm/renderD*/device/vendor; do
        [[ -f "$v" ]] || continue
        case "$(cat "$v")" in 0x8086|0x1002) return 0 ;; esac
    done
    return 1
}

setup_pkg_list() {
    local p=(curl git sudo htop nano ca-certificates jq tmux rsync ncdu)
    [[ "$SETUP_VIRT" == lxc ]] || p+=(smartmontools lm-sensors iotop)
    has_media_gpu && p+=(vainfo)
    echo "${p[@]}"
}
st_packages_status() {
    local p missing=()
    for p in $(setup_pkg_list); do pkg_installed "$p" || missing+=("$p"); done
    if (( ${#missing[@]} )); then echo "todo: missing ${missing[*]}"; else echo "done"; fi
}
st_packages_run() {
    apt_get update -q || return 1
    # shellcheck disable=SC2046
    apt_install $(setup_pkg_list)
}

st_admin_status() {
    local a; a=$(setup_admin_name)
    if [[ -n "$a" ]] && id -nG "$a" | grep -qw sudo; then echo "done: $a"; else echo "todo"; fi
}
st_admin_run() {
    local name
    while true; do
        name=$(ask "admin username (you'll SSH in as this user)" "$(state_get admin)")
        [[ "$name" =~ ^[a-z_][a-z0-9_-]{0,31}$ && "$name" != root ]] && break
        warn "use lowercase letters, digits, - or _"
    done
    if ! id "$name" &>/dev/null; then
        info "creating $name — choose a password (it's used for sudo)"
        adduser --gecos "" "$name" || return 1
    fi
    usermod -aG sudo "$name" || return 1
    if getent group _ssh >/dev/null; then usermod -aG _ssh "$name"; fi
    # keys Proxmox (or you) put on root also let you in as the admin user
    if [[ -s /root/.ssh/authorized_keys ]]; then
        local key
        while IFS= read -r key; do
            [[ "$key" =~ ^(ssh-|ecdsa-|sk-) ]] && add_ssh_key "$name" "$key"
        done < /root/.ssh/authorized_keys
        ok "copied root's SSH keys to $name"
    fi
    state_set admin "$name"
    SETUP_USER="$name"
}

current_tz() {
    if [[ -f /etc/timezone ]]; then cat /etc/timezone
    else readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||' || true; fi
}
st_hostname_status() {
    local tz; tz=$(current_tz)
    if [[ -z "$tz" || "$tz" == *UTC* ]]; then echo "todo: timezone ${tz:-unset}"; else echo "done: $(hostname), $tz"; fi
}
st_hostname_run() {
    local cur_tz def_tz tz
    cur_tz=$(current_tz)
    def_tz="$cur_tz"; [[ -z "$def_tz" || "$def_tz" == *UTC* ]] && def_tz="Europe/London"
    tz=$(ask "timezone" "$def_tz")
    if [[ -f "/usr/share/zoneinfo/$tz" ]]; then
        ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
        echo "$tz" > /etc/timezone
        ok "timezone $tz"
    else
        warn "unknown timezone '$tz' — skipped (list: ls /usr/share/zoneinfo)"
    fi

    local cur new; cur=$(hostname)
    new=$(ask "hostname" "$cur")
    if [[ ! "$new" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]; then
        warn "invalid hostname '$new' — skipped"
    elif [[ "$new" != "$cur" ]]; then
        if [[ "$SETUP_VIRT" == lxc ]]; then
            # Proxmox rewrites an LXC's hostname and /etc/hosts at every start
            SETUP_HOST_CMDS+=("pct set <CTID> --hostname $new && pct reboot <CTID>")
            info "hostname is managed by Proxmox for LXCs — command added to the summary"
        else
            hostnamectl set-hostname "$new" 2>/dev/null || { echo "$new" > /etc/hostname; hostname "$new"; }
            if grep -q '^127\.0\.1\.1' /etc/hosts; then
                sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$new/" /etc/hosts
            else
                printf '127.0.1.1\t%s\n' "$new" >> /etc/hosts
            fi
            ok "hostname $new"
        fi
    fi
}

st_ssh_status() {
    local u; u=$(setup_login_user)
    if [[ -f "$SETUP_SSH_CONF" ]]; then echo "done"
    elif has_ssh_key "$u"; then echo "todo"
    else echo "todo: no SSH key for $u yet"; fi
}
st_ssh_run() {
    pkg_installed openssh-server || apt_install openssh-server || return 1
    if ! grep -qiE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf' /etc/ssh/sshd_config; then
        warn "/etc/ssh/sshd_config doesn't include sshd_config.d — skipped"
        return 0
    fi

    local user; user=$(setup_login_user)
    if ! has_ssh_key "$user"; then
        warn "no SSH key installed for $user — password logins stay on until there is one"
        local key; key=$(ask "paste your public key (ssh-ed25519 …), or Enter to skip")
        if [[ "$key" =~ ^(ssh-(ed25519|rsa)|ecdsa-sha2-[a-z0-9-]+|sk-[a-z0-9@.-]+)[[:space:]]+[A-Za-z0-9+/=]+ ]]; then
            add_ssh_key "$user" "$key"; ok "key added for $user"
        else
            [[ -z "$key" ]] || warn "that doesn't look like a public key"
            SETUP_NOTES+=("add your key from your Mac: ssh-copy-id $user@$(primary_ip) — then run 'labber setup' again for key-only SSH")
            return 0
        fi
    fi

    # root: key-only in an LXC; off in a VM once an admin with sudo can log in instead
    local root_policy="prohibit-password"
    if [[ "$SETUP_VIRT" == vm ]]; then
        if [[ "$user" != root ]] && id -nG "$user" | grep -qw sudo; then
            root_policy="no"
        else
            warn "no admin user with sudo yet — root keeps key-only login"
        fi
    fi

    mkdir -p "$(dirname "$SETUP_SSH_CONF")"
    cat > "$SETUP_SSH_CONF" <<EOF
# managed by labber setup — delete this file to undo
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin $root_policy
EOF
    if ! /usr/sbin/sshd -t 2>/dev/null; then
        rm -f "$SETUP_SSH_CONF"
        warn "sshd rejected the config — nothing changed"
        return 1
    fi
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || systemctl restart ssh
    echo
    info "keep this session open, and from a SECOND terminal on your Mac run:"
    echo -e "    ${W}ssh $user@$(primary_ip)${N}"
    if yesno "did that log in without asking for a password?" n; then
        ok "SSH is key-only (root: $root_policy)"
    else
        rm -f "$SETUP_SSH_CONF"
        systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
        warn "reverted — password logins are back on"
    fi
}

st_unattended_status() {
    if pkg_installed unattended-upgrades && grep -qs 'Unattended-Upgrade "1"' /etc/apt/apt.conf.d/20auto-upgrades
    then echo "done"; else echo "todo"; fi
}
st_unattended_run() {
    apt_install unattended-upgrades || return 1
    # the same file `dpkg-reconfigure -plow unattended-upgrades` writes
    printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' \
        > /etc/apt/apt.conf.d/20auto-upgrades
    ok "security updates install automatically (Debian's default: security only, no auto-reboot)"
}

st_journal_status() { if [[ -f "$SETUP_JOURNAL_CONF" ]]; then echo "done"; else echo "todo"; fi; }
st_journal_run() {
    mkdir -p "$(dirname "$SETUP_JOURNAL_CONF")"
    printf '# managed by labber setup\n[Journal]\nSystemMaxUse=200M\n' > "$SETUP_JOURNAL_CONF"
    systemctl restart systemd-journald
}

st_docker_status() {
    if command -v docker &>/dev/null && docker compose version &>/dev/null; then
        echo "done: $(docker --version | awk '{print $3}' | tr -d ,)"
    else
        echo "todo"
    fi
}
st_docker_run() {
    # read os-release in a subshell: it defines VERSION, which would clobber labber's
    local id codename like ubuntu_codename
    id=$(. /etc/os-release; echo "${ID:-}")
    codename=$(. /etc/os-release; echo "${VERSION_CODENAME:-}")
    like=$(. /etc/os-release; echo "${ID_LIKE:-}")
    ubuntu_codename=$(. /etc/os-release; echo "${UBUNTU_CODENAME:-}")
    if [[ "$id" != debian && "$id" != ubuntu ]]; then
        if [[ "$like" == *ubuntu* ]]; then id=ubuntu; codename="${ubuntu_codename:-$codename}"
        else id=debian; fi
    fi
    apt_install ca-certificates curl || return 1
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL "https://download.docker.com/linux/$id/gpg" -o /etc/apt/keyrings/docker.asc || return 1
    chmod a+r /etc/apt/keyrings/docker.asc
    cat > /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/$id
Suites: $codename
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
    apt_get update -q || return 1
    apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || return 1
    systemctl enable --now docker
    if [[ "$SETUP_USER" != root ]]; then
        usermod -aG docker "$SETUP_USER"
        SETUP_NOTES+=("log out and back in as $SETUP_USER so the docker group applies")
    fi
    if ! docker info &>/dev/null; then
        if [[ "$SETUP_VIRT" == lxc ]]; then
            warn "Docker isn't running — LXCs need nesting enabled on the Proxmox host"
            SETUP_HOST_CMDS+=("pct set <CTID> --features nesting=1,keyctl=1 && pct reboot <CTID>")
        else
            warn "Docker isn't running — check: systemctl status docker"
        fi
    fi
}

st_dockerlogs_status() {
    if grep -qs '"max-size"' /etc/docker/daemon.json; then echo "done"
    elif ! command -v docker &>/dev/null; then echo "todo: after Docker"
    else echo "todo"; fi
}
st_dockerlogs_run() {
    command -v docker &>/dev/null || { warn "Docker isn't installed — skipped"; return 0; }
    local f=/etc/docker/daemon.json
    mkdir -p /etc/docker
    if [[ -s "$f" ]]; then
        command -v jq &>/dev/null || apt_install jq || return 1
        local driver; driver=$(jq -r '."log-driver" // "json-file"' "$f") || return 1
        if [[ "$driver" != json-file && "$driver" != local ]]; then
            warn "Docker uses the '$driver' log driver — size limits don't apply, skipped"
            return 0
        fi
        cp -p "$f" "$f.labber-bak"
        jq '. + {"log-opts": ((."log-opts" // {}) + {"max-size": "10m", "max-file": "3"})}' "$f.labber-bak" > "$f" \
            || { cp -p "$f.labber-bak" "$f"; return 1; }
    else
        printf '{\n  "log-driver": "json-file",\n  "log-opts": { "max-size": "10m", "max-file": "3" }\n}\n' > "$f"
    fi
    systemctl restart docker
    SETUP_NOTES+=("log rotation applies to newly created containers — existing ones pick it up on 'labber <svc> restart'")
}

st_guestagent_status() { if pkg_installed qemu-guest-agent; then echo "done"; else echo "todo"; fi; }
st_guestagent_run() {
    apt_install qemu-guest-agent || return 1
    systemctl start qemu-guest-agent 2>/dev/null || true
    SETUP_HOST_CMDS+=("qm set <VMID> --agent enabled=1   # then shut the VM down and start it (a reboot isn't enough)")
}

st_labber_status() {
    if [[ -x "$LABBER_BIN" && -d "$LABBER_LIB/files" ]] \
        && grep -qxF "# labber shell function" "$(user_home "$SETUP_USER")/.bashrc" 2>/dev/null
    then echo "done"; else echo "todo"; fi
}
st_labber_run() {
    local tmp dir; tmp=$(mktemp -d /tmp/labber-install-XXXXXX)
    dir=$(labber_download "$tmp") || { rm -rf "$tmp"; warn "download failed: $LABBER_URL"; return 1; }
    labber_place "$dir"; rm -rf "$tmp"
    ok "labber installed to $LABBER_LIB, linked from $LABBER_BIN"
    mkdir -p "$SERVICE_BASE"
    # Docker hosts: check for service updates daily (the health check turns the
    # result into metrics for Grafana)
    if (( SETUP_DOCKER )); then
        cat > /etc/systemd/system/labber-check-updates.service <<EOF
[Unit]
Description=labber: check services for image and config updates
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=$SETUP_USER
ExecStart=$LABBER_BIN check-updates
EOF
        cat > /etc/systemd/system/labber-check-updates.timer <<'EOF'
[Unit]
Description=labber: daily update check
[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true
[Install]
WantedBy=timers.target
EOF
        systemctl daemon-reload
        systemctl enable --now labber-check-updates.timer >/dev/null 2>&1 && ok "daily labber check-updates enabled"
    fi
    if [[ "$SETUP_USER" != root ]]; then
        chown "$SETUP_USER:" "$SERVICE_BASE"
        SUDO_USER="$SETUP_USER" _install_shell_fn
        SUDO_USER="$SETUP_USER" _install_completion_fn
    else
        ( unset SUDO_USER; _install_shell_fn; _install_completion_fn )
    fi
}

st_fzf_status() {
    if [[ -d "$(user_home "$SETUP_USER")/.fzf" ]]; then echo "done"; else echo "todo"; fi
}
st_fzf_run() {
    local tmpdir; tmpdir=$(clone_repo_dir tools/) || return 1
    [[ -f "$tmpdir/tools/fzf.sh" ]] || { rm -rf "$tmpdir"; warn "tools/fzf.sh not in repo"; return 1; }
    # run the repo's tool as the user, so fzf lands in their home
    local script; script=$(mktemp /tmp/labber-fzf-XXXXXX.sh)
    cp "$tmpdir/tools/fzf.sh" "$script"; chmod 755 "$script"; rm -rf "$tmpdir"
    runuser -l "$SETUP_USER" -c "bash $script" < /dev/null
    local rc=$?
    rm -f "$script"
    return $rc
}

# ── locale ──

st_locale_status() {
    local lang; lang=$(grep -s '^LANG=' /etc/default/locale | cut -d= -f2 | tr -d '"')
    if [[ -n "$lang" ]] && locale -a 2>/dev/null | grep -qix "$(locale_norm "$lang")"; then
        echo "done: $lang"
    else
        echo "todo: ${lang:-none set}"
    fi
}
# en_US.UTF-8 → en_US.utf8 (how `locale -a` lists it)
locale_norm() { echo "$1" | sed -E 's/\.UTF-?8$/.utf8/I'; }
st_locale_run() {
    local loc line
    loc=$(ask "locale" "$(state_get locale | grep . || echo en_US.UTF-8)")
    line=$(grep -m1 -E "^${loc//./\\.}[[:space:]]" /usr/share/i18n/SUPPORTED 2>/dev/null || true)
    if [[ -z "$line" ]]; then
        pkg_installed locales || apt_install locales || return 1
        line=$(grep -m1 -E "^${loc//./\\.}[[:space:]]" /usr/share/i18n/SUPPORTED 2>/dev/null || true)
    fi
    [[ -n "$line" ]] || { warn "unknown locale '$loc' (see /usr/share/i18n/SUPPORTED)"; return 1; }
    pkg_installed locales || apt_install locales || return 1
    # enable it in /etc/locale.gen (uncomment, or add) and generate
    if grep -qE "^#[[:space:]]*${line//./\\.}$" /etc/locale.gen; then
        sed -i -E "s/^#[[:space:]]*(${line//./\\.})$/\1/" /etc/locale.gen
    elif ! grep -qxF "$line" /etc/locale.gen; then
        echo "$line" >> /etc/locale.gen
    fi
    locale-gen > /dev/null || return 1
    # --reset also drops LANGUAGE/LC_* left by the installer (e.g. LANGUAGE=en_GB:en),
    # which would otherwise still decide the language of messages
    update-locale --reset LANG="$loc" || return 1
    state_set locale "$loc"
    ok "locale $loc (applies from the next login)"
}

# ── time sync (VMs; LXCs use the host's clock) ──

st_timesync_status() {
    if [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" == yes ]] \
        || systemctl is-active --quiet chrony 2>/dev/null; then
        echo "done"
    else
        echo "todo"
    fi
}
st_timesync_run() {
    if ! pkg_installed systemd-timesyncd && ! pkg_installed chrony; then
        apt_install systemd-timesyncd || return 1
    fi
    if pkg_installed chrony; then
        systemctl enable --now chrony
    else
        systemctl enable --now systemd-timesyncd
        timedatectl set-ntp true
    fi
    ok "time sync on (it can take a minute to show as synchronised)"
}

# ── swap (VMs; an LXC's swap is set by Proxmox: pct set <ID> --swap 0 saves host SSD writes) ──
# Asks every time it runs (last answer as default): zram-only saves SSD writes entirely.

disk_swaps() { awk 'NR > 1 && $1 !~ /zram/ { print $1 }' /proc/swaps; }

st_swap_status() {
    local z=no d; systemctl is-active --quiet zramswap 2>/dev/null && z=yes
    d=$(disk_swaps | wc -l)
    case "$z/$d" in
        yes/0) echo "done: zram only" ;;
        yes/*) echo "done: zram + disk" ;;
        no/0)  echo "todo: no swap" ;;
        *)     echo "todo: disk swap only" ;;
    esac
}
st_swap_run() {
    echo "  1) zram only — no disk swap, so no swap writes to the SSD"
    echo "  2) zram first, disk swap as overflow"
    echo "  3) disk swap only (no zram)"
    local choice; choice=$(ask "swap" "$(state_get swap | grep -E '^[123]$' || echo 1)")
    [[ "$choice" =~ ^[123]$ ]] || { warn "pick 1, 2 or 3"; return 1; }
    state_set swap "$choice"

    if [[ "$choice" == 1 || "$choice" == 2 ]]; then
        apt_install zram-tools || return 1
        cat > /etc/default/zramswap <<'EOF'
# managed by labber setup
ALGO=zstd
PERCENT=50
PRIORITY=100
EOF
        systemctl enable zramswap >/dev/null 2>&1
        systemctl restart zramswap
    else
        systemctl disable --now zramswap 2>/dev/null || true
    fi

    if [[ "$choice" == 1 ]]; then
        local dev
        while IFS= read -r dev; do swapoff "$dev" && ok "disk swap $dev off"; done < <(disk_swaps)
        # keep it off after reboot: comment out swap lines in fstab (backup kept)
        if grep -qE '^[^#].*[[:space:]]swap[[:space:]]' /etc/fstab; then
            cp -p /etc/fstab /etc/fstab.labber-bak
            sed -i -E 's/^([^#].*[[:space:]]swap[[:space:]].*)$/# disabled by labber setup: \1/' /etc/fstab
        fi
        # the installer points hibernation resume at the swap partition; with it gone,
        # every boot would stall waiting for it
        if grep -qs '^RESUME=' /etc/initramfs-tools/conf.d/resume; then
            sed -i 's/^RESUME=.*/RESUME=none/' /etc/initramfs-tools/conf.d/resume
            update-initramfs -u > /dev/null 2>&1 || warn "update-initramfs failed — check before rebooting"
        fi
        ok "swap: zram only (50% of RAM, compressed) — no swap writes to disk"
    elif [[ "$choice" == 3 ]] && [[ -f /etc/fstab.labber-bak ]] && grep -q '^# disabled by labber setup: ' /etc/fstab; then
        sed -i 's/^# disabled by labber setup: //' /etc/fstab
        swapon -a
        if grep -qs '^RESUME=none' /etc/initramfs-tools/conf.d/resume; then
            info "hibernation resume stays off (RESUME=none) — fine unless you hibernate"
        fi
        ok "swap: disk only"
    else
        ok "swap: $([[ $choice == 2 ]] && echo 'zram first, disk swap as overflow' || echo 'disk only')"
    fi
}

# ── reboot/update health check ──
# A small script, run hourly and after every apt/dpkg run, that works out whether a
# reboot (new kernel) or service restarts (old libraries) are needed and how many
# security updates are pending. It writes Prometheus metrics for Alloy to push, and
# the login message shows anything that needs attention.

LABBER_METRICS_DIR="/var/lib/labber/metrics"
HEALTH_BIN="/usr/local/sbin/labber-health-check"

st_healthcheck_status() {
    if [[ -x "$HEALTH_BIN" ]] && systemctl is-enabled --quiet labber-health-check.timer 2>/dev/null
    then echo "done"; else echo "todo"; fi
}
st_healthcheck_run() {
    # needrestart finds services still running old libraries; list-only, so manual
    # apt runs never stop to ask about restarting things
    apt_install needrestart || return 1
    mkdir -p /etc/needrestart/conf.d
    cat > /etc/needrestart/conf.d/labber.conf <<'EOF'
# managed by labber setup: list only, never prompt
$nrconf{restart} = 'l';
$nrconf{kernelhints} = -1;
EOF
    mkdir -p "$LABBER_METRICS_DIR"; chmod 755 "$LABBER_METRICS_DIR"
    local health; health=$(labber_file health-check.sh SERVICE_BASE="$SERVICE_BASE") || return 1
    printf '%s\n' "$health" > "$HEALTH_BIN"
    chmod 755 "$HEALTH_BIN"
    cat > /etc/systemd/system/labber-health-check.service <<EOF
[Unit]
Description=labber: check for needed reboots and pending security updates
[Service]
Type=oneshot
ExecStart=$HEALTH_BIN
EOF
    cat > /etc/systemd/system/labber-health-check.timer <<'EOF'
[Unit]
Description=labber: hourly reboot/update check
[Timer]
OnBootSec=2min
OnUnitActiveSec=1h
[Install]
WantedBy=timers.target
EOF
    # also right after every package change (manual or automatic updates)
    cat > /etc/apt/apt.conf.d/99labber-health-check <<'EOF'
// managed by labber setup
DPkg::Post-Invoke { "systemctl start --no-block labber-health-check.service >/dev/null 2>&1 || true"; };
EOF
    # login message, only when something needs attention
    install -m 755 "$LABBER_FILES/motd-health.sh" /etc/update-motd.d/95-labber-health || return 1
    systemctl daemon-reload
    systemctl enable --now labber-health-check.timer
    "$HEALTH_BIN"
    ok "health check installed — runs hourly and after every apt run"
}

# ── Grafana Alloy: node metrics → Prometheus, journal → Loki (like the Proxmox hosts) ──

st_alloy_status() {
    if systemctl is-active --quiet alloy 2>/dev/null && grep -qs 'managed by labber setup' /etc/alloy/config.alloy
    then echo "done: $(state_get alloy_prometheus)"; else echo "todo"; fi
}
st_alloy_run() {
    local prom loki
    while true; do
        prom=$(ask "Prometheus URL (e.g. http://<monitoring-host>:9090)" "$(state_get alloy_prometheus)")
        [[ "$prom" =~ ^https?://[^[:space:]]+$ ]] && break
        [[ -z "$prom" ]] && { warn "no Prometheus URL — skipped"; return 0; }
        warn "needs an http:// or https:// URL"
    done
    while true; do
        loki=$(ask "Loki URL" "$(state_get alloy_loki | grep . || echo "${prom%:*}:3100")")
        [[ "$loki" =~ ^https?://[^[:space:]]+$ ]] && break
        warn "needs an http:// or https:// URL"
    done
    prom="${prom%/}"; loki="${loki%/}"

    if ! pkg_installed alloy; then
        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL https://apt.grafana.com/gpg-full.key -o /etc/apt/keyrings/grafana.asc || return 1
        chmod a+r /etc/apt/keyrings/grafana.asc
        echo "deb [signed-by=/etc/apt/keyrings/grafana.asc] https://apt.grafana.com stable main" \
            > /etc/apt/sources.list.d/grafana.list
        apt_get update -q || return 1
        apt_install alloy || return 1
    fi
    usermod -aG adm,systemd-journal alloy
    mkdir -p "$LABBER_METRICS_DIR"; chmod 755 "$LABBER_METRICS_DIR"

    # an LXC's CPU/memory/network/disk I/O mirror the host — Proxmox reports those per
    # container — so only health, failed services, the root filesystem and boot time
    local collectors fs_exclude
    if [[ "$SETUP_VIRT" == lxc ]]; then
        collectors=(stat filesystem systemd textfile)
        fs_exclude='^/.+'                                   # only "/"
    else
        collectors=(cpu loadavg meminfo diskstats filesystem netdev pressure stat time systemd textfile)
        fs_exclude='^/(dev|proc|run|sys|var/lib/docker/.+|var/lib/containers/.+)($|/)'
    fi
    # the file has ["@COLLECTORS@"]: fill in a", "b", "c
    local joined; printf -v joined '%s", "' "${collectors[@]}"; joined="${joined%\", \"}"

    local cfg new_cfg
    cfg=$(labber_file alloy/base.alloy COLLECTORS="$joined" METRICS_DIR="$LABBER_METRICS_DIR" \
        FS_EXCLUDE="$fs_exclude" VIRT="$SETUP_VIRT" PROMETHEUS="$prom" LOKI="$loki") || return 1

    # Docker hosts: per-container metrics (trimmed) and container logs too
    local dropin=/etc/systemd/system/alloy.service.d/labber.conf
    if (( SETUP_DOCKER )) && command -v docker &>/dev/null; then
        cfg+=$'\n\n'"$(labber_file alloy/docker.alloy)" || return 1
        # cAdvisor's Docker support talks to containerd, whose socket only root can
        # open — so on Docker hosts Alloy runs as root (it only listens on localhost)
        mkdir -p "$(dirname "$dropin")"
        printf '# managed by labber setup: container metrics need root (containerd socket)\n[Service]\nUser=root\n' > "$dropin"
    else
        rm -f "$dropin"
    fi
    systemctl daemon-reload

    mkdir -p /etc/alloy
    new_cfg=$(mktemp /etc/alloy/config.alloy.new.XXXXXX)
    printf '%s\n' "$cfg" > "$new_cfg"
    # check the new config before it replaces a working one
    if ! alloy fmt "$new_cfg" >/dev/null 2>&1; then
        warn "generated Alloy config is invalid — kept the current one:"
        alloy fmt "$new_cfg" 2>&1 | head -5 >&2
        rm -f "$new_cfg"
        return 1
    fi
    chmod 644 "$new_cfg"
    mv -f "$new_cfg" /etc/alloy/config.alloy
    systemctl enable alloy
    systemctl restart alloy
    state_set alloy_prometheus "$prom"; state_set alloy_loki "$loki"
    # "active" right after a restart doesn't mean it stays up — wait for /-/ready
    local i
    for i in $(seq 20); do
        if curl -fs localhost:12345/-/ready >/dev/null 2>&1; then
            ok "Alloy pushing metrics to $prom and logs to $loki"
            return 0
        fi
        sleep 1
    done
    warn "Alloy didn't become ready — check: journalctl -u alloy"
    return 1
}

# ── zsh + powerlevel10k (plain zsh + git-cloned plugins, no framework) ──

# the admin user on a VM; root on an LXC (there's no admin user there)
setup_zsh_user() { echo "$SETUP_USER"; }

st_zsh_status() {
    local u h; u=$(setup_zsh_user); h=$(user_home "$u")
    if [[ "$(getent passwd "$u" | cut -d: -f7)" == */zsh ]] && grep -qxs '# labber zsh' "$h/.zshrc"
    then echo "done"; else echo "todo"; fi
}
st_zsh_run() {
    local u h; u=$(setup_zsh_user); h=$(user_home "$u")
    apt_install zsh git || return 1
    # plugins: clone, or update if already there
    local repo dir
    for repo in romkatv/powerlevel10k zsh-users/zsh-autosuggestions zsh-users/zsh-syntax-highlighting; do
        dir="$h/.zsh/${repo#*/}"
        if [[ -d "$dir/.git" ]]; then
            runuser -u "$u" -- git -C "$dir" pull -q --ff-only < /dev/null || warn "couldn't update $repo"
        else
            runuser -u "$u" -- mkdir -p "$h/.zsh"
            runuser -u "$u" -- git clone -q --depth 1 "https://github.com/$repo.git" "$dir" < /dev/null || return 1
        fi
    done
    # your powerlevel10k config from the repo (tools/zsh/p10k.zsh), if there is one;
    # without it, p10k's own wizard runs on first login
    local tmpdir; tmpdir=$(clone_repo_dir tools/) || true
    if [[ -n "$tmpdir" && -f "$tmpdir/tools/zsh/p10k.zsh" ]]; then
        if [[ -f "$h/.p10k.zsh" ]] && ! cmp -s "$tmpdir/tools/zsh/p10k.zsh" "$h/.p10k.zsh"; then
            cp -p "$h/.p10k.zsh" "$h/.p10k.zsh.bak"
        fi
        install -m 644 -o "$u" -g "$(id -gn "$u")" "$tmpdir/tools/zsh/p10k.zsh" "$h/.p10k.zsh"
        ok "powerlevel10k config from the repo"
    else
        info "no tools/zsh/p10k.zsh in the repo — the p10k wizard will run on first login"
    fi
    [[ -n "$tmpdir" ]] && rm -rf "$tmpdir"

    # our block goes at the very top of ~/.zshrc (p10k's instant prompt must be first);
    # labber and fzf add their own blocks further down
    local rc="$h/.zshrc" tmp; tmp=$(mktemp)
    [[ -f "$rc" ]] || install -m 644 -o "$u" -g "$(id -gn "$u")" /dev/null "$rc"
    _strip_rc_block "$rc" "# labber zsh" '^# labber zsh end$'
    {
        cat <<'EOF'
# labber zsh
# p10k instant prompt — keep at the top
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
# history: same options as the Mac's ~/.zshrc
HISTFILE=~/.zsh_history HISTSIZE=10000 SAVEHIST=10000
setopt BANG_HIST EXTENDED_HISTORY INC_APPEND_HISTORY SHARE_HISTORY HIST_EXPIRE_DUPS_FIRST \
  HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS HIST_IGNORE_SPACE HIST_SAVE_NO_DUPS \
  HIST_REDUCE_BLANKS HIST_VERIFY
bindkey -e
autoload -Uz compinit && compinit
source ~/.zsh/powerlevel10k/powerlevel10k.zsh-theme
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
# labber zsh end
EOF
        cat "$rc"
    } > "$tmp"
    cat "$tmp" > "$rc"; rm -f "$tmp"
    chown "$u:" "$rc"
    chsh -s "$(command -v zsh)" "$u" || return 1
    # fzf installed before zsh only set up bash — re-run its installer for zsh key bindings
    if [[ -x "$h/.fzf/install" ]]; then
        runuser -l "$u" -c "$h/.fzf/install --all" < /dev/null >/dev/null || warn "couldn't add fzf to zsh"
    fi
    ok "zsh is $u's login shell (needs a Nerd Font in your terminal for the p10k prompt)"
    # labber's shell function + completion into .zshrc too
    if [[ -x "$LABBER_BIN" ]]; then
        if [[ "$u" == root ]]; then ( unset SUDO_USER; _install_shell_fn; _install_completion_fn ) >/dev/null
        else SUDO_USER="$u" _install_shell_fn >/dev/null; SUDO_USER="$u" _install_completion_fn >/dev/null; fi
    fi
}

st_nfs_status() { if pkg_installed nfs-common; then echo "done"; else echo "todo"; fi; }
st_nfs_run() { apt_install nfs-common; }

st_fail2ban_status() {
    if pkg_installed fail2ban && [[ -f /etc/fail2ban/jail.d/labber-sshd.conf ]]; then echo "done"; else echo "todo"; fi
}
st_fail2ban_run() {
    # newer Debian logs to the journal, not /var/log/auth.log — hence backend = systemd
    apt_install fail2ban python3-systemd || return 1
    cat > /etc/fail2ban/jail.d/labber-sshd.conf <<'EOF'
# managed by labber setup
[sshd]
enabled  = true
backend  = systemd
maxretry = 3
findtime = 600
bantime  = 3600
EOF
    systemctl enable fail2ban
    systemctl restart fail2ban
    # only report success once the server is up with the sshd jail loaded
    local i
    for i in $(seq 15); do
        fail2ban-client status sshd >/dev/null 2>&1 && { ok "fail2ban is protecting SSH"; return 0; }
        sleep 1
    done
    warn "fail2ban didn't come up — check: journalctl -u fail2ban"
    return 1
}

st_network_status() {
    local iface c; iface=$(net_iface); c=$(net_cidr "$iface")
    local choice; choice=$(state_get network)
    if [[ -n "$choice" ]]; then echo "done: $choice"
    elif [[ -z "$iface" ]]; then echo "todo: no network detected"
    elif ip -4 addr show dev "$iface" 2>/dev/null | grep -q dynamic; then echo "todo: DHCP ${c:-}"
    else echo "done: static ${c:-}"; fi
}
st_network_run() {
    local iface cidr gw dns mac
    iface=$(net_iface); cidr=$(net_cidr "$iface"); gw=$(net_gw); dns=$(net_dns)
    mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null || true)
    [[ -n "$iface" && -n "$cidr" ]] || { warn "couldn't detect the network — skipped"; return 0; }

    echo
    echo -e "  current:  ${W}$cidr${N} on $iface   gateway $gw   DNS ${dns:--}   MAC $mac"
    echo "  1) UniFi DHCP reservation — recommended: nothing changes here, all IPs stay in UniFi"
    if [[ "$SETUP_VIRT" == lxc ]]; then
        echo "  2) static IP set by Proxmox (Proxmox owns an LXC's network config)"
    else
        echo "  2) static IP on this machine (rolls back unless you confirm from the new IP)"
    fi
    echo "  3) skip"
    local choice; choice=$(ask "choice" "$(state_get network_choice | grep -E '^[123]$' || echo 1)")
    state_set network_choice "$choice"
    case "$choice" in
        1)
            echo
            info "in UniFi: Client Devices → the device with MAC $mac → Settings → Fixed IP Address"
            info "set the IP you want (currently ${cidr%/*}); it applies at the next DHCP renewal or reboot"
            state_set network "UniFi reservation ($mac)"
            ;;
        2)
            local ip prefix new_gw new_dns
            while true; do
                ip=$(ask "new IP" "${cidr%/*}"); prefix=$(ask "prefix length" "${cidr#*/}")
                new_gw=$(ask "gateway" "$gw"); new_dns=$(ask "DNS servers (space-separated)" "$dns")
                local ok_all=1 d
                valid_ipv4 "$ip" && valid_ipv4 "$new_gw" && [[ "$prefix" =~ ^[0-9]+$ ]] && (( prefix >= 8 && prefix <= 32 )) || ok_all=0
                for d in $new_dns; do valid_ipv4 "$d" || ok_all=0; done
                (( ok_all )) && break
                warn "invalid address — try again"
            done
            if [[ "$SETUP_VIRT" == lxc ]]; then
                # rewrite only ip= and gw= in the existing net0 line, keeping bridge/MAC/firewall/VLAN tag
                SETUP_HOST_CMDS+=("pct set <CTID> --net0 \"\$(pct config <CTID> | sed -n 's/^net0: //p' | sed -E 's/,?gw=[^,]*//; s|ip=[^,]*|ip=$ip/$prefix|'),gw=$new_gw\"")
                [[ -z "$new_dns" || "$new_dns" == "$dns" ]] || SETUP_HOST_CMDS+=("pct set <CTID> --nameserver \"$new_dns\"")
                SETUP_HOST_CMDS+=("pct reboot <CTID>")
                state_set network "static $ip/$prefix (via Proxmox)"
            else
                setup_static_vm "$iface" "$ip" "$prefix" "$new_gw" "$new_dns" || return 1
            fi
            ;;
        *) info "network unchanged" ;;
    esac
}

# write a static config for a VM, apply it in the background (the SSH session will
# drop if the IP changes), and roll back after 2 minutes unless confirmed with
# `labber setup --confirm-ip`. Supports ifupdown (Debian) and netplan (Ubuntu).
setup_static_vm() {
    local iface="$1" ip="$2" prefix="$3" gw="$4" dns="$5"
    local st="$LABBER_STATE_DIR" bak="$LABBER_STATE_DIR/ip-backup"
    mkdir -p "$bak"; rm -f "$bak"/* "$st/ip-confirmed" "$st/ip-result"
    local apply="" restore=""

    if command -v netplan &>/dev/null && compgen -G "/etc/netplan/*.yaml" >/dev/null; then
        local np="/etc/netplan/90-labber-$iface.yaml" ns=""
        [[ -n "$dns" ]] && ns="      nameservers: { addresses: [$(echo "$dns" | sed 's/ /, /g')] }"
        cat > "$bak/netplan.new" <<EOF
# managed by labber setup — delete this file and run 'netplan apply' to undo
network:
  version: 2
  ethernets:
    $iface:
      dhcp4: false
      addresses: [$ip/$prefix]
      routes: [{ to: default, via: $gw }]
$ns
EOF
        apply="install -m 600 '$bak/netplan.new' '$np' && netplan apply"
        restore="rm -f '$np' && netplan apply"
    elif command -v ifup &>/dev/null; then
        local f="" c
        for c in /etc/network/interfaces /etc/network/interfaces.d/*; do
            [[ -f "$c" ]] && grep -qE "^[[:space:]]*iface[[:space:]]+$iface[[:space:]]+inet[[:space:]]" "$c" && { f="$c"; break; }
        done
        [[ -n "$f" ]] || { warn "no 'iface $iface inet' entry in /etc/network/interfaces* — use a UniFi reservation instead"; return 1; }
        cp -p "$f" "$bak/interfaces.orig"
        awk -v ifc="$iface" -v addr="$ip/$prefix" -v gw="$gw" '
            $1 == "iface" && $2 == ifc && $3 == "inet" {
                print "iface " ifc " inet static"; print "    address " addr; print "    gateway " gw
                inblk = 1; next
            }
            inblk && /^[[:space:]]/ { if ($1 ~ /^(address|netmask|gateway|broadcast|network)$/) next; print; next }
            { inblk = 0; print }
        ' "$f" > "$bak/interfaces.new"
        apply="cp '$bak/interfaces.new' '$f'"
        restore="cp '$bak/interfaces.orig' '$f'"
        # stop the DHCP client for this interface, then bring it up with the new config
        local cycle="(dhclient -r '$iface' 2>/dev/null; pkill -f 'dhclient.*$iface'; dhcpcd -k '$iface' 2>/dev/null; pkill -f 'dhcpcd.*$iface'; ip -4 addr flush dev '$iface'; ifdown --force '$iface' 2>/dev/null; ifup --force '$iface')"
        apply+=" && $cycle"
        restore+=" && $cycle"
        # resolv.conf: only when it's a plain file (not managed by systemd-resolved), and
        # only AFTER the cycle — releasing a dhcpcd lease rewrites resolv.conf and would
        # wipe the nameservers (found on Debian 13, which uses dhcpcd)
        if [[ -n "$dns" && -f /etc/resolv.conf && ! -L /etc/resolv.conf ]]; then
            cp -p /etc/resolv.conf "$bak/resolv.orig"
            { grep -E '^(search|domain|options)' /etc/resolv.conf || true; for c in $dns; do echo "nameserver $c"; done; } > "$bak/resolv.new"
            apply+=" && cp '$bak/resolv.new' /etc/resolv.conf"
            restore+=" && cp '$bak/resolv.orig' /etc/resolv.conf"
        fi
    else
        warn "unsupported network manager — use a UniFi reservation instead"
        return 1
    fi

    cat > "$st/ip-apply.sh" <<EOF
#!/bin/bash
# written by labber setup: apply a static IP, roll back unless confirmed within 2 minutes
sleep 5
$apply
for i in \$(seq 60); do
    if [[ -f '$st/ip-confirmed' ]]; then echo confirmed > '$st/ip-result'; rm -f '$st/ip-confirmed'; exit 0; fi
    sleep 2
done
$restore
echo "rolled back \$(date)" > '$st/ip-result'
sed -i '/^network_pending=/d' '$st/setup.state'
EOF
    chmod 700 "$st/ip-apply.sh"
    setsid nohup bash "$st/ip-apply.sh" > "$st/ip-apply.log" 2>&1 < /dev/null &
    state_set network_pending "static $ip/$prefix"
    SETUP_NET_PENDING=1
    SETUP_NET_NEW="$ip"
}

# `labber setup --confirm-ip`, run from the new address
setup_confirm_ip() {
    (( EUID == 0 )) || die "run as root: sudo labber setup --confirm-ip"
    local pending; pending=$(state_get network_pending)
    [[ -n "$pending" ]] || die "no IP change is waiting for confirmation"
    touch "$LABBER_STATE_DIR/ip-confirmed"
    local i
    for i in $(seq 10); do
        if grep -qs confirmed "$LABBER_STATE_DIR/ip-result"; then
            state_set network "$pending"; state_set network_pending ""
            ok "IP change confirmed: $pending"
            return
        fi
        sleep 1
    done
    rm -f "$LABBER_STATE_DIR/ip-confirmed"
    warn "too late — the change was already rolled back ($(cat "$LABBER_STATE_DIR/ip-result" 2>/dev/null || echo unknown))"
}

# is this a Docker host? Not every machine is (a web server, say): without Docker
# the Docker steps are left out (nothing is uninstalled). Asked on every run, with
# the last answer shown and used as the default.
setup_ask_docker() {
    local last def=y hint=""
    last=$(state_get docker)
    [[ "$last" == no ]] && def=n
    [[ -n "$last" ]] && hint=" (last answer: $last)"
    if yesno "Will this machine run Docker services?$hint" "$def"; then
        SETUP_DOCKER=1; state_set docker yes
    else
        SETUP_DOCKER=0; state_set docker no
        info "Docker steps left out — answer yes on a later 'labber setup' to add them"
    fi
}

do_setup() {
    if [[ "${1:-}" == --confirm-ip ]]; then setup_confirm_ip; return; fi
    interactive || die "setup is interactive — run it in a terminal"
    if (( EUID != 0 )); then
        # re-run under sudo when labber is a real file (not `bash <(curl …)`)
        if [[ -f "$0" && "$0" != /dev/* && "$0" != /proc/* ]]; then exec sudo bash "$0" setup; fi
        die "setup needs root — run it as root, or: sudo labber setup"
    fi
    [[ -d /etc/pve ]] && die "this is a Proxmox host — setup is for LXCs and VMs"
    command -v apt-get &>/dev/null || die "setup supports Debian/Ubuntu (apt) only"
    labber_need_files

    SETUP_VIRT=$(detect_virt)
    if [[ "$SETUP_VIRT" != lxc && "$SETUP_VIRT" != vm ]]; then
        warn "couldn't tell whether this is an LXC or a VM (detected: $SETUP_VIRT)"
        local last_virt; last_virt=$(state_get virt)
        if yesno "treat it as a VM?${last_virt:+ (last answer: $last_virt)}" "$([[ $last_virt == lxc ]] && echo n || echo y)"; then
            SETUP_VIRT=vm
        else
            SETUP_VIRT=lxc
        fi
        state_set virt "$SETUP_VIRT"
    fi
    SETUP_USER=$(setup_admin_name); [[ -n "$SETUP_USER" ]] || SETUP_USER=root
    setup_ask_docker

    # checklist: pre-select steps that still need doing (optional ones start off)
    local ids=() sel=() stat=() id s
    for id in "${SETUP_STEPS[@]}"; do
        step_applies "$id" || continue
        s=$("st_${id}_status")
        ids+=("$id"); stat+=("$s")
        if [[ "$s" == todo* ]] && ! step_optional "$id"; then sel+=(1); else sel+=(0); fi
    done

    local n i input
    while true; do
        echo -e "\n${W}labber setup${N} — $(hostname), ${SETUP_VIRT^^}, user: $SETUP_USER\n"
        for i in "${!ids[@]}"; do
            local mark="[ ]"; (( sel[i] )) && mark="[${G}x${N}]"
            local sc="$G"; [[ "${stat[$i]}" == todo* ]] && sc="$Y"
            printf "  %2d %b %-50s %b%s%b\n" "$((i+1))" "$mark" "$(step_title "${ids[$i]}")" "$sc" "${stat[$i]}" "$N"
        done
        echo
        read -rp "toggle by number (e.g. 3 5), a = all, n = none, Enter = run, q = quit: " input
        case "$input" in
            "") break ;;
            q|Q) info "nothing changed"; return ;;
            a|A) for i in "${!sel[@]}"; do sel[i]=1; done ;;
            n|N) for i in "${!sel[@]}"; do sel[i]=0; done ;;
            *) for n in $input; do
                   if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#ids[@]} )); then
                       sel[n-1]=$(( 1 - sel[n-1] ))
                   fi
               done ;;
        esac
    done

    local done_steps=() failed=()
    for i in "${!ids[@]}"; do
        (( sel[i] )) || continue
        id="${ids[$i]}"
        echo; info "$(step_title "$id")"
        # `if` keeps one failing step from aborting the whole setup
        if "st_${id}_run"; then done_steps+=("$id"); else failed+=("$id"); warn "$(step_title "$id") failed"; fi
    done

    echo; echo -e "${W}── setup summary ──${N}"
    (( ${#done_steps[@]} == 0 )) || ok "done: ${done_steps[*]}"
    (( ${#failed[@]} == 0 )) || warn "failed: ${failed[*]} — fix and run 'labber setup' again"
    if (( ${#SETUP_HOST_CMDS[@]} )); then
        echo; warn "run on the Proxmox host (replace <CTID>/<VMID> with this guest's ID):"
        printf "    %s\n" "${SETUP_HOST_CMDS[@]}"
    fi
    if (( ${#SETUP_NOTES[@]} )); then
        echo; for n in "${SETUP_NOTES[@]}"; do info "$n"; done
    fi
    if (( SETUP_NET_PENDING )); then
        echo
        warn "the new IP applies in 5 seconds — this session will probably disconnect"
        warn "within 2 minutes, connect to the NEW address and confirm, or it rolls back:"
        echo -e "    ${W}ssh $(setup_login_user)@$SETUP_NET_NEW${N}   then   ${W}sudo labber setup --confirm-ip${N}"
    fi
}

# ── interactive menu ──────────────────────────────────────────────────────────

show_menu() {
    echo -e "\n${W}${B}labber v${VERSION} — homelab service manager${N}\n"
    echo -e "${W}installed services:${N}"
    show_overview
    echo

    local cmds=(  deploy  uninstall  start  stop  restart  rebuild  shell  logs  status  ls  check-updates  go  clean  update  setup )
    local descs=(
        "deploy a service from repo"
        "stop and remove a service"
        "start service containers"
        "stop service containers"
        "recreate service containers"
        "pull/build new images, then recreate containers"
        "enter a running container shell"
        "follow service logs"
        "show container status"
        "list installed services and status"
        "check which services have updates"
        "go to service directory"
        "remove all unused containers, images, volumes"
        "system apt update + upgrade labber"
        "prepare this LXC/VM (users, SSH, Docker, network...)"
    )

    echo -e "${W}commands:${N}"
    for i in "${!cmds[@]}"; do
        printf "  %2d) %-12s %s\n" "$((i+1))" "${cmds[$i]}" "${descs[$i]}"
    done
    echo

    local n
    while true; do
        read -rp "choice [1-${#cmds[@]}] or q to quit: " n
        [[ "$n" == "q" || "$n" == "Q" ]] && exit 0
        [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#cmds[@]} )) && break
        warn "invalid choice"
    done
    local chosen="${cmds[$((n-1))]}"
    [[ "$chosen" == "deploy" ]] && { do_install ""; return; }
    "do_${chosen//-/_}" ""
}

# ── usage ─────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
${W}labber v${VERSION}${N} — homelab service manager

${W}Usage:${N}
  labber [svc] <command>

${W}Commands:${N}
  [svc] install     deploy a service from the repo (also: deploy)
  [svc] uninstall   stop and remove a service
  [svc] start       start containers (docker compose up -d)
  [svc] stop        docker compose stop
  [svc] restart     recreate containers (docker compose up -d --force-recreate)
  [svc] rebuild     pull/build new images, then recreate containers
  [svc] update      pull latest config from repo + rebuild (preserves .env)
  [svc] shell       enter a running container shell
  [svc] logs        follow docker compose logs
  [svc] status      show container status
  [svc] go          cd to service directory
  setup             prepare this fresh LXC/VM (interactive checklist; re-runnable)
  ls                list services: containers up, health, ports, updates
  check-updates     check images and repo config for updates (cron-able)
  clean             remove all unused containers, images, networks, and volumes
  tool <name>       install a tool from the tools/ directory in the repo
  tool ls           list available tools
  update            system apt update + upgrade + labber self-update
  install           install labber (/usr/local/lib/labber, linked from /usr/local/bin) + shell function
  <svc>             show a service's status and commands
  (no args)         interactive menu

${W}.env templates${N} (in .env.example — filled in on install/update/start):
  {{ name }}                        you provide it
  {{ name | default(8000) }}        asked; Enter keeps 8000
  {{ name | generate(hex64) }}      secret; Enter generates it — also base64_32, uuid,
                                    [A-Za-z0-9],16 (16 chars from that set)
  Placeholders can sit inside a value: http://{{ host }}:{{ port | default(80) }}

${W}Before every start${N} labber also checks for port conflicts and creates missing
bind-mount folders owned by PUID/PGID (or UID/GID) from .env, else by you.

${W}Weekly update check${N} (add with: crontab -e):
  0 6 * * 1  /usr/local/bin/labber check-updates >/dev/null 2>&1

${W}Note:${N}
  'labber <svc> go' requires the shell function installed by 'labber install'.
  After install, run: source ~/.bashrc

${W}Fresh LXC/VM${N} (as root — only curl needed):
  apt update && apt install -y curl
  bash <(curl -fsSL https://raw.githubusercontent.com/rahulsrma26/homelab/refs/heads/main/labber/labber) setup

${W}Just install labber:${N}
  bash <(curl -fsSL https://raw.githubusercontent.com/rahulsrma26/homelab/refs/heads/main/labber/labber) install
EOF
}

# ── main ──────────────────────────────────────────────────────────────────────

labber_main() {
    local SVC CMD _tmp
    SVC="${1:-}"; shift 2>/dev/null || true
    CMD="${1:-}"; shift 2>/dev/null || true

    # Global commands have no service prefix — detect when SVC slot holds a global cmd
    _GLOBAL_CMDS="install deploy setup ls check-updates clean update tool help -h --help"
    if [[ " $_GLOBAL_CMDS " =~ " $SVC " ]]; then
        _tmp="$CMD"; CMD="$SVC"; SVC="$_tmp"
    elif [[ -z "$CMD" ]]; then
        # `labber <svc>` alone → that service's status; otherwise treat it as a command
        if [[ -n "$SVC" && -f "$(svc_dir "$SVC")/docker-compose.yml" ]]; then
            CMD="info"
        else
            CMD="$SVC"; SVC=""
        fi
    fi

    case "$CMD" in
        install|deploy)
            # `labber install` installs labber itself; `labber <svc> install` deploys a
            # service; `labber deploy` picks a service to deploy
            if [[ -n "$SVC" || "$CMD" == deploy ]]; then do_install "$SVC"; else do_self_install; fi
            ;;
        info)      do_svc_info  "$SVC" ;;
        uninstall) do_uninstall "$SVC" ;;
        start)     do_start     "$SVC" ;;
        stop)      do_stop      "$SVC" ;;
        restart)   do_restart   "$SVC" ;;
        rebuild)   do_rebuild   "$SVC" ;;
        shell)     do_shell     "$SVC" ;;
        logs)      do_logs      "$SVC" ;;
        status)    do_status    "$SVC" ;;
        ls)        do_ls ;;
        check-updates) do_check_updates ;;
        setup)     do_setup     "$SVC" ;;
        go)        do_go        "$SVC" ;;
        clean)     do_clean ;;
        tool)      do_tool      "$SVC" ;;
        update)
            if [[ -n "$SVC" ]]; then do_svc_upgrade "$SVC"; else do_update; fi
            ;;
        help|-h|--help) usage ;;
        "")        show_menu ;;
        *) die "unknown command '$CMD' — run: labber help" ;;
    esac
}

# run unless sourced (the tests source labber to call its functions). `return` only
# works when sourced, so this covers every way of running it: `labber`, `bash labber`,
# `bash <(curl …)` and `curl … | bash -s …` (where BASH_SOURCE and $0 differ)
if ! (return 0 2>/dev/null); then
    labber_main "$@"
fi
