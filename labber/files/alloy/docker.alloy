// ── Docker containers (Docker hosts only; appended to base.alloy) ──
// Alloy runs as root on Docker hosts: cAdvisor's Docker support needs the containerd socket

prometheus.exporter.cadvisor "docker" {
  docker_host            = "unix:///var/run/docker.sock"
  docker_only            = true
  store_container_labels = false
  storage_duration       = "2m"
  enabled_metrics        = ["cpu", "memory", "network", "oom_event"]
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.docker.targets
  forward_to      = [prometheus.relabel.containers.receiver]
  scrape_interval = "30s"
}

prometheus.relabel "containers" {
  forward_to = [prometheus.remote_write.central.receiver]
  // per container: CPU, memory, network, start time (restarts), last seen (gone), OOM kills
  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|network_(receive|transmit)_bytes_total|start_time_seconds|last_seen|oom_events_total)"
    action        = "keep"
  }
  // the cgroup root isn't a container
  rule {
    source_labels = ["name"]
    regex         = ""
    action        = "drop"
  }
  // a new id on every recreate would make new series each time
  rule {
    regex  = "id"
    action = "labeldrop"
  }
  rule {
    target_label = "job"
    replacement  = "guest-containers"
  }
  rule {
    target_label = "host"
    replacement  = constants.hostname
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.local.targets
  relabel_rules = discovery.relabel.containers.rules
  labels        = { host = constants.hostname, job = "docker" }
  forward_to    = [loki.write.central.receiver]
}
